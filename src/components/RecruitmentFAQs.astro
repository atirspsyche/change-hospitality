---
const faqs = [
  {
    question: 'Do you only recruit chefs and front-of-house staff?',
    answer: 'No. Alongside kitchen and front-of-house teams, we recruit the people who run hospitality businesses behind the scenes: events and sales managers, HR, finance and administration, and senior leadership. That means one agency can cover your Saturday night service and your next head of operations, and both come from consultants who understand how a hospitality business really works.',
  },
  {
    question: 'What kind of businesses do you work with?',
    answer: 'Everyone from neighbourhood restaurants to some of the biggest names in hospitality. Our clients include five-star hotels like Four Seasons, contract caterers like BaxterStorey, cultural venues like Tate, event spaces like Tobacco Dock, and corporate dining at companies like Royal Bank of Canada. We also staff stadiums, theatres, festivals and street food events. Whatever the size of your business, you get the same consultant-led service.',
  },
  {
    question: 'Do you supply hospitality staff outside London?',
    answer: 'Yes. As well as our London head office, we have local teams in Greater Manchester, Hampshire and Isle of Wight, covering towns including Southampton, Portsmouth and Winchester. Because our consultants live and work in those areas, they know the local venues, the local talent and what pay rates it takes to hire there.',
  },
  {
    question: 'How do you make sure staff are the right fit for my venue?',
    answer: 'We match people to your venue, not just to a job title. Our consultants have worked in hospitality themselves, so they look beyond the CV at things like pace, polish and personality. We follow up after placements to check things are going well. Additionally, all Change Temporary Team members have Level 2 Food Safety, Health and Safety, Alcohol Licensing and Food Allergens training depending on their role.',
  },
  {
    question: 'Should I use temporary staff or make a permanent hire?',
    answer: 'It depends on what you need. Temporary staff are best for covering busy periods, events, sickness or staff shortages, often at short notice. Permanent recruitment suits roles where you need someone to grow with your team long term. For senior and leadership roles, we run a more targeted search. If you\u2019re not sure which is right, tell us what\u2019s happening in your business and we\u2019ll recommend the best option.',
  },
];
---

<section id="recruitment-faqs" class="recruit-faqs" aria-labelledby="recruitment-faqs-title">
  <div class="recruit-faqs-inner">
    <header class="recruit-faqs-intro">
      <p class="recruit-faqs-eyebrow">Recruitment FAQs</p>
      <h2 id="recruitment-faqs-title">
        Good questions.<br />
        <span class="recruit-faqs-title-finish">
          Straight answers.
          <svg viewBox="0 0 400 22" fill="none" aria-hidden="true" focusable="false">
            <path d="M5 12C86 0 270 0 394 10M54 20C159 11 276 11 352 17" />
          </svg>
        </span>
      </h2>
      <p class="recruit-faqs-copy">
        A few things worth knowing before we find your next great hire.
      </p>
      <svg class="recruit-faqs-doodle" viewBox="0 0 280 210" fill="none" aria-hidden="true" focusable="false">
        <path class="recruit-faqs-chat-back" d="M159 28C180 18 226 18 245 30C260 40 259 73 245 82L251 101L228 87C208 93 177 89 161 79C146 69 144 40 159 28Z" />
        <circle cx="185" cy="55" r="3" fill="currentColor" stroke="none" />
        <circle cx="204" cy="55" r="3" fill="currentColor" stroke="none" />
        <circle cx="223" cy="55" r="3" fill="currentColor" stroke="none" />
        <path d="M88 148L80 179L64 182M137 149L146 180L164 179M40 104L24 100L18 87M177 111L193 117L203 109" />
        <path class="recruit-faqs-chat-front" d="M53 51C80 37 135 38 160 52C182 64 186 112 168 132C150 151 97 155 69 144L40 160L46 134C25 118 29 66 53 51Z" />
        <path d="M76 83L86 79M126 78L136 82M91 115C102 127 119 125 129 111" />
        <ellipse cx="87" cy="97" rx="3.5" ry="6" fill="currentColor" stroke="none" />
        <ellipse cx="126" cy="96" rx="3.5" ry="6" fill="currentColor" stroke="none" />
        <path d="M18 45L21 34L25 44L36 47L25 51L22 62L18 51L8 48Z" />
        <path d="M226 145L230 131L235 144L249 148L235 153L231 167L226 154L213 149Z" />
        <path d="M66 20L61 10M84 17L85 6M252 116L263 111M256 130L268 132" />
        <path class="recruit-faqs-ground" d="M49 195C90 189 149 190 180 194M79 202C104 200 130 200 148 202" />
      </svg>
    </header>

    <div class="recruit-faqs-list">
      {faqs.map(({ question, answer }, index) => (
        <details class="recruit-faq">
          <summary class="recruit-faq-question">
            <span class="recruit-faq-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="recruit-faq-question-text">{question}</span>
            <span class="recruit-faq-toggle" aria-hidden="true"></span>
          </summary>
          <div class="recruit-faq-answer">
            <p>{answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .recruit-faqs {
    background: var(--color-cream);
    color: var(--color-cocoa);
    padding: 5rem 1.25rem;
    scroll-margin-top: 2rem;
  }

  .recruit-faqs-inner {
    display: grid;
    width: min(100%, 80rem);
    margin-inline: auto;
    gap: 2.5rem;
    align-items: start;
  }

  .recruit-faqs-eyebrow {
    width: fit-content;
    margin-bottom: 1.5rem;
    border: 1.5px solid currentColor;
    border-radius: 0.8rem 1rem 0.7rem 0.9rem;
    background: var(--color-citron);
    padding: 0.55rem 0.85rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(-3deg);
  }

  .recruit-faqs-intro h2 {
    font-family: var(--font-hero);
    font-size: clamp(2.1rem, 4vw, 3.75rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.055em;
  }

  .recruit-faqs-title-finish {
    position: relative;
    display: inline-block;
  }

  .recruit-faqs-title-finish svg {
    position: absolute;
    bottom: -0.16em;
    left: 0;
    width: 100%;
    height: 0.22em;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .recruit-faqs-copy {
    max-width: 26rem;
    margin-top: 1.75rem;
    font-size: 1.05rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .recruit-faqs-doodle {
    width: 9rem;
    margin-top: 1.25rem;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .recruit-faqs-chat-back {
    fill: var(--color-blush);
  }

  .recruit-faqs-chat-front {
    fill: var(--color-citron);
  }

  .recruit-faqs-ground {
    opacity: 0.5;
  }

  .recruit-faqs-list {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }

  .recruit-faq {
    min-width: 0;
    border: 1.5px solid var(--color-cocoa);
    border-radius: 1rem 1.4rem 1.1rem 1.3rem;
    background: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-cocoa);
    transition: background-color 200ms ease, box-shadow 250ms ease;
  }

  .recruit-faq:nth-child(even) {
    border-radius: 1.4rem 1rem 1.3rem 1.1rem;
  }

  .recruit-faq[open] {
    background: var(--color-blush);
  }

  .recruit-faq-question {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr) 2rem;
    min-height: 6.25rem;
    align-items: center;
    gap: 0.75rem;
    border-radius: inherit;
    padding: 1.1rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .recruit-faq-question::-webkit-details-marker {
    display: none;
  }

  .recruit-faq-question:focus-visible {
    outline: 3px solid var(--color-cocoa);
    outline-offset: 6px;
  }

  .recruit-faq-number {
    display: grid;
    width: 1.9rem;
    height: 2rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 0.55rem 0.7rem 0.5rem 0.65rem;
    background: var(--color-citron);
    font-size: 0.75rem;
    font-weight: 700;
    transform: rotate(-7deg);
  }

  .recruit-faq:nth-child(even) .recruit-faq-number {
    transform: rotate(7deg);
  }

  .recruit-faq-question-text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .recruit-faq-toggle {
    position: relative;
    width: 2rem;
    height: 2rem;
    border: 1.5px solid var(--color-cocoa);
    border-radius: 50%;
    background: var(--color-citron);
    transition: transform 300ms var(--ease-cartoon), background-color 200ms ease;
  }

  .recruit-faq-toggle::before,
  .recruit-faq-toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.8rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
    transition: transform 250ms var(--ease-cartoon);
  }

  .recruit-faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .recruit-faq[open] .recruit-faq-toggle {
    background: var(--color-cocoa);
    color: var(--color-cream);
  }

  .recruit-faq[open] .recruit-faq-toggle::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .recruit-faq-answer {
    padding: 0 1rem 1.5rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) and selector(details::details-content) {
      .recruit-faq {
        interpolate-size: allow-keywords;
      }

      .recruit-faq::details-content {
        block-size: 0;
        overflow: clip;
        opacity: 0;
        transform: translateY(-0.4rem);
        transition:
          block-size 450ms var(--ease-luxury),
          opacity 280ms ease,
          transform 400ms var(--ease-luxury),
          content-visibility 450ms allow-discrete;
      }

      .recruit-faq[open]::details-content {
        block-size: auto;
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (min-width: 640px) {
    .recruit-faqs {
      padding-inline: 2.5rem;
    }

    .recruit-faq-question {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: 1rem;
      padding: 1.4rem;
    }

    .recruit-faq-answer {
      padding: 0 4.4rem 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .recruit-faqs {
      padding-block: 7rem;
    }

    .recruit-faqs-inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.35fr);
      gap: 4rem;
    }

    .recruit-faqs-doodle {
      width: 16rem;
      margin-top: 2rem;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .recruit-faq:hover {
      box-shadow: 4px 5px 0 var(--color-cocoa);
    }

    .recruit-faq-question:hover .recruit-faq-toggle {
      transform: rotate(-10deg) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recruit-faq,
    .recruit-faq-toggle,
    .recruit-faq-toggle::before,
    .recruit-faq-toggle::after {
      transition: none;
    }
  }
</style>
