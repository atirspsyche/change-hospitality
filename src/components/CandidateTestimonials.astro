---
import { Quote } from '@lucide/astro';

const testimonials = [
  "I've genuinely loved my time with the agency and have always appreciated how supportive and well-organised everything has been. I've learned a lot through the shifts and it's been a pleasure working with both the team and the venues.",
  'Change has been excellent in providing me with the exact level of work I require. They have a good spread of clients which means the work assignments can get you into some wonderful places: top London hotels, premiership football clubs, west end theatres, street food pop-ups, festivals, city offices.',
  'I had a great experience with Change Hospitality Agency. The team is professional, supportive, and always responsive to any questions or concerns. They provide excellent opportunities and genuinely care about their staff.',
  "I have been with change for a bit now. A lot of agencies don't look after their chefs. They just send them out to not nice places and make money of our backs and our hard work. BUT NOT change. They check up on us to make sure we are happy, any questions you have for them they reply within minutes.",
  'Everyone in the agency is very kind and helpful. I would highly recommend Change Hospitality because they provide good shifts at good locations. The team is very supportive - they help you with everything, provide shifts regularly, and are always understanding if you face any problems.',
];
---

<section id="candidate-testimonials" class="candidate-stories" aria-labelledby="candidate-stories-title" data-candidate-stories>
  <div class="candidate-stories-inner">
    <header class="candidate-stories-heading">
      <div>
        <p class="candidate-stories-eyebrow">From our candidates</p>
        <h2 id="candidate-stories-title">Good words.<br /><span>New beginnings.</span></h2>
      </div>
      <div class="candidate-stories-aside">
        <span class="candidate-stories-seal" aria-hidden="true"><Quote size={44} stroke-width={1.6} /></span>
        <p>A new role is one thing.<br />Feeling looked after is everything.</p>
      </div>
    </header>

    <div class="candidate-stories-grid">
      {testimonials.map((quote, index) => (
        <figure class="candidate-note" data-candidate-note>
          <div class="candidate-note-top" aria-hidden="true">
            <Quote size={30} stroke-width={1.8} />
            <span>{String(index + 1).padStart(2, '0')} / 05</span>
          </div>
          <blockquote><p>&ldquo;{quote}&rdquo;</p></blockquote>
          <figcaption><span class="candidate-note-dot" aria-hidden="true"></span>A Change candidate<span class="candidate-note-anonymous">Anonymous</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .candidate-stories {
    position: relative;
    background: var(--color-mint);
    color: var(--color-ink);
    padding: 4.5rem 1.25rem 5.5rem;
  }

  .candidate-stories-inner {
    width: min(100%, 80rem);
    margin-inline: auto;
  }

  .candidate-stories-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .candidate-stories-eyebrow {
    margin-bottom: 1.25rem;
    color: var(--color-cocoa);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .candidate-stories-heading h2 {
    font-family: var(--font-hero);
    font-size: 2.25rem;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .candidate-stories-heading h2 span {
    color: var(--color-cocoa);
  }

  .candidate-stories-aside {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .candidate-stories-aside p {
    max-width: 18rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .candidate-stories-seal {
    display: grid;
    flex: none;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border-radius: 43% 57% 51% 49% / 53% 44% 56% 47%;
    background: var(--color-citron);
    color: var(--color-cocoa);
    rotate: -12deg;
  }

  .candidate-stories-grid {
    display: grid;
    gap: 2rem;
  }

  .candidate-note {
    --note-paper: var(--color-paper);
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    border-radius: 1.5rem;
    background: var(--note-paper);
    padding: 1.5rem;
  }

  .candidate-note::after {
    position: absolute;
    bottom: -0.9rem;
    left: 2rem;
    width: 1.75rem;
    height: 1.1rem;
    background: var(--note-paper);
    clip-path: polygon(0 0, 100% 0, 12% 100%);
    content: '';
  }

  .candidate-note:nth-child(2),
  .candidate-note:nth-child(4) {
    --note-paper: var(--color-blush);
  }

  .candidate-note:nth-child(3) {
    --note-paper: var(--color-citron);
  }

  .candidate-note-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    color: var(--color-cocoa);
  }

  .candidate-note-top span {
    font-size: 0.7rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .candidate-note blockquote {
    margin-bottom: 2rem;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  .candidate-note figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    color: var(--color-cocoa);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .candidate-note-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .candidate-note-anonymous {
    margin-left: auto;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .candidate-stories {
      padding: 6rem 2.5rem 7rem;
    }

    .candidate-stories-heading h2 {
      font-size: 3.5rem;
    }

    .candidate-stories-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .candidate-note:last-child {
      grid-column: 1 / -1;
    }

    .candidate-note {
      padding: 2rem;
    }
  }

  @media (min-width: 1200px) {
    .candidate-stories-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }

    .candidate-note {
      grid-column: span 2;
    }

    .candidate-note:nth-child(n + 4) {
      grid-column: span 3;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .candidate-note:nth-child(odd) {
      rotate: -1deg;
    }

    .candidate-note:nth-child(even) {
      rotate: 1deg;
    }
  }

  @media print {
    .candidate-note {
      break-inside: avoid;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let disposeCandidateStories: (() => void) | undefined;

  function initCandidateStories() {
    disposeCandidateStories?.();
    disposeCandidateStories = undefined;
    const section = document.querySelector<HTMLElement>('[data-candidate-stories]');
    if (!section) return;

    const media = gsap.matchMedia();
    media.add({
      motion: '(prefers-reduced-motion: no-preference)',
      desktop: '(min-width: 1024px)',
      print: 'print',
    }, (context) => {
      if (!context.conditions?.motion || context.conditions.print) return;

      section.querySelectorAll<HTMLElement>('[data-candidate-note]').forEach((card, index) => {
        ScrollTrigger.create({
          trigger: card,
          start: 'top 96%',
          once: true,
          onEnter: () => context.add(() => {
            gsap.fromTo(card, { y: 28, opacity: 0.65 }, {
              y: 0,
              opacity: 1,
              duration: 0.85,
              delay: context.conditions?.desktop ? (index % 3) * 0.08 : 0,
              ease: 'power3.out',
              clearProps: 'transform,opacity',
            });
          }),
        });
      });

      if (context.conditions.desktop) {
        ScrollTrigger.create({
          trigger: section,
          start: 'top bottom',
          once: true,
          onEnter: () => context.add(() => {
            gsap.fromTo(section.querySelector('.candidate-stories-seal'), { y: 18, rotation: -8 }, {
              y: -22,
              rotation: 12,
              ease: 'none',
              scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1 },
            });
          }),
        });
      }
    }, section);

    disposeCandidateStories = () => media.revert();
  }

  initCandidateStories();
  document.addEventListener('astro:page-load', initCandidateStories);
  document.addEventListener('astro:before-swap', () => {
    disposeCandidateStories?.();
    disposeCandidateStories = undefined;
  });
</script>