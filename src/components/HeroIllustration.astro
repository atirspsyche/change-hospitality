---
interface Props {
  kind: 'chef' | 'bart' | 'plant' | 'salt';
  loading?: 'eager' | 'lazy';
}

const { kind, loading = 'eager' } = Astro.props;

// Frame the drawings, not their transparent 1920 x 1080 canvases.
const frames = {
  chef: { left: 495, top: 13, width: 942, height: 969 },
  bart: { left: 552, top: 76, width: 864, height: 928 },
  plant: { left: 763, top: 304, width: 421, height: 692 },
  salt: { left: 620, top: 87, width: 804, height: 768 },
};
const frame = frames[kind];
---

<div class:list={['hero-illustration', `hero-illustration-${kind}`]} data-hero-illustration={kind} aria-hidden="true">
  <div class="illustration-scene">
    {kind !== 'salt' && <div class="illustration-backdrop"></div>}
    <div class="illustration-artwork">
      <div class="illustration-crop" style={`aspect-ratio: ${frame.width} / ${frame.height}`}>
        <img
          src={`/illustrations/${kind}.webp`}
          alt=""
          width="1920"
          height="1080"
          loading={loading}
          decoding="async"
          style={`width: ${1920 / frame.width * 100}%; left: ${-frame.left / frame.width * 100}%; top: ${-frame.top / frame.height * 100}%`}
        />
      </div>
    </div>
    {kind !== 'salt' && <svg class="illustration-marks" viewBox="0 0 500 500" fill="none" focusable="false">
      <g class="illustration-spark illustration-spark-one">
        <path d="m65 105 4 18 18 4-18 4-4 18-4-18-18-4 18-4Z" />
      </g>
      <g class="illustration-spark illustration-spark-two">
        <path d="m437 319 3 13 13 3-13 3-3 13-3-13-13-3 13-3Z" />
      </g>
      <g class="illustration-rays">
        <path d="m402 78 8-15m8 26 15-7M54 359l-13 5m21 10-6 12" />
        <circle cx="112" cy="412" r="3" />
        <circle cx="453" cy="217" r="3" />
      </g>
    </svg>}
  </div>
</div>

<style>
  .hero-illustration {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
    --illustration-paper: var(--color-cream);
    --illustration-ink: var(--color-cocoa);
  }

  .illustration-scene { position: absolute; inset: 0; }
  .illustration-backdrop {
    position: absolute;
    inset: 12% 4% 7%;
    border-radius: 43% 57% 62% 38% / 52% 40% 60% 48%;
    background: var(--illustration-paper);
    transform: rotate(-9deg);
  }
  .illustration-backdrop::after {
    position: absolute;
    inset: 0.7rem;
    border: 1px dashed color-mix(in srgb, var(--illustration-ink) 32%, transparent);
    border-radius: inherit;
    content: "";
  }
  .illustration-artwork {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 8%;
    width: 84%;
    transform: translateY(-50%);
  }
  .illustration-crop { position: relative; width: 100%; overflow: hidden; }
  .illustration-crop img { position: absolute; max-width: none; height: auto; }
  .illustration-marks {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    stroke: var(--illustration-ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .illustration-spark { transform-box: fill-box; transform-origin: center; }
  .hero-illustration-chef { --illustration-paper: var(--color-citron); }
  .hero-illustration-chef .illustration-backdrop {
    inset: 18% 4% 12%;
    border-radius: 50%;
    transform: rotate(16deg);
  }
  .hero-illustration-chef .illustration-artwork { left: 6%; width: 88%; }
  .hero-illustration-bart { --illustration-paper: var(--color-blush); }
  .hero-illustration-salt .illustration-artwork { left: 5%; width: 90%; }
  .hero-illustration-plant {
    --illustration-paper: var(--color-bcorp-green);
    --illustration-ink: var(--color-bcorp-green);
  }
  .hero-illustration-plant .illustration-artwork { left: 24%; width: 52%; }
  .hero-illustration-plant .illustration-backdrop {
    inset: 10% 18% 5% 15%;
    border-radius: 48% 48% 12% 12% / 34% 34% 8% 8%;
    transform: rotate(-8deg);
  }
  .hero-illustration-plant .illustration-backdrop::after {
    border-color: color-mix(in srgb, var(--color-cream) 55%, transparent);
  }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .illustration-scene {
      transform: translate3d(var(--illustration-x, 0px), var(--illustration-y, 0px), 0) rotate(var(--illustration-rotation, 0deg));
      transition: transform 650ms var(--ease-luxury);
    }
    .illustration-spark,
    .illustration-rays { transition: transform 800ms var(--ease-cartoon); }
    .hero-illustration:hover .illustration-spark-one { transform: rotate(-10deg) scale(1.06); }
    .hero-illustration:hover .illustration-spark-two { transform: rotate(12deg) scale(1.08); }
    .hero-illustration:hover .illustration-rays { transform: translate(1px, -2px); }
  }
</style>

<script>
  let disposeIllustrations: (() => void) | undefined;

  function initIllustrations() {
    disposeIllustrations?.();
    const media = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    let cleanups: Array<() => void> = [];

    const update = () => {
      cleanups.forEach((cleanup) => cleanup());
      cleanups = [];
      if (!media.matches) return;

      document.querySelectorAll<HTMLElement>('[data-hero-illustration]').forEach((illustration) => {
        const listeners = new AbortController();
        let frame = 0;
        const reset = () => {
          cancelAnimationFrame(frame);
          frame = 0;
          illustration.style.removeProperty('--illustration-x');
          illustration.style.removeProperty('--illustration-y');
          illustration.style.removeProperty('--illustration-rotation');
        };

        illustration.addEventListener('pointermove', (event) => {
          if (event.pointerType !== 'mouse') return;
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            frame = 0;
            const bounds = illustration.getBoundingClientRect();
            const x = Math.max(-1, Math.min(1, (event.clientX - bounds.left) / bounds.width * 2 - 1));
            const y = Math.max(-1, Math.min(1, (event.clientY - bounds.top) / bounds.height * 2 - 1));
            illustration.style.setProperty('--illustration-x', `${x * 4}px`);
            illustration.style.setProperty('--illustration-y', `${y * 3}px`);
            illustration.style.setProperty('--illustration-rotation', `${x}deg`);
          });
        }, { passive: true, signal: listeners.signal });
        illustration.addEventListener('pointerleave', reset, { signal: listeners.signal });
        illustration.addEventListener('pointercancel', reset, { signal: listeners.signal });
        cleanups.push(() => { listeners.abort(); reset(); });
      });
    };

    media.addEventListener('change', update);
    update();
    disposeIllustrations = () => {
      media.removeEventListener('change', update);
      cleanups.forEach((cleanup) => cleanup());
    };
  }

  initIllustrations();
  document.addEventListener('astro:page-load', initIllustrations);
  document.addEventListener('astro:before-swap', () => {
    disposeIllustrations?.();
    disposeIllustrations = undefined;
  });
</script>
