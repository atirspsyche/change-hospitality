---
const benefits = [
  [
    "Be in charge of your work",
    "Casual work with us gives you full autonomy over your hours and where you work. Take the shifts that suit you, in the places you want to be.",
  ],
  [
    "Shifts turn into careers",
    "Casual work can be a foot in the door. Plenty of our candidates are taken on permanently by venues that loved having them, and if that's where you want to go, we'll help you get there.",
  ],
  [
    "A mix of venues",
    "Events, restaurants, luxury venues, stadiums and more. There's genuine variety here, so no two weeks have to look the same.",
  ],
  [
    "Work across the region",
    "Our offices are spread across London, Manchester and Hampshire, so there's work for wherever you are.",
  ],
  [
    "Easy to book, paid on time",
    "Book your shifts through our app, and get paid every Friday.",
  ],
  [
    "Extra support when you need it",
    "For our front-of-house team, we run training days in our office to build skills and confidence. Whether you're just starting out or levelling up, you won't be left to figure it out alone.",
  ],
];

const roles = ["Back of house", "Front of house", "Sales", "Events", "Admin"];

const faqs: Array<{ question: string; paragraphs: string[] }> = [
  {
    question: "How do I join your temp team?",
    paragraphs: [
      "Once you apply, our recruitment team will get in touch with you. You'll be invited to meet us in our office or join a quick video call for an assessment. Once you pass, you're part of the team.",
    ],
  },
  {
    question: "How soon after applying can I start working?",
    paragraphs: [
      "Once you complete the registration process, you can start working straight away.",
    ],
  },
  {
    question:
      "I don't live in the UK. Can I still apply for one of your positions?",
    paragraphs: [
      "If you are applying for one of our UK roles, you will need to have a UK address. We will also need to see your Right to Work in the UK before you can join us.",
    ],
  },
  {
    question: "Do I need hospitality experience?",
    paragraphs: [
      "It depends on the role. For front-of-house work, the right attitude matters most, and we can help with the rest. Back-of-house and kitchen roles usually call for more hands-on experience.",
      "Some roles also require specific certifications, such as food hygiene or health-and-safety qualifications, depending on where and what you'll be working. Whatever the role needs, your consultant will talk you through it and point you in the right direction.",
    ],
  },
  {
    question: "What kind of roles and venues can I work in?",
    paragraphs: [
      "On the front-of-house side, our roles include waiting staff, bar staff, baristas, hosts, event staff and supervisors. Behind the scenes, we cover kitchen roles from kitchen porters to chefs of every level.",
      "Our shifts span events, contract catering, pubs, restaurants, hotels, private venues, schools, hospitals and stadiums. Depending on what you like, there's work here to suit you.",
    ],
  },
];
---

<section
  id="temporary-work"
  class="temp-experience"
  aria-labelledby="temporary-work-title"
  data-jobs-mode-panel="temporary"
  data-temp-experience
  hidden
>
  <div class="temp-benefits">
    <div class="temp-inner">
      <header class="temp-section-header">
        <p>Temporary work, your way</p>
        <h2 id="temporary-work-title" tabindex="-1">Why work with us</h2>
        <span>Good shifts. Good people. More control.</span>
      </header>
      <div class="temp-benefit-grid">
        {
          benefits.map(([title, copy], index) => (
            <article class="temp-benefit">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="temp-application" id="temporary-application">
    <div class="temp-inner temp-application-layout">
      <header class="temp-form-intro">
        <p>Join the team</p>
        <h2>Tell us what works for you.</h2>
        <p>
          Share your details and the roles you want. Our temporary recruitment
          team will be in touch when the right shifts come up.
        </p>
      </header>

      <form
        action="/api/temporary-application"
        method="post"
        class="temp-form"
        data-temp-application-form
      >
        <div class="temp-form-heading">
          <div>
            <p>Temporary application</p><h3>Start with the essentials.</h3>
          </div>
        </div>

        <div class="temp-form-grid">
          <label class="temp-field temp-field-wide">
            <span>First and last name, according to your passport</span>
            <input name="name" autocomplete="name" required maxlength="160" />
          </label>
          <label class="temp-field">
            <span>Country</span>
            <input
              name="country"
              autocomplete="country-name"
              required
              maxlength="100"
            />
          </label>
          <label class="temp-field">
            <span>City</span>
            <input
              name="city"
              autocomplete="address-level2"
              required
              maxlength="100"
            />
          </label>
          <label class="temp-field">
            <span>Email</span>
            <input
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            />
          </label>
          <label class="temp-field">
            <span>Phone number</span>
            <input
              name="phone"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              required
              maxlength="40"
            />
          </label>
        </div>

        <fieldset class="temp-role-group" data-temp-role-group>
          <legend>What role are you looking for?</legend>
          <p id="temp-role-help">Choose at least one.</p>
          <div class="temp-role-options" aria-describedby="temp-role-help">
            {
              roles.map((role) => (
                <label class="temp-role-option">
                  <input name="roles" type="checkbox" value={role} />
                  <>
                    <span aria-hidden="true" />
                    <strong>{role}</strong>
                  </>
                </label>
              ))
            }
          </div>
          <p class="temp-role-error" data-temp-role-error aria-live="polite">
          </p>
        </fieldset>

        <div class="temp-honeypot" aria-hidden="true">
          <label
            >Website<input
              name="website"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </div>
        <label class="temp-consent">
          <input name="consent" type="checkbox" required />
          <span
            >I agree that Change Hospitality may contact me about temporary work
            opportunities.</span
          >
        </label>
        <div class="temp-form-actions">
          <button
            type="submit"
            data-temp-submit
            data-default-label="Send my details"
            ><span>Send my details</span><span aria-hidden="true">&#8599;</span
            ></button
          >
          <p role="status" aria-live="polite" data-temp-form-status></p>
        </div>
      </form>

      <div
        class="temp-form-success"
        data-temp-form-success
        hidden
        tabindex="-1"
      >
        <span aria-hidden="true">&#10003;</span><p>Details received</p><h3>
          You're on our list.
        </h3><p data-temp-success-message></p>
      </div>
    </div>
  </div>

  <div class="temp-faqs">
    <div class="temp-inner temp-faq-layout">
      <header class="temp-faq-header"><p>Good to know</p><h2>FAQs</h2></header>
      <div class="temp-faq-list">
        {
          faqs.map(({ question, paragraphs }, index) => (
            <details class="temp-faq">
              <summary>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{question}</strong>
                  <i aria-hidden="true" />
                </>
              </summary>
              <div>
                {paragraphs.map((paragraph: string) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </details>
          ))
        }
        <details class="temp-faq">
          <summary
            ><span>06</span><strong
              >If there is an issue with my app, what do I do?</strong
            ><i aria-hidden="true"></i></summary
          >
          <div>
            <p>
              <a href="/team/">Contact a consultant</a> and our team will help.
            </p>
          </div>
        </details>
        <details class="temp-faq">
          <summary
            ><span>07</span><strong
              >If I can't submit my hours on the app, what do I do?</strong
            ><i aria-hidden="true"></i></summary
          >
          <div>
            <p>
              Email <a href="mailto:timesheets@changehospitality.co.uk"
                >timesheets@changehospitality.co.uk</a
              >.
            </p>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .temp-experience {
    color: var(--color-ink);
  }
  .temp-inner {
    width: min(100%, 80rem);
    margin: 0 auto;
  }
  .temp-benefits,
  .temp-application,
  .temp-faqs {
    padding: 5.5rem 1.25rem 6.5rem;
  }
  .temp-benefits {
    background: var(--color-mint);
  }
  .temp-application {
    background: var(--color-cocoa);
  }
  .temp-faqs {
    background: var(--color-blush);
  }

  .temp-section-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.75rem 2rem;
    margin-bottom: 3rem;
  }
  .temp-section-header > p,
  .temp-form-intro > p:first-child,
  .temp-faq-header > p,
