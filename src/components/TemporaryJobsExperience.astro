    .temp-form-intro,
    .temp-faq-header {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
    .temp-form-success {
      grid-column: 2;
    }
    .temp-faq-layout {
      grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
      gap: 5rem;
    }
  }
  @media (max-width: 639px) {
    .temp-section-header {
      grid-template-columns: 1fr;
    }
    .temp-section-header > span {
      width: fit-content;
    }
    .temp-form-heading {
      align-items: flex-start;
      flex-direction: column;
    }
    .temp-form-actions button {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .temp-benefit,
    .temp-field,
    .temp-role-option,
    .temp-form-actions button {
      transition: none;
    }
  }
</style>

<script>
  function initTemporaryApplication() {
    document
      .querySelectorAll<HTMLElement>("[data-temp-experience]")
      .forEach((root) => {
        if (root.dataset.tempReady === "true") return;
        root.dataset.tempReady = "true";
        const form = root.querySelector<HTMLFormElement>(
          "[data-temp-application-form]",
        );
        const roleGroup = root.querySelector<HTMLElement>(
          "[data-temp-role-group]",
        );
        const roleError = root.querySelector<HTMLElement>(
          "[data-temp-role-error]",
        );
        const roleInputs = Array.from(
          root.querySelectorAll<HTMLInputElement>('input[name="roles"]'),
        );
        const submit =
          root.querySelector<HTMLButtonElement>("[data-temp-submit]");
        const submitLabel = submit?.querySelector<HTMLElement>("span");
        const status = root.querySelector<HTMLElement>(
          "[data-temp-form-status]",
        );
        const success = root.querySelector<HTMLElement>(
          "[data-temp-form-success]",
        );
        const successMessage = root.querySelector<HTMLElement>(
          "[data-temp-success-message]",
        );
        if (
          !form ||
          !roleGroup ||
          !roleError ||
          !submit ||
          !submitLabel ||
          !status ||
          !success
        )
          return;

        const validateRoles = () => {
          const valid = roleInputs.some((input) => input.checked);
          roleGroup.setAttribute("aria-invalid", String(!valid));
          roleError.textContent = valid ? "" : "Choose at least one role.";
          return valid;
        };
        const setStatus = (
          message: string,
          state: "idle" | "error" = "idle",
        ) => {
          status.textContent = message;
          status.dataset.state = state;
        };
        roleInputs.forEach((input) =>
          input.addEventListener("change", validateRoles),
        );

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          setStatus("");
          const rolesAreValid = validateRoles();
          if (!form.checkValidity() || !rolesAreValid) {
            form.reportValidity();
            if (!rolesAreValid) roleInputs[0]?.focus();
            return;
          }

          const formData = new FormData(form);
          const payload = {
            name: formData.get("name"),
            country: formData.get("country"),
            city: formData.get("city"),
            email: formData.get("email"),
            phone: formData.get("phone"),
            roles: formData.getAll("roles"),
            consent: formData.has("consent"),
            website: formData.get("website"),
          };
          submit.disabled = true;
          submitLabel.textContent = "Sending...";
          setStatus("Passing your details to our temporary recruitment team.");

          try {
            const response = await fetch(form.action, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const result: {
              ok?: boolean;
              message?: string;
              reference?: string;
            } = await response.json().catch(() => ({}));
            if (!response.ok || !result.ok)
              throw new Error(
                result.message ||
                  "We could not send your details. Please try again.",
              );
            form.hidden = true;
            success.hidden = false;
            if (successMessage)
              successMessage.textContent = `${result.message || "Application received."} Reference ${result.reference}.`;
            success.focus();
            form.reset();
          } catch (error) {
            setStatus(
              error instanceof Error
                ? error.message
                : "We could not send your details. Please try again.",
              "error",
            );
          } finally {
            submit.disabled = false;
            submitLabel.textContent =
              submit.dataset.defaultLabel || "Send my details";
          }
        });
      });
  }

  function initTemporaryFaqs() {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    document.querySelectorAll<HTMLDetailsElement>(".temp-faq").forEach((faq) => {
      if (faq.dataset.faqReady === "true") return;
      faq.dataset.faqReady = "true";

      const summary = faq.querySelector<HTMLElement>("summary");
      const content = faq.querySelector<HTMLElement>(":scope > div");
      if (!summary || !content || reducedMotion) return;

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        if (faq.dataset.animating === "true") return;

        const isClosing = faq.open;
        const startHeight = faq.offsetHeight;
        if (!isClosing) faq.open = true;
        const endHeight = isClosing ? summary.offsetHeight : faq.offsetHeight;

        faq.dataset.animating = "true";
        const heightAnimation = faq.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 360, easing: "cubic-bezier(0.25, 1, 0.5, 1)" },
        );
        content.animate(
          isClosing
            ? { opacity: [1, 0], transform: ["translateY(0)", "translateY(-0.4rem)"] }
            : { opacity: [0, 1], transform: ["translateY(-0.4rem)", "translateY(0)"] },
          { duration: 260, easing: "ease-out", fill: "both" },
        );

        heightAnimation.addEventListener("finish", () => {
          if (isClosing) faq.open = false;
          delete faq.dataset.animating;
        }, { once: true });
      });
    });
  }

  initTemporaryApplication();
  initTemporaryFaqs();
  document.addEventListener("astro:page-load", initTemporaryApplication);
  document.addEventListener("astro:page-load", initTemporaryFaqs);
</script>
