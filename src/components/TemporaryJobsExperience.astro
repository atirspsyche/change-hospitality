    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.92;
    text-wrap: balance;
  }
  .temp-section-header > span {
    border-radius: 999px;
    background: var(--color-citron);
    padding: 0.8rem 1rem;
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
