---
interface Props {
  page: 'home' | 'jobs' | 'story' | 'recruit' | 'impact' | 'team' | 'franchising';
}

const { page } = Astro.props;
---

<span data-page-motion={page} hidden></span>

<style is:global>
  [data-page-motion-layer],
  [data-pointer-motion-layer] {
    translate: var(--pointer-motion-x, 0px) calc(var(--page-motion-y, 0px) + var(--pointer-motion-y, 0px));
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const settings = {
    home: {
      layers: '.franchise-map__halo',
      reveals: '[data-map-copy], .home-story-link > *, .home-policy-link > *, #site-footer-title',
    },
    jobs: {
      layers: '.jobs-hero-art',
      reveals: '#jobs h2',
    },
    story: {
      layers: '.story-doodle',
      reveals: '.story-next h2, .story-next p',
    },
    recruit: {
      layers: '.recruit-hero-art, .recruit-footer-egg',
      reveals: '.division-flow-heading, .recruit-footer-inner > h2, .recruit-footer-actions',
    },
    impact: {
      layers: '.hero-sprout, .bcorp-badge, .intro-flower, .certification-photo, .environment-sprout, .social-illustration',
      reveals: '.intro-heading, .intro-copy, .partner-garden > div, .certification-copy, .environment-header > div:first-child, .environment-copy, .impact-number, .office-note, .social-header, .social-card',
    },
    team: {
      layers: '.team-hero-composition, .team-hero-oval, .team-hero-confetti span, .team-section-oval',
      reveals: '.team-profiles-section h2',
    },
    franchising: {
      layers: '.franchise-hero-orbit, .franchise-hero-card, .franchise-hero-note, .franchise-film-art',
      reveals: '[data-franchise-reveal]',
    },
  };

  let disposePageMotion: (() => void) | undefined;

  function initPageMotion() {
    disposePageMotion?.();
    disposePageMotion = undefined;
    const marker = document.querySelector<HTMLElement>('[data-page-motion]');
    const page = marker?.dataset.pageMotion as keyof typeof settings | undefined;
    const root = document.querySelector('main');
    if (!page || !settings[page] || !root) return;

    const media = gsap.matchMedia();
    media.add({
      motion: '(prefers-reduced-motion: no-preference)',
      desktop: '(min-width: 1024px)',
      finePointer: '(hover: hover) and (pointer: fine)',
      print: 'print',
    }, (context) => {
      if (!context.conditions?.motion || context.conditions.print) return;

      const listeners = new AbortController();
      const pointerLayers = new Set<HTMLElement>();
      const pointerCleanups: Array<() => void> = [];
      if (context.conditions.desktop && context.conditions.finePointer) {
        const sections = new Map<HTMLElement, HTMLElement[]>();
        root.querySelectorAll<HTMLElement>('[data-hero-shape], [data-parallax]').forEach((element) => {
          const section = element.closest('section');
          if (!section) return;
          const layers = sections.get(section) || [];
          layers.push(element);
          sections.set(section, layers);
        });

        sections.forEach((elements, section) => {
          const layers = elements.map((element) => {
            pointerLayers.add(element);
            element.setAttribute('data-pointer-motion-layer', '');
            gsap.set(element, { '--pointer-motion-x': '0px', '--pointer-motion-y': '0px' });
            const strength = Math.max(-1, Math.min(1,
              element.dataset.heroShape ? Number(element.dataset.heroShape) : Number(element.dataset.parallax) / 56,
            ));
            return {
              strength,
              x: gsap.quickTo(element, '--pointer-motion-x', { duration: 0.8, ease: 'power2.out' }),
              y: gsap.quickTo(element, '--pointer-motion-y', { duration: 0.8, ease: 'power2.out' }),
            };
          });
          let frame = 0;
          let clientX = 0;
          let clientY = 0;
          const render = () => {
            frame = 0;
            const bounds = section.getBoundingClientRect();
            const x = Math.max(-1, Math.min(1, (clientX - bounds.left) / bounds.width * 2 - 1));
            const y = Math.max(-1, Math.min(1, (clientY - bounds.top) / bounds.height * 2 - 1));
            layers.forEach((layer) => {
              layer.x(x * 6 * layer.strength);
              layer.y(y * 4 * layer.strength);
            });
          };
          const reset = () => {
            cancelAnimationFrame(frame);
            frame = 0;
            layers.forEach((layer) => { layer.x(0); layer.y(0); });
          };
          section.addEventListener('pointermove', (event) => {
            if (event.pointerType !== 'mouse') return;
            clientX = event.clientX;
            clientY = event.clientY;
            if (!frame) frame = requestAnimationFrame(render);
          }, { passive: true, signal: listeners.signal });
          section.addEventListener('pointerleave', reset, { signal: listeners.signal });
          section.addEventListener('pointercancel', reset, { signal: listeners.signal });
          window.addEventListener('blur', reset, { signal: listeners.signal });
          pointerCleanups.push(() => cancelAnimationFrame(frame));
        });
      }

      const lenis = new Lenis({
        duration: 1.2,
        smoothWheel: true,
        prevent: (node) => document.documentElement.hasAttribute('data-story-loading')
          || Boolean(node.closest('[data-funmenu-overlay], [data-lenis-prevent]')),
      });
      if (document.documentElement.hasAttribute('data-story-loading')) lenis.stop();
      document.addEventListener('story-loading-start', () => lenis.stop(), { signal: listeners.signal });
      document.addEventListener('story-loading-end', () => lenis.start(), { signal: listeners.signal });
      const tick = (time: number) => lenis.raf(time * 1000);
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(tick);

      const focusTarget = (target: HTMLElement) => {
        if (!target.hasAttribute('tabindex')) {
          target.setAttribute('tabindex', '-1');
          target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
        }
        target.focus({ preventScroll: true });
      };

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
        if (!link || link.target || link.hasAttribute('download') || link.closest('[data-funmenu-overlay]') || link.hash.length < 2) return;
        let target: HTMLElement | null;
        try {
          target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        } catch {
          return;
        }
        if (!target) return;
        event.preventDefault();
        lenis.scrollTo(target, {
          offset: -32,
          duration: 2.6,
          easing: (time) => (1 - Math.cos(Math.PI * time)) / 2,
          onComplete: () => {
            if (location.hash !== link.hash) history.pushState(history.state, '', link.hash);
            focusTarget(target);
          },
        });
      }, { signal: listeners.signal });

      const interruptScroll = (event: Event) => {
        if (event instanceof KeyboardEvent && !['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) return;
        if (lenis.isScrolling) lenis.scrollTo(window.scrollY, { immediate: true });
      };
      window.addEventListener('keydown', interruptScroll, { signal: listeners.signal });
      window.addEventListener('touchstart', interruptScroll, { passive: true, signal: listeners.signal });

      const animated = new Set<HTMLElement>();
      const track = (element: HTMLElement) => {
        element.setAttribute('data-page-motion-layer', '');
        animated.add(element);
      };

      const initAnimations = () => context.add(() => {
        root.querySelectorAll<HTMLElement>(settings[page].reveals).forEach((element) => {
          ScrollTrigger.create({
            trigger: element,
            start: 'top 94%',
            once: true,
            onEnter: () => context.add(() => {
              track(element);
              gsap.fromTo(element, { '--page-motion-y': '24px', opacity: 0.35 }, {
                '--page-motion-y': '0px',
                opacity: 1,
                duration: 0.8,
                ease: 'power2.out',
                clearProps: '--page-motion-y,opacity',
              });
            }),
          });
        });

        if (context.conditions?.desktop) {
          root.querySelectorAll<HTMLElement>(settings[page].layers).forEach((element, index) => {
            const section = element.closest('section') || root;
            const hero = section === root.querySelector('section');
            ScrollTrigger.create({
              trigger: section,
              start: 'top bottom',
              once: true,
              onEnter: () => context.add(() => {
                track(element);
                gsap.fromTo(element, { '--page-motion-y': hero ? '0px' : '16px' }, {
                  '--page-motion-y': hero ? `${index % 2 ? -110 : -70}px` : '-16px',
                  ease: 'none',
                  scrollTrigger: {
                    trigger: section,
                    start: hero ? 'top top' : 'top bottom',
                    end: 'bottom top',
                    scrub: 0.8,
                    invalidateOnRefresh: true,
                  },
                });
              }),
            });
          });
        }

        lenis.resize();
        ScrollTrigger.refresh();
      });

      if (page === 'home' && document.documentElement.dataset.homeStoryReady !== 'true') {
        document.addEventListener('home-story-ready', initAnimations, { once: true, signal: listeners.signal });
      } else {
        initAnimations();
      }

      let resizeFrame = 0;
      const resizeObserver = new ResizeObserver(() => {
        lenis.resize();
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(() => ScrollTrigger.refresh());
      });
      resizeObserver.observe(root);

      return () => {
        listeners.abort();
        pointerCleanups.forEach((cleanup) => cleanup());
        pointerLayers.forEach((element) => element.removeAttribute('data-pointer-motion-layer'));
        resizeObserver.disconnect();
        cancelAnimationFrame(resizeFrame);
        gsap.ticker.remove(tick);
        lenis.destroy();
        animated.forEach((element) => element.removeAttribute('data-page-motion-layer'));
      };
    }, root);

    disposePageMotion = () => media.revert();
  }

  initPageMotion();
  document.addEventListener('astro:page-load', initPageMotion);
  document.addEventListener('astro:before-swap', () => {
    disposePageMotion?.();
    disposePageMotion = undefined;
  });
</script>