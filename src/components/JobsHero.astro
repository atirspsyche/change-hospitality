---
import EggIllustration from "./EggIllustration.astro";

interface Props {
  locations: string[];
  positions: string[];
  jobTypes: string[];
}

const { locations, positions, jobTypes } = Astro.props;
---

<section class="jobs-hero" aria-labelledby="jobs-page-title" data-jobs-hero>
  <div class="jobs-hero-inner">
    <div class="jobs-hero-copy">
      <p class="jobs-hero-kicker">Fresh from the pass</p>
      <h1 id="jobs-page-title">
        Find a job<br /><span>with good energy.</span>
      </h1>
      <p class="jobs-hero-intro">
        Hospitality roles picked by people who know the room. Choose what
        matters, then see what is ready right now.
      </p>

      <form class="jobs-search" id="job-search-form" data-job-search-form>
        <div class="jobs-search-fields">
          <label>
            <span class="jobs-select-label">Location</span>
            <span class="jobs-select-control">
              <select name="location" data-job-filter="location">
                <option value="">Anywhere</option>
                {
                  locations.map((location) => (
                    <option value={location}>{location}</option>
                  ))
                }
              </select>
              <span class="jobs-select-arrow" aria-hidden="true"></span>
            </span>
          </label>
          <label>
            <span class="jobs-select-label">Position</span>
            <span class="jobs-select-control">
              <select name="position" data-job-filter="position">
                <option value="">Any team</option>
                {
                  positions.map((position) => (
                    <option value={position}>{position}</option>
                  ))
                }
              </select>
              <span class="jobs-select-arrow" aria-hidden="true"></span>
            </span>
          </label>
          <label>
            <span class="jobs-select-label">Job type</span>
            <span class="jobs-select-control">
              <select name="jobType" data-job-filter="jobType">
                <option value="">Any type</option>
                {
                  jobTypes.map((jobType) => (
                    <option value={jobType}>{jobType}</option>
                  ))
                }
              </select>
              <span class="jobs-select-arrow" aria-hidden="true"></span>
            </span>
          </label>
        </div>

        <div class="jobs-search-actions">
          <button class="jobs-search-primary" type="submit">
            Search jobs <span aria-hidden="true">&#8599;</span>
          </button>
          <button
            class="jobs-search-secondary"
            type="button"
            data-show-all-jobs
          >
            Show all jobs <span aria-hidden="true">&#8595;</span>
          </button>
        </div>
      </form>
    </div>

    <div class="jobs-hero-art" aria-hidden="true">
      <EggIllustration class="jobs-art-egg" />
    </div>
  </div>
</section>

<style>
  .jobs-hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-blush);
    color: var(--color-ink);
    padding: 7.5rem 1.25rem 4rem;
  }

  .jobs-hero::before,
  .jobs-hero::after {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    content: "";
  }

  .jobs-hero::before {
    left: -8rem;
    bottom: -3rem;
    width: 24rem;
    height: 13rem;
    background: var(--color-citron);
    transform: rotate(18deg);
  }

  .jobs-hero::after {
    top: 6rem;
    right: -15rem;
    width: 30rem;
    height: 20rem;
    background: var(--color-flame);
    transform: rotate(-18deg);
  }

  .jobs-hero-inner {
    display: grid;
    width: min(100%, 80rem);
    margin: 0 auto;
    gap: 2.5rem;
    align-items: center;
  }

  .jobs-hero-copy {
    position: relative;
    z-index: 2;
  }

  .jobs-hero-kicker {
    width: fit-content;
    margin-bottom: 1.3rem;
    border-radius: 999px;
    background: var(--color-citron);
    padding: 0.7rem 1rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .jobs-hero h1 {
    max-width: 50rem;
    font-family: var(--font-hero);
    font-size: clamp(3.5rem, 7.5vw, 7.5rem);
    font-weight: 400;
    line-height: 0.9;
    text-wrap: balance;
  }

  .jobs-hero h1 span {
    color: var(--color-flame);
  }

  .jobs-hero-intro {
    max-width: 38rem;
    margin-top: 1.75rem;
    color: var(--color-cocoa);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 800;
    line-height: 1.5;
  }

  .jobs-search {
    position: relative;
    z-index: 4;
    width: min(100%, 57rem);
    margin-top: 2.25rem;
    border-radius: 1.25rem;
    background: var(--color-cream);
    padding: 0.75rem;
  }

  .jobs-search-fields {
    display: grid;
    gap: 0.55rem;
  }

  .jobs-search label {
    --select-accent: var(--color-flame);
    --select-accent-text: var(--color-cream);
    display: grid;
    min-width: 0;
    gap: 0.65rem;
    border-radius: 0.85rem;
    background: var(--color-paper);
    padding: 0.7rem 0.7rem 0.7rem 0.85rem;
    transition:
      background-color 220ms ease,
      transform 280ms var(--ease-cartoon);
  }

  .jobs-search label:nth-child(2) {
    --select-accent: var(--color-cocoa);
  }

  .jobs-search label:nth-child(3) {
    --select-accent: var(--color-citron);
    --select-accent-text: var(--color-ink);
  }

  .jobs-select-label {
    width: fit-content;
    border-radius: 999px;
    background: var(--select-accent);
    color: var(--select-accent-text);
    padding: 0.35rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .jobs-select-control {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
  }

  .jobs-search select {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    padding: 0 3.25rem 0 0.15rem;
    font-size: 1rem;
    font-weight: 900;
    outline: 0;
    cursor: pointer;
  }

  .jobs-search select option {
    background: var(--color-cream);
    color: var(--color-ink);
    font-weight: 700;
  }

  .jobs-select-arrow {
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    width: 2.65rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 0.65rem;
    background: var(--select-accent);
    pointer-events: none;
    transform: translateY(-50%);
    transition: transform 280ms var(--ease-cartoon);
  }

  .jobs-select-arrow::before {
    width: 0.58rem;
    height: 0.58rem;
    border-right: 0.16rem solid var(--select-accent-text);
    border-bottom: 0.16rem solid var(--select-accent-text);
    content: "";
    transform: translateY(-0.14rem) rotate(45deg);
  }

  .jobs-search label:hover {
    background: var(--color-cream);
    transform: translateY(-0.12rem);
  }

  .jobs-search label:focus-within {
    background: var(--color-mint);
    transform: translateY(-0.18rem);
  }

  .jobs-search label:focus-within .jobs-select-arrow {
    transform: translateY(-50%) rotate(-4deg) scale(1.05);
  }

  .jobs-search-actions {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .jobs-search button {
    display: inline-flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 0;
    border-radius: 0.8rem;
    padding: 1rem 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform 300ms var(--ease-cartoon),
      background-color 220ms ease;
  }

  .jobs-search button span {
    font-size: 1.35rem;
  }

  .jobs-search button:hover,
  .jobs-search button:focus-visible {
    transform: translateY(-0.18rem) rotate(-1deg);
  }

  .jobs-search-primary {
    background: var(--color-cocoa);
    color: var(--color-cream);
    /* font-family: var(--font-display); */
  }

  .jobs-search-primary:hover,
  .jobs-search-primary:focus-visible {
    background: var(--color-flame);
  }

  .jobs-search-secondary {
    background: var(--color-citron);
    color: var(--color-ink);
  }

  .jobs-hero-art {
    --egg-position: relative;
    --egg-width: min(29rem, 38vw);
    --egg-rotate: -10deg;
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 27rem;
    align-items: center;
    justify-content: flex-end;
  }

  @media (min-width: 640px) {
    .jobs-search-fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .jobs-search-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .jobs-hero {
      padding-inline: 2.5rem;
    }
    .jobs-hero-inner {
      grid-template-columns: minmax(0, 1.18fr) minmax(22rem, 0.82fr);
    }
    .jobs-hero-art {
      min-height: 34rem;
    }
  }

  @media (max-width: 639px) {
    .jobs-hero {
      min-height: auto;
      padding-top: 7rem;
    }
    .jobs-hero::before {
      left: -10rem;
      bottom: -2rem;
    }
    .jobs-hero::after {
      top: 5.5rem;
      right: -12rem;
    }
    .jobs-hero h1 {
      font-size: clamp(3.25rem, 16vw, 5.1rem);
    }
    .jobs-hero-art {
      --egg-width: min(18rem, 74vw);
      min-height: 20rem;
    }
  }
</style>
