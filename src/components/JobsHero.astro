---
import { BriefcaseBusiness, Clock3 } from "@lucide/astro";
import EggIllustration from "./EggIllustration.astro";
---

<section class="jobs-hero" aria-labelledby="jobs-page-title" data-jobs-hero>
  <div class="jobs-hero-inner">
    <div class="jobs-hero-copy">
      <p class="jobs-hero-kicker">Live roles</p>
      <h1 id="jobs-page-title">
        <span>Your next move</span> <br /> is closer than you think
      </h1>
      <p class="jobs-hero-intro">
        From small independents to biggest names in the industry, and everything in between. 
        There's something for everyone here.
      </p>

      <fieldset class="jobs-mode-switch" data-jobs-mode-switch>
        <legend>What kind of work suits you?</legend>
        <div class="jobs-mode-options">
          <label>
            <input type="radio" name="jobsMode" value="permanent" aria-controls="jobs" checked />
            <span>
              <BriefcaseBusiness size={18} aria-hidden="true" focusable="false" />
              Permanent
            </span>
          </label>
          <label>
            <input type="radio" name="jobsMode" value="temporary" aria-controls="temporary-work" />
            <span>
              <Clock3 size={18} aria-hidden="true" focusable="false" />
              Temporary
            </span>
          </label>
        </div>
      </fieldset>
    </div>

    <div class="jobs-hero-art" aria-hidden="true">
      <EggIllustration class="jobs-art-egg" />
    </div>
  </div>
</section>

<style>
  .jobs-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100vh;
    align-items: center;
    overflow: hidden;
    background: var(--color-blush);
    color: var(--color-ink);
    padding: 7.5rem 1.25rem;
  }

  .jobs-hero::before,
  .jobs-hero::after {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    content: "";
  }

  .jobs-hero::before {
    left: -8rem;
    bottom: -3rem;
    width: 24rem;
    height: 13rem;
    background: var(--color-citron);
    transform: rotate(18deg);
  }

  .jobs-hero::after {
    top: 6rem;
    right: -15rem;
    width: 30rem;
    height: 20rem;
    background: var(--color-flame);
    transform: rotate(-18deg);
  }

  .jobs-hero-inner {
    display: grid;
    width: min(100%, 80rem);
    margin: 0 auto;
    gap: 2.5rem;
    align-items: center;
  }

  .jobs-hero-copy {
    position: relative;
    z-index: 2;
  }

  .jobs-hero-kicker {
    width: fit-content;
    margin-bottom: 1.3rem;
    border-radius: 999px;
    background: var(--color-citron);
    padding: 0.7rem 1rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .jobs-hero h1 {
    max-width: 50rem;
    font-family: var(--font-hero);
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    text-wrap: balance;
  }

  .jobs-hero h1 span {
    color: var(--color-flame);
  }

  .jobs-hero-intro {
    max-width: 38rem;
    margin-top: 1.75rem;
    color: var(--color-cocoa);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 800;
    line-height: 1.5;
  }

  .jobs-mode-switch {
    min-width: 0;
    width: min(100%, 22rem);
    margin-top: 2.25rem;
    border: 0;
    padding: 0;
  }

  .jobs-mode-switch legend {
    margin-bottom: 0.85rem;
    color: var(--color-cocoa);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    font-family: var(--font-display);
  }

  .jobs-mode-options {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 35%, transparent);
    border-radius: 999px;
    background: var(--color-cream);
    padding: 0.3rem;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--color-cocoa) 15%, transparent);
  }

  .jobs-mode-options::before {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0.3rem;
    width: calc(50% - 0.3rem);
    border-radius: 999px;
    background: var(--color-cocoa);
    content: "";
    transition: transform 320ms var(--ease-luxury);
  }

  .jobs-mode-options:has(input[value="temporary"]:checked)::before {
    transform: translateX(100%);
  }

  .jobs-mode-switch label {
    position: relative;
    z-index: 1;
    min-width: 0;
    cursor: pointer;
  }

  .jobs-mode-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .jobs-mode-switch span {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    color: var(--color-cocoa);
    padding: 0.65rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 900;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .jobs-mode-switch input:checked + span {
    color: var(--color-cream);
  }

  .jobs-mode-switch input:focus-visible + span {
    outline: 3px solid var(--color-cocoa);
    outline-offset: 3px;
  }

  .jobs-mode-switch label:hover input:not(:checked) + span {
    background: color-mix(in srgb, var(--color-cocoa) 8%, transparent);
  }

  .jobs-hero-art {
    --egg-position: relative;
    --egg-width: min(29rem, 38vw);
    --egg-rotate: -10deg;
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 27rem;
    align-items: center;
    justify-content: flex-end;
  }

  @media (prefers-reduced-motion: reduce) {
    .jobs-mode-options::before,
    .jobs-mode-switch span {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .jobs-hero {
      padding-inline: 2.5rem;
    }
    .jobs-hero-inner {
      grid-template-columns: minmax(0, 1.18fr) minmax(22rem, 0.82fr);
    }
    .jobs-hero-art {
      min-height: 34rem;
    }
  }

  @media (max-width: 639px) {
    .jobs-hero {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: 4rem;
    }
    .jobs-hero::before {
      left: -10rem;
      bottom: -2rem;
    }
    .jobs-hero::after {
      top: 5.5rem;
      right: -12rem;
    }
    .jobs-hero h1 {
      font-size: clamp(2.75rem, 13.5vw, 4.25rem);
    }
    .jobs-hero-art {
      --egg-width: min(18rem, 74vw);
      min-height: 20rem;
    }
  }
</style>
