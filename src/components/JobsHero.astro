---
import HeroIllustration from "./HeroIllustration.astro";
---

<section class="jobs-hero" aria-labelledby="jobs-page-title" data-jobs-hero>
  <!-- <div class="jobs-hero-shape jobs-hero-shape-one" data-hero-shape="1" aria-hidden="true"></div> -->
  <div class="jobs-hero-shape jobs-hero-shape-two" data-hero-shape="-1" aria-hidden="true"></div>
  <div class="jobs-hero-inner">
    <div class="jobs-hero-copy">
      <p class="jobs-hero-kicker">Live roles</p>
      <h1 id="jobs-page-title">
        <span>Your next move</span> is closer than you think
      </h1>
      <p class="jobs-hero-intro">
        From small independents to biggest names in the industry, and everything in between. 
        There's something for everyone here.
      </p>

      <fieldset class="jobs-mode-switch" data-jobs-mode-switch>
        <legend>What kind of work suits you?</legend>
        <div class="jobs-mode-options">
          <label>
            <input type="radio" name="jobsMode" value="permanent" aria-controls="jobs" checked />
            <span class="jobs-mode-choice">
              <svg class="jobs-mode-outline" viewBox="0 0 240 44" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
                <path d="M22 3C72 1 161 4 216 2C243 1 244 40 218 41C161 44 79 40 23 42C-3 43-4 4 22 3Z" />
              </svg>
              <span class="jobs-mode-indicator" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" focusable="false">
                  <path d="m3 8 3.5 3.5L13 4" />
                </svg>
              </span>
              Permanent
            </span>
          </label>
          <label>
            <input type="radio" name="jobsMode" value="temporary" aria-controls="temporary-work" />
            <span class="jobs-mode-choice">
              <svg class="jobs-mode-outline" viewBox="0 0 240 44" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
                <path d="M22 3C72 1 161 4 216 2C243 1 244 40 218 41C161 44 79 40 23 42C-3 43-4 4 22 3Z" />
              </svg>
              <span class="jobs-mode-indicator" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" focusable="false">
                  <path d="m3 8 3.5 3.5L13 4" />
                </svg>
              </span>
              Temporary
            </span>
          </label>
        </div>
      </fieldset>
    </div>

    <div class="jobs-hero-art" aria-hidden="true">
      <HeroIllustration kind="chef" />
    </div>
  </div>
</section>

<style>
  .jobs-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100vh;
    align-items: center;
    overflow: hidden;
    background: var(--color-blush);
    color: var(--color-ink);
    padding: 7.5rem 1.25rem;
  }

  .jobs-hero-shape {
    position: absolute;
    z-index: -1;
    border-radius: 43% 57% 62% 38% / 52% 40% 60% 48%;
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 18%, transparent);
    pointer-events: none;
  }

  .jobs-hero-shape-one {
    left: -8rem;
    bottom: -3rem;
    width: 24rem;
    height: 13rem;
    background: var(--color-cream);
    transform: rotate(18deg);
  }

  .jobs-hero-shape-two {
    top: 4rem;
    right: -12rem;
    width: 24rem;
    height: 16rem;
    background: radial-gradient(color-mix(in srgb, var(--color-flame) 30%, transparent) 1px, transparent 1px) 0 0 / 12px 12px,
      color-mix(in srgb, var(--color-flame) 12%, var(--color-blush));
    transform: rotate(-18deg);
  }

  .jobs-hero-inner {
    display: grid;
    width: min(100%, 80rem);
    margin: 0 auto;
    gap: 2.5rem;
    align-items: center;
  }

  .jobs-hero-copy {
    position: relative;
    z-index: 2;
  }

  .jobs-hero-kicker {
    width: fit-content;
    margin-bottom: 1.3rem;
    border-radius: 999px;
    background: var(--color-citron);
    padding: 0.7rem 1rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .jobs-hero h1 {
    max-width: 50rem;
    font-family: var(--font-hero);
    /* font-size: clamp(2.5rem, 6vw, 6rem); */
    font-size: clamp(2.5rem, 5.3vw, 5rem);;
    font-weight: 400;
    line-height: 0.9;
    text-wrap: balance;
    color: var(--color-cocoa);
  }

  .jobs-hero h1 span {
    color: var(--color-flame);
  }

  .jobs-hero-intro {
    max-width: 38rem;
    margin-top: 2rem;
    color: var(--color-ink);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 800;
    line-height: 1.5;
    font-family: var(--font-body);

  }

  .jobs-mode-switch {
    min-width: 0;
    width: min(100%, 23rem);
    margin-top: 2.25rem;
    border: 0;
    padding: 0;
  }

  .jobs-mode-switch legend {
    margin-bottom: 0.85rem;
    color: var(--color-ink);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    font-family: var(--font-display);
  }

  .jobs-mode-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .jobs-mode-switch label {
    position: relative;
    min-width: 0;
    cursor: pointer;
  }

  .jobs-mode-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .jobs-mode-choice {
    position: relative;
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 1.7rem 1.4rem 1.8rem 1.5rem;
    background: var(--color-cream);
    color: var(--color-cocoa);
    padding: 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
    transition:
      background-color 300ms ease,
      color 300ms ease,
      transform 450ms var(--ease-luxury);
  }

  .jobs-mode-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    stroke: var(--color-cocoa);
    stroke-width: 1.4;
  }

  .jobs-mode-outline path {
    vector-effect: non-scaling-stroke;
  }

  .jobs-mode-indicator {
    display: grid;
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    place-items: center;
    border: 1.4px solid currentColor;
    border-radius: 45% 55% 48% 52%;
  }

  .jobs-mode-indicator svg {
    width: 0.8rem;
    height: 0.8rem;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 250ms ease, transform 350ms var(--ease-cartoon);
  }

  .jobs-mode-switch input:checked + .jobs-mode-choice {
    background: var(--color-citron);
    transform: rotate(-1.5deg);
  }

  .jobs-mode-switch input:checked + .jobs-mode-choice .jobs-mode-indicator svg {
    opacity: 1;
    transform: scale(1);
  }

  .jobs-mode-switch input:focus-visible + .jobs-mode-choice {
    outline: 3px solid var(--color-cocoa);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .jobs-mode-switch label:hover input:not(:checked) + .jobs-mode-choice {
      background: color-mix(in srgb, var(--color-citron) 35%, var(--color-cream));
      transform: translateY(-2px);
    }
  }

  .jobs-hero-art {
    position: relative;
    z-index: 1;
    width: min(100%, 36rem);
    justify-self: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .jobs-mode-choice,
    .jobs-mode-indicator svg {
      transition: none;
    }

    .jobs-mode-switch input:checked + .jobs-mode-choice,
    .jobs-mode-switch label:hover input:not(:checked) + .jobs-mode-choice {
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .jobs-hero {
      padding-inline: 2.5rem;
    }
    .jobs-hero-inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    }
  }

  @media (max-width: 639px) {
    .jobs-hero {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: 4rem;
    }
    .jobs-hero-shape-one {
      left: -10rem;
      bottom: -2rem;
    }
    .jobs-hero-shape-two {
      top: 5.5rem;
      right: -12rem;
    }
    .jobs-hero h1 {
      font-size: clamp(2.75rem, 13.5vw, 4.25rem);
    }
    .jobs-hero-art {
      width: min(100%, 23rem);
    }
  }
</style>
