---
import { getPublicContacts } from '../sanity/queries';
const contacts = await getPublicContacts();
export interface FunMenuLink {
  label: string;
  href: string;
  meta?: string;
}

interface Props {
  sectionLinks?: FunMenuLink[];
  menuButtonBackground?: string;
  menuButtonBorderColor?: string;
  menuButtonTextColor?: string;
}

const {
  sectionLinks = [],
  menuButtonBackground = 'var(--color-cream)',
  menuButtonBorderColor = 'var(--color-cocoa)',
  menuButtonTextColor = 'var(--color-cocoa)',
} = Astro.props;

const menuLabel = 'The Menu';
const sealOutline = 'M33 5C66 2 119 4 150 5C168 5 179 15 179 31C180 48 168 58 150 59C113 61 69 58 33 59C15 60 5 50 5 33C4 16 15 5 33 5Z';
const frameOutline = 'M52 10C251 6 529 15 731 9C837 6 925 9 962 12C979 14 989 27 990 49C995 292 986 558 990 778C992 865 991 925 983 956C977 979 960 990 930 990C668 995 399 985 139 991C83 992 51 989 31 974C11 961 10 940 10 911C6 668 15 395 9 150C8 95 8 57 17 35C24 17 35 11 52 10Z';

const siteLinks: FunMenuLink[] = [
  { label: 'Home', href: '/', meta: 'Back to the start' },
  { label: 'Jobs', href: '/jobs/', meta: 'Find your next role' },
  { label: 'Recruit', href: '/recruit-talent/', meta: 'Build your team' },
  { label: 'Team', href: '/team/', meta: 'Meet the team' },
  { label: 'Our Story', href: '/our-story/', meta: 'How it all started' },
  { label: 'Franchising', href: '/franchising/', meta: 'Build your own future' },
  { label: 'Sustainability', href: '/sustainability-impact/', meta: 'People & planet' },
];

const currentPath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const currentLink = siteLinks.find((link) =>
  link.href === currentPath || (link.href !== '/' && currentPath.startsWith(link.href))
);

const menuPalettes = [
  { background: 'flame', upper: 'blush', lower: 'cocoa' },
  { background: 'citron', upper: 'cocoa', lower: 'flame' },
  { background: 'mint', upper: 'flame', lower: 'cocoa' },
  { background: 'blush', upper: 'cocoa', lower: 'flame' },
  { background: 'mist', upper: 'cocoa', lower: 'flame' },
];
---

<div
  class="funmenu"
  data-funmenu
  style={`--menu-toggle-background: ${menuButtonBackground}; --menu-toggle-border: ${menuButtonBorderColor}; --menu-toggle-text: ${menuButtonTextColor};`}
>
  <!-- Floating flat cartoon bar -->
  <div class="funmenu-bar" data-funmenu-bar>
    <a class="funmenu-brand" href="/" aria-label="Change Hospitality home">
      <img src="/change-hospitality-logo-new.svg" alt="Change Hospitality" />
    </a>

    <nav class="funmenu-inline" aria-label="Page sections">
      <!-- {sectionLinks.map((link) => (
        <a class="funmenu-inline-link" href={link.href}>{link.label}</a>
      ))} -->
    </nav>

    <div class="funmenu-actions">
      <button
        class="funmenu-toggle"
        type="button"
        aria-label="The Menu, open navigation"
        aria-expanded="false"
        aria-controls="funmenu-overlay"
        data-funmenu-toggle
      >
        <svg class="funmenu-toggle-seal" viewBox="0 0 184 64" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="funmenu-seal-clip"><path d={sealOutline} data-seal-shape /></clipPath>
          </defs>
          <path class="funmenu-toggle-paper" d={sealOutline} data-seal-shape />
          <g clip-path="url(#funmenu-seal-clip)">
            <path class="funmenu-toggle-highlight" d={sealOutline} data-seal-shape />
          </g>
          <path class="funmenu-toggle-outline" d={sealOutline} data-seal-shape />
          <path
            class="funmenu-toggle-trace"
            d="M13 19C25-1 60 1 94 2C124 2 159-1 175 15C188 29 182 49 165 59C146 66 108 61 78 62C48 63 17 64 7 47C1 37 3 27 8 21"
            pathLength="1"
          />
        </svg>
        <span class="funmenu-toggle-label" aria-hidden="true">
          {[...menuLabel].map((letter, index) => (
            <span class="funmenu-toggle-letter" data-letter={letter === ' ' ? '\u00a0' : letter} style={`--letter-index: ${index}`}>{letter === ' ' ? '\u00a0' : letter}</span>
          ))}
        </span>
        <span class="funmenu-toggle-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Partial cartoon drawer -->
  <div
    class="funmenu-overlay"
    id="funmenu-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    data-funmenu-overlay
    hidden
  >
    <div class="funmenu-surface" aria-hidden="true">
      <div class="funmenu-blob funmenu-blob-1" data-parallax="6"></div>
      <div class="funmenu-blob funmenu-blob-2" data-parallax="-10"></div>
      <div class="funmenu-cursor" data-funmenu-cursor></div>
    </div>
    <svg class="funmenu-frame" viewBox="0 0 1000 1000" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="funmenu-surface-clip" clipPathUnits="objectBoundingBox">
          <path d={frameOutline} transform="scale(0.001)" />
        </clipPath>
      </defs>
      <path class="funmenu-frame-paper" d={frameOutline} />
      <path class="funmenu-frame-ink" d={frameOutline} />
    </svg>

    <div class="funmenu-overlay-header">
      <p class="funmenu-eyebrow">Change Hospitality / people first</p>
    </div>
    <div class="funmenu-overlay-inner">
      <nav class="funmenu-list" aria-label="Site navigation">
        {siteLinks.map((link, index) => {
          const palette = menuPalettes[index % menuPalettes.length];
          return (
            <a
              class="funmenu-link"
              href={link.href}
              aria-current={link === currentLink ? (currentPath === link.href ? 'page' : 'location') : undefined}
              style={`--menu-flash: var(--color-${palette.background}); --menu-blob-upper: var(--color-${palette.upper}); --menu-blob-lower: var(--color-${palette.lower}); --link-index: ${index};`}
              data-funmenu-link
            >
              <span class="funmenu-link-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="funmenu-link-text" data-text={link.label}>{link.label}</span>
              {link === currentLink
                ? <span class="funmenu-current-badge" aria-hidden="true">You're here</span>
                : link.meta && <span class="funmenu-link-meta">{link.meta}</span>}
              <svg class="funmenu-link-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M5 19 19 5M5 5h14v14" />
              </svg>
            </a>
          );
        })}
      </nav>
      <div class="funmenu-footer">
        <a href={`mailto:${contacts.generalEmail}`}>{contacts.generalEmail}</a>
        <span>Front of House · Back of House · Events &amp; Commercial</span>
      </div>
    </div>
  </div>
</div>

<style>
  .funmenu {
    --menu-flash: var(--color-flame);
    --menu-blob-upper: var(--color-blush);
    --menu-blob-lower: var(--color-cocoa);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    pointer-events: none;
  }

  /* ---------- Floating cartoon bar ---------- */
  .funmenu-bar {
    pointer-events: auto;
    position: relative;
    z-index: 62;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: transparent;
    padding: 1rem;
    transition:
      transform 500ms var(--ease-cartoon);
  }

  .funmenu-bar.is-hidden {
    transform: translateY(-140%);
  }

  .funmenu-brand {
    position: relative;
    isolation: isolate;
    display: block;
    width: 8.5rem;
    height: 3.6rem;
    overflow: hidden;
    justify-self: start;
  }

  .funmenu-brand img {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 8.5rem;
    width: 8.5rem;
    object-fit: contain;
    transform: translate(-50%, -50%);
    filter:
      drop-shadow(2px 2px 0 var(--color-cocoa))
      drop-shadow(0 3px 4px color-mix(in srgb, var(--color-cocoa) 32%, transparent));
    transition: transform 400ms var(--ease-cartoon);
  }

  .funmenu-brand:hover img,
  .funmenu-brand:focus-visible img {
    transform: translate(-50%, -50%) rotate(-8deg) scale(1.05);
  }

  .funmenu-inline {
    display: none;
    align-items: center;
    justify-self: center;
    gap: 0.45rem;
  }

  .funmenu-inline-link {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    border-radius: 1.1rem;
    background: var(--color-cream);
    padding: 0.82rem 1.1rem;
    font-size: 0.86rem;
    font-weight: 900;
    color: var(--color-ink);
    transition:
      color 160ms ease,
      transform 320ms var(--ease-cartoon),
      background-color 240ms ease;
  }

  .funmenu-inline-link::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 0;
    background: var(--color-flame);
    transition: height 300ms var(--ease-cartoon);
  }

  .funmenu-inline-link:nth-child(2n)::before {
    background: var(--color-mint);
  }

  .funmenu-inline-link:nth-child(3n)::before {
    background: var(--color-citron);
  }

  .funmenu-inline-link:hover,
  .funmenu-inline-link:focus-visible {
    color: var(--color-cream);
    transform: translateY(-0.25rem) rotate(-2deg) scale(1.04);
  }

  .funmenu-inline-link:nth-child(2n):hover,
  .funmenu-inline-link:nth-child(2n):focus-visible {
    color: var(--color-ink);
  }

  .funmenu-inline-link:hover::before,
  .funmenu-inline-link:focus-visible::before {
    height: 100%;
  }

  .funmenu-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;
  }

  .funmenu-toggle {
    --menu-toggle-width: 11.5rem;
    --menu-toggle-size: 4rem;
    position: relative;
    isolation: isolate;
    flex: none;
    width: var(--menu-toggle-width);
    height: var(--menu-toggle-size);
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0;
    color: var(--menu-toggle-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      width 540ms var(--ease-luxury),
      color 350ms ease;
  }

  .funmenu-toggle:focus-visible {
    outline: 2px solid var(--color-cocoa);
    outline-offset: 4px;
    box-shadow: 0 0 0 4px var(--color-cream);
  }

  .funmenu-toggle-seal {
    position: absolute;
    inset: 0 0 0 auto;
    width: var(--menu-toggle-width);
    max-width: none;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .funmenu-toggle-paper {
    fill: var(--menu-toggle-background);
    transition: fill 450ms ease;
  }

  .funmenu-toggle-highlight {
    fill: var(--color-citron);
    transform-box: view-box;
    transform: translateY(105%);
    transition: transform 550ms var(--ease-luxury);
  }

  .funmenu-toggle-outline {
    stroke: var(--menu-toggle-border);
    stroke-width: 1.7;
    vector-effect: non-scaling-stroke;
    transition: stroke 450ms ease;
  }

  .funmenu-toggle-trace {
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke: var(--color-cocoa);
    stroke-width: 1.15;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 650ms var(--ease-luxury),
      opacity 250ms ease;
  }

  .funmenu-toggle-label {
    position: absolute;
    top: 50%;
    right: 3.8rem;
    width: calc(var(--menu-toggle-width) - 5.2rem);
    display: flex;
    justify-content: center;
    overflow: hidden;
    font-family: var(--font-hero);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.6;
    white-space: nowrap;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      opacity 220ms ease 100ms,
      transform 500ms var(--ease-luxury);
  }

  .funmenu-toggle-letter {
    position: relative;
    display: block;
    transition: transform 500ms var(--ease-luxury);
    transition-delay: calc(var(--letter-index) * 16ms);
  }

  .funmenu-toggle-letter::after {
    position: absolute;
    top: 100%;
    left: 0;
    content: attr(data-letter);
  }

  .funmenu-toggle-bars {
    position: absolute;
    top: 0;
    right: 0;
    display: block;
    width: var(--menu-toggle-size);
    height: var(--menu-toggle-size);
    pointer-events: none;
  }

  .funmenu-toggle-bars span {
    position: absolute;
    top: calc(50% - 1px);
    left: calc(50% - 0.65rem);
    display: block;
    height: 2px;
    width: 1.3rem;
    border-radius: 999px;
    background: currentColor;
    transition: transform 450ms var(--ease-luxury);
  }

  .funmenu-toggle-bars span:first-child {
    transform: translateY(-4px) rotate(-3deg);
  }

  .funmenu-toggle-bars span:last-child {
    transform: translateY(4px) rotate(2deg);
  }

  .funmenu-toggle[aria-expanded='true'] {
    width: var(--menu-toggle-size);
    color: var(--color-cocoa);
  }

  .funmenu-toggle[aria-expanded='true'] .funmenu-toggle-paper {
    fill: var(--color-cream);
  }

  .funmenu-toggle[aria-expanded='true'] .funmenu-toggle-outline {
    stroke: var(--color-cocoa);
  }

  .funmenu-toggle[aria-expanded='true'] .funmenu-toggle-label {
    opacity: 0;
    transform: translate(8px, -65%);
    transition-delay: 0ms;
  }

  .funmenu-toggle[aria-expanded='true'] .funmenu-toggle-bars span:first-child {
    transform: rotate(43deg);
  }

  .funmenu-toggle[aria-expanded='true'] .funmenu-toggle-bars span:last-child {
    transform: rotate(-46deg);
  }

  .funmenu-toggle[aria-expanded='false']:focus-visible {
    color: var(--color-cocoa);
  }

  .funmenu-toggle[aria-expanded='false']:focus-visible .funmenu-toggle-highlight {
    transform: translateY(0);
  }

  .funmenu-toggle[aria-expanded='false']:focus-visible .funmenu-toggle-trace {
    stroke-dashoffset: 0;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .funmenu-toggle[aria-expanded='false']:focus-visible .funmenu-toggle-letter {
      transform: translateY(-100%);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .funmenu-toggle:hover {
      color: var(--color-cocoa);
    }

    .funmenu-toggle[aria-expanded='false']:hover .funmenu-toggle-highlight {
      transform: translateY(0);
    }

    .funmenu-toggle[aria-expanded='false']:hover .funmenu-toggle-trace {
      stroke-dashoffset: 0;
      opacity: 0.7;
    }

    .funmenu-toggle[aria-expanded='true']:hover .funmenu-toggle-paper {
      fill: var(--color-citron);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .funmenu-toggle[aria-expanded='false']:hover .funmenu-toggle-letter {
      transform: translateY(-100%);
    }

    .funmenu-toggle[aria-expanded='false']:hover .funmenu-toggle-bars span:first-child {
      transform: translateY(-5px) rotate(-3deg);
    }

    .funmenu-toggle[aria-expanded='false']:hover .funmenu-toggle-bars span:last-child {
      transform: translateY(5px) rotate(2deg);
    }
  }

  /* ---------- Partial overlay drawer ---------- */
  .funmenu-overlay {
    pointer-events: auto;
    position: fixed;
    inset: 0.75rem 0.75rem auto auto;
    z-index: 61;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    place-items: stretch;
    width: min(52rem, calc(100vw - 1.5rem));
    height: min(50rem, calc(100dvh - 1.5rem));
    overflow: visible;
    border-radius: 2.3rem 1rem 2.6rem 2.1rem;
    transform: translate3d(calc(100% + 8rem), -1rem, 0) rotate(7deg) scale(0.94);
    transform-origin: 100% 0;
    transition:
      border-radius 720ms var(--ease-cartoon),
      transform 720ms var(--ease-cartoon);
  }

  .funmenu-overlay.is-open {
    border-radius: 2rem 0.85rem 2.8rem 2.45rem;
    transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
  }

  .funmenu-surface {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: url(#funmenu-surface-clip);
    background: var(--menu-flash);
    pointer-events: none;
    transition: background-color 550ms var(--ease-luxury);
  }

  .funmenu-frame {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .funmenu-frame path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .funmenu-frame-paper {
    stroke: var(--color-cream);
    stroke-width: 4.5;
  }

  .funmenu-frame-ink {
    stroke: var(--color-cocoa);
    stroke-width: 1.6;
  }

  .funmenu-overlay::before {
    position: absolute;
    inset: 12% auto auto -1rem;
    z-index: 1;
    height: 68%;
    width: 7.5rem;
    border-radius: 999px;
    /* background: var(--color-citron); */
    content: '';
    transform: rotate(-4deg) scaleX(0.72);
    transform-origin: right center;
    transition: transform 620ms var(--ease-cartoon);
  }

  .funmenu-overlay.is-open::before {
    transform: rotate(-4deg) scaleX(1);
  }

  .funmenu-overlay-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 4.1rem;
    padding: 0.25rem 9.5rem 0.25rem 1.65rem;
  }

  .funmenu-overlay-inner {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 0;
    width: 100%;
    flex-direction: column;
    gap: 0.75rem;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.75rem 1.65rem 1.65rem;
  }

  .funmenu-eyebrow {
    margin: 0;
    margin-top: 1.5rem; 
    width: fit-content;
    border-radius: 0.5rem;
    background: var(--color-cream);
    padding: 0.45rem 0.65rem;
    font-size: 0.65rem;
    font-weight: 900;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0;
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 400ms ease,
      transform 500ms var(--ease-cartoon);
  }

  .funmenu-list {
    display: grid;
    flex-shrink: 0;
    gap: 0.4rem;
  }

  .funmenu-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: clamp(3.5rem, 9dvh, 5rem);
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 1.45rem;
    background: var(--color-cream);
    color: var(--color-ink);
    padding: 0.5rem 0.875rem;
    opacity: 0;
    transform: translateY(28px) rotate(-2deg);
    transition:
      opacity 400ms ease,
      transform 520ms var(--ease-cartoon),
      color 80ms linear;
  }

  .funmenu-link::before {
    position: absolute;
    inset: auto 0 0;
    height: 0;
    background: var(--color-ink);
    content: '';
    transition: height 380ms var(--ease-cartoon);
  }

  .funmenu-link-index {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .funmenu-link[aria-current] {
    border-color: var(--color-ink);
    background: var(--color-citron);
  }

  .funmenu-link[aria-current]::before {
    background: var(--color-citron);
  }

  .funmenu-link[aria-current]:hover,
  .funmenu-link[aria-current]:focus-visible {
    color: var(--color-ink);
  }

  .funmenu-current-badge {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    margin-left: auto;
    border: 1.5px solid var(--color-cocoa);
    border-radius: 999px;
    background: var(--color-cream);
    padding: 0.32rem 0.55rem;
    color: var(--color-cocoa);
    font-size: 0.6rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .funmenu-link-text {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: clamp(2rem, min(4.6vw, 6.7dvh), 3.9rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: 0;
    white-space: nowrap;
    transition: transform 380ms var(--ease-luxury);
  }

  .funmenu-link-text::after {
    display: none;
  }

  .funmenu-link-meta {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    margin-left: auto;
    max-width: 9rem;
    text-align: right;
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    transform: translateX(-6px);
    transition:
      transform 360ms var(--ease-cartoon);
  }

  .funmenu-link-arrow {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    opacity: 0;
    transform: translate(-0.3rem, 0.3rem);
    transition:
      opacity 240ms ease,
      transform 380ms var(--ease-luxury);
  }

  .funmenu-link:nth-child(2n) {
    transform: translateY(28px) rotate(2deg);
  }

  .funmenu-link:hover .funmenu-link-text,
  .funmenu-link:focus-visible .funmenu-link-text {
    transform: translateX(0.35rem);
  }

  .funmenu-link:hover,
  .funmenu-link:focus-visible {
    color: var(--color-cream);
    transform: rotate(-1deg) scale(1.02);
  }

  .funmenu-link:hover::before,
  .funmenu-link:focus-visible::before {
    height: 100%;
  }

  .funmenu-link:hover .funmenu-link-meta,
  .funmenu-link:focus-visible .funmenu-link-meta {
    transform: translateX(0);
  }

  .funmenu-link:hover .funmenu-link-arrow,
  .funmenu-link:focus-visible .funmenu-link-arrow {
    opacity: 1;
    transform: none;
  }

  .funmenu-overlay.is-open .funmenu-eyebrow,
  .funmenu-overlay.is-open .funmenu-link {
    opacity: 1;
    transform: none;
  }

  .funmenu-overlay.is-open .funmenu-eyebrow {
    transition-delay: 160ms;
  }

  .funmenu-overlay.is-open .funmenu-link {
    transition-delay:
      calc(180ms + var(--link-index) * 45ms),
      calc(180ms + var(--link-index) * 45ms),
      0ms;
  }

  .funmenu-overlay.is-open .funmenu-link:hover,
  .funmenu-overlay.is-open .funmenu-link:focus-visible {
    transition-delay: 0ms, 0ms, 0ms;
  }

  .funmenu-footer {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    border-radius: 1.25rem;
    background: var(--color-ink);
    padding: 1rem;
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--color-cream);
    opacity: 0;
    transition: opacity 400ms ease 560ms;
  }

  .funmenu-overlay.is-open .funmenu-footer {
    opacity: 1;
  }

  .funmenu-blob {
    position: absolute;
    border-radius: 32% 68% 58% 42% / 48% 42% 58% 52%;
    will-change: transform;
    transition: background-color 550ms var(--ease-luxury);
  }

  .funmenu-blob-1 {
    top: -6rem;
    right: -4rem;
    height: 26rem;
    width: 26rem;
    background: var(--menu-blob-upper);
  }

  .funmenu-blob-2 {
    bottom: -8rem;
    left: -6rem;
    height: 30rem;
    width: 30rem;
    background: var(--menu-blob-lower);
  }

  .funmenu-blob-3 {
    top: 40%;
    left: 12%;
    height: 12rem;
    width: 12rem;
    background: var(--color-citron);
  }

  .funmenu-cursor {
    position: fixed;
    top: 0;
    left: 0;
    height: 4.5rem;
    width: 4.5rem;
    margin: -2.25rem 0 0 -2.25rem;
    border-radius: 999px;
    background: var(--color-citron);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-50%, -50%, 0);
    transition: opacity 300ms ease, transform 180ms ease-out;
  }

  .funmenu-overlay.is-open .funmenu-cursor {
    opacity: 1;
  }

  body.funmenu-open {
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .funmenu-inline { display: flex; }
  }

  @media (max-width: 1023px) {
    .funmenu:has(.funmenu-overlay:not([hidden])) .funmenu-brand {
      visibility: hidden;
    }
  }

  @media (max-width: 767px) {
    .funmenu-toggle {
      --menu-toggle-width: 10rem;
      --menu-toggle-size: 3.6rem;
    }

    .funmenu-toggle-label {
      right: 3.4rem;
      width: calc(var(--menu-toggle-width) - 4.4rem);
      font-size: 1.05rem;
    }

    .funmenu-link-meta { display: none; }
    .funmenu-link {
      gap: 0.6rem;
      min-height: clamp(2.75rem, 8.5dvh, 4.25rem);
    }

    .funmenu-link-text { font-size: clamp(1.9rem, 9vw, 2.5rem); }

    .funmenu-link-arrow { margin-left: auto; }

    .funmenu-link[aria-current] {
      padding-top: 0.4rem;
      padding-bottom: 1.25rem;
    }

    .funmenu-current-badge {
      position: absolute;
      right: 0.875rem;
      bottom: 0.2rem;
      padding: 0.13rem 0.4rem;
      font-size: 0.55rem;
    }

    .funmenu-overlay {
      width: calc(100vw - 1rem);
      inset: 0.5rem 0.5rem auto auto;
    }

    .funmenu-overlay-header {
      min-height: 4.6rem;
      padding-left: 1rem;
    }

    .funmenu-overlay-inner {
      padding: 0.5rem 1rem 1rem;
    }

    .funmenu-bar {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 374px) {
    .funmenu-bar {
      gap: 0.5rem;
      padding: 0.75rem;
    }

    .funmenu-toggle {
      --menu-toggle-width: 9rem;
    }

    .funmenu-toggle-label {
      right: 3.1rem;
      width: calc(var(--menu-toggle-width) - 3.85rem);
      font-size: 0.95rem;
    }

    .funmenu-link-text { font-size: 1.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .funmenu-toggle,
    .funmenu-toggle *,
    .funmenu-overlay,
    .funmenu-overlay *,
    .funmenu-bar {
      transition-duration: 0.001ms !important;
      transition-delay: 0ms !important;
    }

    .funmenu-overlay {
      border-radius: 1.6rem !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initFunMenu() {
    const root = document.querySelector<HTMLElement>('[data-funmenu]');
    if (!root || root.dataset.funmenuReady === 'true') return;
    root.dataset.funmenuReady = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('[data-funmenu-toggle]');
    const overlay = root.querySelector<HTMLElement>('[data-funmenu-overlay]');
    const seal = root.querySelector<SVGSVGElement>('.funmenu-toggle-seal');
    const sealShapes = Array.from(root.querySelectorAll<SVGPathElement>('[data-seal-shape]'));
    const closedOutline = sealShapes[0]?.getAttribute('d');
    const bar = root.querySelector<HTMLElement>('[data-funmenu-bar]');
    const cursor = root.querySelector<HTMLElement>('[data-funmenu-cursor]');
    const links = Array.from(root.querySelectorAll<HTMLElement>('[data-funmenu-link]'));
    const blobs = Array.from(root.querySelectorAll<HTMLElement>('.funmenu-blob'));
    const paletteProperties = ['--menu-flash', '--menu-blob-upper', '--menu-blob-lower'];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!toggle || !overlay || !seal || !closedOutline) return;

    let open = false;
    let openFrame = 0;
    let closeTimer = 0;
    const listeners = new AbortController();
    const media = gsap.matchMedia();
    const setSealOutline = (outline: string) => {
      sealShapes.forEach((shape) => shape.setAttribute('d', outline));
    };
    let animateSeal: (outline: string) => void = setSealOutline;

    const closeOutline = () => {
      const { width, height } = seal.getBoundingClientRect();
      const radius = height / 2 - 3;
      const rx = radius * 184 / width;
      const ry = radius * 64 / height;
      const cx = 184 - height / 2 * 184 / width;
      const point = (x: number, y: number) => `${(cx + x * rx).toFixed(3)} ${(32 + y * ry).toFixed(3)}`;
      const step = Math.PI / 3;
      const handle = 4 / 3 * Math.tan(step / 4);
      let angle = -2 * Math.PI / 3;
      let outline = `M${point(Math.cos(angle), Math.sin(angle))}`;
      // Match the original seal's six cubic segments for a continuous, reversible morph.
      for (let index = 0; index < 6; index += 1) {
        const next = angle + step;
        outline += `C${point(Math.cos(angle) - handle * Math.sin(angle), Math.sin(angle) + handle * Math.cos(angle))} ${point(Math.cos(next) + handle * Math.sin(next), Math.sin(next) - handle * Math.cos(next))} ${point(Math.cos(next), Math.sin(next))}`;
        angle = next;
      }
      return `${outline}Z`;
    };

    media.add('(prefers-reduced-motion: no-preference)', (context) => {
      animateSeal = (outline) => context.add(() => {
        gsap.to(sealShapes, {
          attr: { d: outline },
          duration: 0.54,
          ease: 'power3.out',
          overwrite: true,
        });
      });
      return () => {
        animateSeal = setSealOutline;
        setSealOutline(open ? closeOutline() : closedOutline);
      };
    });

    const resize = new ResizeObserver(() => {
      if (open) animateSeal(closeOutline());
    });
    resize.observe(seal);

    const setOpen = (next: boolean) => {
      cancelAnimationFrame(openFrame);
      clearTimeout(closeTimer);
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Close menu' : 'The Menu, open navigation');
      animateSeal(next ? closeOutline() : closedOutline);
      document.body.classList.toggle('funmenu-open', next);
      if (next) {
        overlay.hidden = false;
        overlay.inert = false;
        links[0]?.focus({ preventScroll: true });
        openFrame = requestAnimationFrame(() => overlay.classList.add('is-open'));
      } else {
        toggle.focus({ preventScroll: true });
        overlay.inert = true;
        overlay.classList.remove('is-open');
        paletteProperties.forEach((property) => overlay.style.removeProperty(property));
        closeTimer = window.setTimeout(() => {
          if (!open) overlay.hidden = true;
        }, prefersReduced.matches ? 0 : 720);
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) setOpen(false);
    }, { signal: listeners.signal });

    // Keep both decorative shapes distinct as the drawer changes colour.
    links.forEach((link) => {
      const apply = () => paletteProperties.forEach((property) => {
        overlay.style.setProperty(property, link.style.getPropertyValue(property));
      });
      link.addEventListener('mouseenter', apply);
      link.addEventListener('focus', apply);
      link.addEventListener('click', () => setOpen(false));
    });

    // Reactive cursor follower + blob parallax inside the overlay.
    if (!prefersReduced.matches) {
      overlay.addEventListener('pointermove', (event) => {
        if (prefersReduced.matches) return;
        if (cursor) {
          cursor.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
        }
        const cx = (event.clientX / window.innerWidth - 0.5) * 2;
        const cy = (event.clientY / window.innerHeight - 0.5) * 2;
        blobs.forEach((blob) => {
          const depth = Number(blob.dataset.parallax || 0);
          blob.style.transform = `translate3d(${cx * depth}px, ${cy * depth}px, 0)`;
        });
      });
    }

    // Hide the bar on scroll down, reveal on scroll up.
    let lastScroll = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        if (open || !bar) return;
        const current = window.scrollY;
        if (current > lastScroll && current > 120) {
          bar.classList.add('is-hidden');
        } else {
          bar.classList.remove('is-hidden');
        }
        lastScroll = current;
      },
      { passive: true, signal: listeners.signal }
    );

    document.addEventListener('astro:before-swap', () => {
      listeners.abort();
      resize.disconnect();
      media.revert();
      cancelAnimationFrame(openFrame);
      clearTimeout(closeTimer);
      document.body.classList.remove('funmenu-open');
    }, { once: true });
  }

  initFunMenu();
  document.addEventListener('astro:page-load', initFunMenu);
</script>
