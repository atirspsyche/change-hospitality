---
import { Pause, Play } from '@lucide/astro';
import { getClientLogos } from '../sanity/queries';
const clients = (await getClientLogos()).filter((client) => client.marquee && client.logo);

const divisions = [
  {
    name: "Front of House",
    index: "01",
    tone: "var(--color-mint)",
    description:
      "Guest-facing people with the judgement, pace and personality to make every service feel considered.",
    roles: [
      "General managers",
      "Reception",
      "Food & beverage",
      "Waiters",
      "Banqueting Staff",
      "Hosts",
    ],
    images: [
      "/recruit-talent-images/foh.png",
      "/recruit-talent-images/foh2.png",
    ],
  },
  {
    name: "Back of House",
    index: "02",
    tone: "var(--color-blush)",
    description:
      "Kitchen staff at every level, from casual covers to inspiring leaders who shape the change.",
    roles: [
      "Executive chefs",
      "Sous chefs",
      "Head Chef",
      "Chef De Partie",
      "Pastry Chef",
      "Kitchen Porter",
    ],
    images: [
      "/recruit-talent-images/boh.png",
      "/recruit-talent-images/boh2.png",
    ],
  },
  {
    name: "Events & Commercial",
    index: "03",
    tone: "var(--color-citron)",
    description:
      "The people behind big moves : operational, commercial and support specialists who keep your business moving.",
    roles: [
      "Senior executives",
      "Sales & marketing",
      "Events",
      "HR",
      "Finance & Administration",
    ],
    images: [
      "/recruit-talent-images/event1.png",
      "/recruit-talent-images/event2.png",
    ],
  },
];
---

<section
  id="divisions"
  class="division-flow"
  aria-labelledby="division-flow-title"
  data-division-flow
>
  <div class="division-flow-heading">
    <div class="division-client-intro">
      <h2 id="division-flow-title">You're in good company.</h2>
      <p>From neighbourhood favourites to iconic destinations, we help these teams find their people.</p>
    </div>
    <button
      class="division-client-pause"
      type="button"
      aria-label="Pause client logos"
      aria-pressed="false"
      title="Pause client logos"
      data-logo-pause
      hidden={!clients.length}
    >
      <Pause class="division-client-pause-icon" size={18} aria-hidden="true" />
      <Play class="division-client-play-icon" size={18} aria-hidden="true" />
    </button>
  </div>

  <div
    class="division-client-marquee"
    role="img"
    aria-label={`Our clients: ${clients.map((client) => client.name).join(', ')}`}
    hidden={!clients.length}
    tabindex="0"
    data-client-marquee
    data-paused="false"
    data-in-view="false"
  >
    <div class="division-client-track">
      {[0, 1].map(() => (
        <div class="division-client-group" aria-hidden="true">
          {clients.map((client) => (
            <div class="division-client-logo">
              <img src={client.logo!.src} alt="" width={client.logo!.width} height={client.logo!.height} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="division-flow-list">
    {
      divisions.map((division, index) => (
        <article
          class="division-flow-item"
          style={`--item-tone:${division.tone};--item-index:${index}`}
          data-division-item
          data-expanded="false"
        >
          <button
            class="division-flow-trigger"
            type="button"
            aria-expanded="false"
            aria-controls={`division-panel-${index}`}
            data-division-trigger
          >
            <span class="division-flow-index">{division.index}</span>
            <span class="division-flow-name">{division.name}</span>
            <span class="division-flow-action" aria-hidden="true">
              +
            </span>
            <span class="division-flow-marquee" aria-hidden="true">
              <span class="division-flow-track">
                {[0, 1].map(() => (
                  <span class="division-flow-track-group">
                    <span>{division.name}</span>
                    <img
                      src={division.images[0]}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{division.name}</span>
                    <img
                      src={division.images[1]}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ))}
              </span>
            </span>
          </button>

          <div
            id={`division-panel-${index}`}
            class="division-flow-panel"
            role="region"
            aria-label={`${division.name} recruitment details`}
            aria-hidden="true"
          >
            <div class="division-flow-panel-inner">
              <p>{division.description}</p>
              <ul aria-label={`${division.name} example roles`}>
                {division.roles.map((role) => (
                  <li>{role}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .division-flow {
    overflow: hidden;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 3.5rem 0 0;
  }

  .division-flow-heading {
    display: flex;
    width: min(100% - 2.5rem, 80rem);
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  .division-client-intro {
    min-width: 0;
    max-width: 48rem;
  }

  .division-flow-heading h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }

  .division-client-intro p {
    max-width: 40rem;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-ink) 75%, var(--color-paper));
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .division-client-pause {
    display: grid;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .division-client-pause:hover {
    background: color-mix(in srgb, var(--color-ink) 6%, var(--color-paper));
  }

  .division-client-pause:focus-visible,
  .division-client-marquee:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }

  .division-client-pause :global(.division-client-play-icon),
  .division-client-pause[aria-pressed="true"] :global(.division-client-pause-icon) {
    display: none;
  }

  .division-client-pause[aria-pressed="true"] :global(.division-client-play-icon) {
    display: block;
  }

  .division-client-marquee {
    width: 100%;
    overflow: hidden;
    margin-bottom: 3rem;
    background: var(--color-paper);
    padding-block: 0.75rem;
    mask-image: linear-gradient(to right, transparent, black 2.5rem, black calc(100% - 2.5rem), transparent);
  }

  .division-client-track {
    display: flex;
    width: max-content;
    animation: client-logo-scroll 252s linear infinite;
    animation-play-state: paused;
  }

  .division-client-marquee[data-in-view="true"] .division-client-track {
    animation-play-state: running;
  }

  .division-client-group {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
  }

  .division-client-logo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    flex: none;
    width: 10rem;
    height: 8rem;
    place-items: center;
  }

  .division-client-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .division-client-logo:nth-child(4) img,
  .division-client-logo:nth-child(22) img {
    filter: brightness(0);
  }

  .division-client-marquee:hover .division-client-track,
  .division-client-marquee:focus-within .division-client-track,
  .division-client-marquee[data-paused="true"] .division-client-track {
    animation-play-state: paused;
  }

  @keyframes client-logo-scroll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .division-flow-list {
    border-top: 1px solid
      color-mix(in srgb, var(--color-cream) 45%, transparent);
  }

  .division-flow-item {
    background: var(--item-tone);
    color: var(--color-ink);
    opacity: 0;
    translate: 0 1.5rem;
    transition:
      opacity 500ms ease,
      translate 650ms var(--ease-cartoon);
    transition-delay: calc(var(--item-index) * 80ms);
  }

  .division-flow-item:not(:last-child) {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ink) 24%, transparent);
  }

  .division-flow.is-visible .division-flow-item {
    opacity: 1;
    translate: 0 0;
  }

  .division-flow-trigger {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 7rem;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: inherit;
    padding: 1rem 1.25rem;
    text-align: left;
    cursor: pointer;
  }

  .division-flow-trigger:focus-visible {
    z-index: 3;
    outline-color: var(--color-ink);
    outline-offset: -0.45rem;
  }

  .division-flow-index {
    font-size: 0.75rem;
    font-weight: 900;
  }

  .division-flow-name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    /* font-weight: 650; */
    line-height: 0.9;
    transition: opacity 180ms ease;
  }

  .division-flow-action {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-cream) 72%, transparent);
    font-size: 1.7rem;
    line-height: 1;
    transition:
      transform 350ms var(--ease-cartoon),
      background-color 220ms ease,
      color 220ms ease;
  }

  .division-flow-marquee {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-cream);
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 450ms var(--ease-luxury),
      opacity 200ms ease;
  }

  .division-flow-track {
    display: flex;
    width: max-content;
    animation: division-marquee 16s linear infinite;
    animation-play-state: paused;
  }

  .division-flow-track-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1.3rem;
    padding-right: 1.3rem;
  }

  .division-flow-track-group > span {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }

  .division-flow-track-group img {
    flex: 0 0 auto;
    width: clamp(7rem, 11vw, 10rem);
    height: clamp(3.5rem, 6vw, 5.5rem);
    border-radius: 999px;
    object-fit: cover;
  }

  .division-flow-item[data-expanded="true"] .division-flow-marquee {
    opacity: 1;
    transform: translateY(0);
  }

  .division-flow-item[data-expanded="true"] .division-flow-track {
    animation-play-state: running;
  }

  .division-flow-item[data-expanded="true"] .division-flow-name {
    opacity: 0;
  }

  .division-flow-item[data-expanded="true"] .division-flow-action {
    background: var(--color-cream);
    color: var(--color-ink);
    transform: rotate(45deg);
  }

  .division-flow-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms var(--ease-luxury);
  }

  .division-flow-panel-inner {
    display: grid;
    width: min(100% - 2.5rem, 77.5rem);
    min-height: 0;
    margin: 0 auto;
    gap: 1.5rem;
    overflow: hidden;
  }

  .division-flow-item[data-expanded="true"] .division-flow-panel {
    grid-template-rows: 1fr;
  }

  .division-flow-item[data-expanded="true"] .division-flow-panel-inner {
    padding-block: 2rem 2.5rem;
  }

  .division-flow-panel-inner > p {
    max-width: 42rem;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.55;
  }

  .division-flow-panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .division-flow-panel li {
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cream) 86%, transparent);
    padding: 0.6rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  @keyframes division-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 640px) {
    .division-flow-heading {
      width: min(100% - 5rem, 80rem);
    }

    .division-flow-heading h2 {
      font-size: 3rem;
    }

    .division-flow-trigger {
      min-height: 8.5rem;
      grid-template-columns: 4rem minmax(0, 1fr) 3rem;
      gap: 1.5rem;
      padding-inline: max(2.5rem, calc((100vw - 80rem) / 2));
    }

    .division-flow-name {
      font-size: 4rem;
    }

    .division-flow-panel-inner {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: start;
    }

    .division-flow-track-group > span {
      font-size: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .division-flow {
      padding-top: 5rem;
    }

    .division-flow-trigger {
      min-height: 10rem;
    }

    .division-flow-name {
      font-size: 5.5rem;
    }

    .division-flow-panel-inner > p {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .division-client-pause {
      display: none;
    }

    .division-client-marquee {
      overflow-x: auto;
    }

    .division-client-track {
      animation: none;
    }

    .division-client-group + .division-client-group {
      display: none;
    }

    .division-flow-item,
    .division-flow-marquee,
    .division-flow-action,
    .division-flow-panel {
      transition: none;
    }

    .division-flow-track {
      animation: none;
    }
  }
</style>

<script>
  function initDivisionFlow() {
    const section = document.querySelector<HTMLElement>("[data-division-flow]");
    if (!section || section.dataset.ready === "true") return;
    section.dataset.ready = "true";

    const marquee = section.querySelector<HTMLElement>("[data-client-marquee]");
    const pauseButton = section.querySelector<HTMLButtonElement>("[data-logo-pause]");
    pauseButton?.addEventListener("click", () => {
      if (!marquee) return;
      const paused = marquee.dataset.paused !== "true";
      const label = paused ? "Resume client logos" : "Pause client logos";
      marquee.dataset.paused = String(paused);
      pauseButton.setAttribute("aria-pressed", String(paused));
      pauseButton.setAttribute("aria-label", label);
      pauseButton.title = label;
    });

    if (marquee) {
      const marqueeObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry) marquee.dataset.inView = String(entry.isIntersecting);
        },
        { threshold: 0 },
      );
      marqueeObserver.observe(marquee);
      document.addEventListener(
        "astro:before-swap",
        () => marqueeObserver.disconnect(),
        { once: true },
      );
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        section.classList.add("is-visible");
        observer.disconnect();
      },
      { threshold: 0.12 },
    );
    observer.observe(section);

    const items = Array.from(
      section.querySelectorAll<HTMLElement>("[data-division-item]"),
    );

    const setExpanded = (item: HTMLElement, expanded: boolean) => {
      const trigger = item.querySelector<HTMLButtonElement>(
        "[data-division-trigger]",
      );
      const panelId = trigger?.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      item.dataset.expanded = String(expanded);
      trigger?.setAttribute("aria-expanded", String(expanded));
      panel?.setAttribute("aria-hidden", String(!expanded));
    };

    const closeOthers = (activeItem: HTMLElement) => {
      items.forEach((item) => {
        if (item !== activeItem) setExpanded(item, false);
      });
    };

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(
        "[data-division-trigger]",
      );
      if (!trigger) return;

      trigger.addEventListener("click", (event) => {
        const openedByMouseHover =
          event.detail > 0 &&
          item.matches(":hover") &&
          item.dataset.expanded === "true";
        const shouldExpand =
          openedByMouseHover || item.dataset.expanded !== "true";
        closeOthers(item);
        setExpanded(item, shouldExpand);
      });

      item.addEventListener("focusout", (event) => {
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && item.contains(nextTarget)) return;
        if (!item.matches(":hover")) setExpanded(item, false);
      });

      item.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse") return;
        closeOthers(item);
        setExpanded(item, true);
      });
      item.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "mouse") return;
        if (!item.contains(document.activeElement)) setExpanded(item, false);
      });
    });
  }

  initDivisionFlow();
  document.addEventListener("astro:page-load", initDivisionFlow);
</script>
