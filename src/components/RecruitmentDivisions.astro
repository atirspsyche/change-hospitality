---
import { Pause, Play } from '@lucide/astro';
import { getClientLogos } from '../sanity/queries';
const clients = (await getClientLogos()).filter((client) => client.marquee && client.logo);

const divisions = [
  {
    name: "Front of House",
    index: "01",
    tone: "var(--color-mint)",
    description:
      "Guest-facing people with the judgement, pace and personality to make every service feel considered.",
    roles: [
      "Operations Managers & Directors",
      "General managers",
      "Reception",
      "Food & beverage",
      "Waiters & Bar Staff",
      "Bar Management",
      "Banqueting Staff",
      "Hosts",
    ],
    image: "/recruit-talent-images/foh.png",
  },
  {
    name: "Back of House",
    index: "02",
    tone: "var(--color-blush)",
    description:
      "Kitchen staff at every level, from casual covers to inspiring leaders who shape the change.",
    roles: [
      "Executive chefs",
      "Head Chef",
      "Sous chefs",
      "Pastry Chef",
      "Chef De Partie",
      "Kitchen Porter",
    ],
    image: "/recruit-talent-images/boh2.png",
  },
  {
    name: "Events & Commercial",
    index: "03",
    tone: "var(--color-citron)",
    description:
      "The people behind big moves : operational, commercial and support specialists who keep your business moving.",
    roles: [
      "Senior executive",
      "Sales & marketing",
      "Events",
      "HR",
      "Finance & Administration",
    ],
    image: "/recruit-talent-images/event2.png",
  },
];
---

<section
  id="divisions"
  class="division-flow"
  aria-labelledby="division-flow-title"
  data-division-flow
>
  <div class="division-flow-heading">
    <div class="division-client-intro">
      <h2 id="division-flow-title">You're in good company.</h2>
      <p>From neighbourhood favourites to iconic destinations, we help these teams find their people.</p>
    </div>
    <button
      class="division-client-pause"
      type="button"
      aria-label="Pause client logos"
      aria-pressed="false"
      title="Pause client logos"
      data-logo-pause
      hidden={!clients.length}
    >
      <Pause class="division-client-pause-icon" size={18} aria-hidden="true" />
      <Play class="division-client-play-icon" size={18} aria-hidden="true" />
    </button>
  </div>

  <div
    class="division-client-marquee"
    role="img"
    aria-label={`Our clients: ${clients.map((client) => client.name).join(', ')}`}
    hidden={!clients.length}
    tabindex="0"
    data-client-marquee
    data-paused="false"
    data-in-view="false"
  >
    <div class="division-client-track">
      {[0, 1].map(() => (
        <div class="division-client-group" aria-hidden="true">
          {clients.map((client) => (
            <div class="division-client-logo">
              <img src={client.logo!.src} alt="" width={client.logo!.width} height={client.logo!.height} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="division-flow-list">
    {
      divisions.map((division, index) => (
        <article
          class="division-flow-item"
          style={`--item-tone:${division.tone};--item-index:${index}`}
          data-division-item
          data-expanded="false"
        >
          <h3 class="division-flow-title">
            <button
              class="division-flow-trigger"
              type="button"
              aria-expanded="false"
              aria-controls={`division-panel-${index}`}
              data-division-trigger
            >
              <span class="division-flow-index" aria-hidden="true">{division.index}</span>
              <img
                class="division-flow-image"
                src={division.image}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="division-flow-name">{division.name}</span>
              <span class="division-flow-action" aria-hidden="true">
                +
              </span>
            </button>
          </h3>

          <div
            id={`division-panel-${index}`}
            class="division-flow-panel"
            role="region"
            aria-label={`${division.name} recruitment details`}
            aria-hidden="true"
          >
            <div class="division-flow-panel-inner">
              <div class="division-flow-copy">
                <p>{division.description}</p>
                <ul aria-label={`${division.name} example roles`}>
                  {division.roles.map((role) => (
                    <li>{role}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .division-flow {
    overflow: hidden;
    background: var(--color-cream);
    color: var(--color-ink);
    padding: 3.5rem 0 0;
  }

  .division-flow-heading {
    display: flex;
    width: min(100% - 2.5rem, 80rem);
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  .division-client-intro {
    min-width: 0;
    max-width: 48rem;
  }

  .division-flow-heading h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }

  .division-client-intro p {
    max-width: 40rem;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-ink) 75%, var(--color-paper));
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .division-client-pause {
    display: grid;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .division-client-pause:hover {
    background: color-mix(in srgb, var(--color-ink) 6%, var(--color-paper));
  }

  .division-client-pause:focus-visible,
  .division-client-marquee:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }

  .division-client-pause :global(.division-client-play-icon),
  .division-client-pause[aria-pressed="true"] :global(.division-client-pause-icon) {
    display: none;
  }

  .division-client-pause[aria-pressed="true"] :global(.division-client-play-icon) {
    display: block;
  }

  .division-client-marquee {
    width: 100%;
    overflow: hidden;
    margin-bottom: 3rem;
    background: var(--color-cream);
    padding-block: 0.75rem;
    mask-image: linear-gradient(to right, transparent, black 2.5rem, black calc(100% - 2.5rem), transparent);
  }

  .division-client-track {
    display: flex;
    width: max-content;
    animation: client-logo-scroll 210s linear infinite;
    animation-play-state: paused;
  }

  .division-client-marquee[data-in-view="true"] .division-client-track {
    animation-play-state: running;
  }

  .division-client-group {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
  }

  .division-client-logo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    flex: none;
    width: 10rem;
    height: 8rem;
    place-items: center;
  }

  .division-client-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .division-client-logo:nth-child(4) img,
  .division-client-logo:nth-child(22) img {
    filter: brightness(0);
  }

  .division-client-marquee:hover .division-client-track,
  .division-client-marquee:focus-within .division-client-track,
  .division-client-marquee[data-paused="true"] .division-client-track {
    animation-play-state: paused;
  }

  @keyframes client-logo-scroll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .division-flow-list {
    border-top: 1px solid
      color-mix(in srgb, var(--color-cream) 45%, transparent);
  }

  .division-flow-item {
    background: var(--item-tone);
    color: var(--color-ink);
    opacity: 0;
    translate: 0 1.5rem;
    transition:
      opacity 500ms ease,
      translate 650ms var(--ease-cartoon);
    transition-delay: calc(var(--item-index) * 80ms);
  }

  .division-flow-item:not(:last-child) {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ink) 24%, transparent);
  }

  .division-flow.is-visible .division-flow-item {
    opacity: 1;
    translate: 0 0;
  }

  .division-flow-title {
    margin: 0;
    background-color: var(--item-tone);
    color: var(--color-ink);
    transition:
      background-color 500ms var(--ease-luxury),
      color 500ms var(--ease-luxury);
  }

  .division-flow-trigger,
  .division-flow-panel-inner {
    display: grid;
    width: min(100% - 2.5rem, 80rem);
    grid-template-columns: clamp(2.5rem, 8vw, 4rem) minmax(0, 1fr) 2rem;
    column-gap: 0.5rem;
    margin: 0 auto;
  }

  .division-flow-trigger {
    position: relative;
    min-height: 7rem;
    align-items: center;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: inherit;
    padding: 1.5rem 0;
    text-align: left;
    cursor: pointer;
  }

  .division-flow-trigger:focus-visible {
    z-index: 3;
    outline-color: currentColor;
    outline-offset: -0.45rem;
  }

  .division-flow-index {
    position: absolute;
    top: 0.5rem;
    left: 0;
    font-size: 0.65rem;
    font-weight: 900;
  }

  .division-flow-name {
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 4.6vw, 2.2rem);
    font-weight: 500;
    line-height: 1.05;
    text-wrap: balance;
  }

  .division-flow-image {
    width: 100%;
    height: clamp(3.5rem, 9vw, 4.5rem);
    border-radius: 999px;
    object-fit: cover;
  }

  .division-flow-action {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-cream) 72%, transparent);
    font-size: 1.5rem;
    line-height: 1;
    transition:
      transform 350ms var(--ease-cartoon),
      background-color 500ms var(--ease-luxury),
      color 500ms var(--ease-luxury);
  }

  .division-flow-item[data-expanded="true"] .division-flow-title {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }

  .division-flow-item[data-expanded="true"] .division-flow-action {
    background: var(--color-cream);
    color: var(--color-ink);
    transform: rotate(45deg);
  }

  .division-flow-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms var(--ease-luxury);
  }

  .division-flow-panel-inner {
    min-height: 0;
    overflow: hidden;
    padding-block: 0;
    transition: padding-block 500ms var(--ease-luxury);
  }

  .division-flow-copy {
    display: grid;
    grid-column: 2 / -1;
    min-width: 0;
    gap: 1.75rem;
  }

  .division-flow-item[data-expanded="true"] .division-flow-panel {
    grid-template-rows: 1fr;
  }

  .division-flow-item[data-expanded="true"] .division-flow-panel-inner {
    padding-block: 2.5rem 3rem;
  }

  .division-flow-copy > p {
    max-width: 46rem;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .division-flow-panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .division-flow-panel li {
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cream) 86%, transparent);
    padding: 0.6rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .division-flow-heading {
      width: min(100% - 5rem, 80rem);
    }

    .division-flow-heading h2 {
      font-size: 3rem;
    }

    .division-flow-trigger,
    .division-flow-panel-inner {
      width: min(100% - 5rem, 80rem);
      grid-template-columns:
        2.5rem clamp(4rem, 10vw, 10rem) minmax(0, 1fr) 2.5rem;
      column-gap: 1rem;
    }

    .division-flow-trigger {
      min-height: 8.5rem;
      padding-block: 1.75rem;
    }

    .division-flow-index {
      position: static;
      font-size: 0.75rem;
    }

    .division-flow-name {
      font-size: clamp(2.2rem, 4.5vw, 4.5rem);
    }

    .division-flow-image {
      height: clamp(4rem, 7vw, 6rem);
    }

    .division-flow-action {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.7rem;
    }

    .division-flow-copy {
      grid-column: 3 / -1;
    }

    .division-flow-copy > p {
      font-size: 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .division-flow {
      padding-top: 5rem;
    }

    .division-flow-trigger {
      min-height: 10rem;
    }

    .division-flow-trigger,
    .division-flow-panel-inner {
      column-gap: 1.5rem;
    }

    .division-flow-copy {
      grid-template-columns: 1.25fr 0.75fr;
      align-items: start;
      gap: 2rem;
    }

    .division-flow-copy > p {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .division-client-pause {
      display: none;
    }

    .division-client-marquee {
      overflow-x: auto;
    }

    .division-client-track {
      animation: none;
    }

    .division-client-group + .division-client-group {
      display: none;
    }

    .division-flow-item,
    .division-flow-title,
    .division-flow-action,
    .division-flow-panel,
    .division-flow-panel-inner {
      transition: none;
    }
  }
</style>

<script>
  function initDivisionFlow() {
    const section = document.querySelector<HTMLElement>("[data-division-flow]");
    if (!section || section.dataset.ready === "true") return;
    section.dataset.ready = "true";

    const marquee = section.querySelector<HTMLElement>("[data-client-marquee]");
    const pauseButton = section.querySelector<HTMLButtonElement>("[data-logo-pause]");
    pauseButton?.addEventListener("click", () => {
      if (!marquee) return;
      const paused = marquee.dataset.paused !== "true";
      const label = paused ? "Resume client logos" : "Pause client logos";
      marquee.dataset.paused = String(paused);
      pauseButton.setAttribute("aria-pressed", String(paused));
      pauseButton.setAttribute("aria-label", label);
      pauseButton.title = label;
    });

    if (marquee) {
      const marqueeObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry) marquee.dataset.inView = String(entry.isIntersecting);
        },
        { threshold: 0 },
      );
      marqueeObserver.observe(marquee);
      document.addEventListener(
        "astro:before-swap",
        () => marqueeObserver.disconnect(),
        { once: true },
      );
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        section.classList.add("is-visible");
        observer.disconnect();
      },
      { threshold: 0.12 },
    );
    observer.observe(section);

    const items = Array.from(
      section.querySelectorAll<HTMLElement>("[data-division-item]"),
    );

    const setExpanded = (item: HTMLElement, expanded: boolean) => {
      const trigger = item.querySelector<HTMLButtonElement>(
        "[data-division-trigger]",
      );
      const panelId = trigger?.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      item.dataset.expanded = String(expanded);
      trigger?.setAttribute("aria-expanded", String(expanded));
      panel?.setAttribute("aria-hidden", String(!expanded));
    };

    const closeOthers = (activeItem: HTMLElement) => {
      items.forEach((item) => {
        if (item !== activeItem) setExpanded(item, false);
      });
    };

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(
        "[data-division-trigger]",
      );
      if (!trigger) return;

      trigger.addEventListener("click", () => {
        const shouldExpand = item.dataset.expanded !== "true";
        closeOthers(item);
        setExpanded(item, shouldExpand);
      });
    });
  }

  initDivisionFlow();
  document.addEventListener("astro:page-load", initDivisionFlow);
</script>
