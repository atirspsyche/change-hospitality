---
import { getCandidateGallery } from '../sanity/queries';

const galleryItems = await getCandidateGallery();
---

<section
  id="gallery"
  class="storyboard-gallery relative overflow-hidden bg-cocoa"
  aria-labelledby="gallery-title"
  data-storyboard-gallery
>
  <div class="storyboard-gallery-stage" data-gallery-stage>
    <div class="storyboard-gallery-copy">
      <header>
        <p class="mb-4 text-sm font-black uppercase tracking-wide text-citron">
          People behind great hospitality
        </p>
        <h2
          id="gallery-title"
          class="font-serif font-semibold leading-none text-cream"
        >
          Where your next shift could take you
        </h2>
      </header>
      <p class="storyboard-gallery-intro">
        Iconic London venues, stadiums, theatres, festivals and private dining
        rooms: a few frames of our people behind some of the best service in
        the country.
      </p>
      <div class="storyboard-gallery-closing" data-gallery-closing>
        <p class="storyboard-gallery-closing-title">A new job is just the beginning.</p>
        <p>For over 20 years, we've brought people together, face to face. The best part? Seeing where they go next.</p>
      </div>
      <div class="storyboard-gallery-scroll" aria-hidden="true">
        <p>Scroll to collect the moments <span>&darr;</span></p>
        <div class="storyboard-gallery-track"><span data-gallery-progress></span></div>
      </div>
    </div>
    <div class="storyboard-gallery-pictures">
      <div class="storyboard-gallery-oval" aria-hidden="true"></div>
      <ol class="storyboard-gallery-photos" aria-label="Change Hospitality candidates at work and with their teams">
        {galleryItems.map(({ key, image, alt }) => {
          const attributes = {
            src: image.src,
            srcset: image.srcSet,
            sizes: '(min-width: 1280px) 640px, (min-width: 1024px) 50vw, (min-width: 600px) calc((100vw - 6.5rem) / 2), calc(100vw - 2.5rem)',
            alt,
            width: image.width,
            height: image.height,
            loading: 'lazy' as const,
            decoding: 'async' as const,
            fetchpriority: 'low' as const,
          };
          return (
            <li class="storyboard-gallery-photo" data-gallery-photo={key}>
              <template data-gallery-image><img {...attributes} /></template>
              <noscript><img {...attributes} /></noscript>
              <p class="storyboard-gallery-error" data-gallery-error role="status" hidden>
                This photo could not be loaded. Please try again later.
              </p>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .storyboard-gallery {
    color: var(--color-cream);
  }

  .storyboard-gallery-stage {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 80rem);
    gap: 3rem;
    margin-inline: auto;
    padding: 4.5rem 1.25rem 5.5rem;
  }

  .storyboard-gallery-copy {
    min-width: 0;
  }

  .storyboard-gallery h2 {
    max-width: 11ch;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    text-wrap: balance;
  }

  .storyboard-gallery-intro {
    max-width: 34rem;
    margin-top: 1.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.8;
  }

  .storyboard-gallery-closing {
    max-width: 30rem;
    margin-top: 2rem;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .storyboard-gallery-closing-title {
    margin-bottom: 0.5rem;
    color: var(--color-citron);
    font-weight: 700;
  }

  .storyboard-gallery-pictures {
    position: relative;
    isolation: isolate;
    min-width: 0;
  }

  .storyboard-gallery-photos {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .storyboard-gallery-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 0.65rem;
    background: var(--color-cocoa);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--color-obsidian) 18%, transparent);
  }

  .storyboard-gallery-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .storyboard-gallery-error {
    position: absolute;
    inset: auto 1rem 1rem;
    padding: 0.75rem;
    background: var(--color-cocoa);
    font-size: 0.875rem;
  }

  .storyboard-gallery-scroll {
    display: none;
  }

  .storyboard-gallery-oval {
    position: absolute;
    z-index: -1;
    top: 20%;
    right: -12rem;
    height: 28rem;
    width: 46rem;
    border-radius: 999px;
    background: var(--color-flame);
    pointer-events: none;
    transform: rotate(-10deg);
  }

  .is-stacked .storyboard-gallery-stage {
    height: 100svh;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(3rem, 5vw, 5rem);
    padding-block: 3rem;
  }

  .is-stacked .storyboard-gallery-photos {
    position: relative;
    display: block;
    width: 94%;
    aspect-ratio: 4 / 3;
    max-height: 62svh;
    margin-inline: auto;
  }

  .is-stacked .storyboard-gallery-photo {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    will-change: transform, opacity;
  }

  .is-stacked .storyboard-gallery-scroll {
    display: block;
    max-width: 17rem;
    margin-top: 2rem;
  }

  .storyboard-gallery-scroll p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .storyboard-gallery-track {
    height: 2px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-cream) 25%, transparent);
  }

  .storyboard-gallery-track span {
    display: block;
    height: 100%;
    background: var(--color-citron);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (min-width: 600px) {
    .storyboard-gallery-stage {
      padding-inline: 2.5rem;
    }

    .storyboard-gallery-photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media print {
    .storyboard-gallery-stage {
      padding-block: 2rem;
    }

    .storyboard-gallery-photo {
      break-inside: avoid;
      box-shadow: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let disposeGallery: (() => void) | undefined;

  function initStoryboardGallery() {
    disposeGallery?.();
    disposeGallery = undefined;
    const section = document.querySelector<HTMLElement>('[data-storyboard-gallery]');
    const stage = section?.querySelector<HTMLElement>('[data-gallery-stage]');
    const photos = Array.from(section?.querySelectorAll<HTMLElement>('[data-gallery-photo]') ?? []);
    const closing = section?.querySelector<HTMLElement>('[data-gallery-closing]');
    const progress = section?.querySelector<HTMLElement>('[data-gallery-progress]');
    if (!section || !stage || !photos.length || !closing || !progress) return;

    const controller = new AbortController();
    let imageObserver: IntersectionObserver | undefined;

    function loadPhoto(index: number) {
      const photo = photos[index];
      const template = photo?.querySelector<HTMLTemplateElement>('template[data-gallery-image]');
      const image = template?.content.querySelector('img')?.cloneNode(true);
      if (!template || !(image instanceof HTMLImageElement)) return;
      image.addEventListener('error', () => {
        console.error('Candidate gallery photo could not be loaded:', image.currentSrc || image.src);
        const message = photo.querySelector<HTMLElement>('[data-gallery-error]');
        if (message) message.hidden = false;
      }, { signal: controller.signal });
      // The observer/timeline already decides when to fetch; do not add a second lazy-load delay.
      image.loading = 'eager';
      template.replaceWith(image);
    }

    function observePhotos(stacked: boolean) {
      imageObserver?.disconnect();
      if (!('IntersectionObserver' in window)) {
        photos.forEach((_, index) => loadPhoto(index));
        return;
      }
      imageObserver = new IntersectionObserver((entries) => {
        entries.filter((entry) => entry.isIntersecting).forEach((entry) => {
          if (entry.target === section) {
            loadPhoto(0);
            loadPhoto(1);
          } else {
            loadPhoto(photos.indexOf(entry.target as HTMLElement));
          }
          imageObserver?.unobserve(entry.target);
        });
      }, { rootMargin: '200px 0px' });
      if (stacked) imageObserver.observe(section);
      else photos.forEach((photo) => imageObserver?.observe(photo));
    }

    window.addEventListener('beforeprint', () => photos.forEach((_, index) => loadPhoto(index)), { signal: controller.signal });

    const media = gsap.matchMedia();
    media.add({
      all: 'all',
      desktop: '(min-width: 1024px) and (min-height: 700px)',
      motion: '(prefers-reduced-motion: no-preference)',
      print: 'print',
    }, (context) => {
      const stacked = Boolean(context.conditions?.desktop && context.conditions.motion && !context.conditions.print && photos.length > 1);
      section.classList.toggle('is-stacked', stacked);
      observePhotos(stacked);
      if (!stacked) return () => imageObserver?.disconnect();

      gsap.set(photos, { opacity: 0, yPercent: 110, xPercent: 12, rotation: 10, scale: 1.04 });
      gsap.set(photos[0], { opacity: 1, yPercent: 0, xPercent: 0, rotation: -6, scale: 1 });
      gsap.set(closing, { opacity: 0, y: 18 });

      ScrollTrigger.create({
        trigger: section,
        start: 'top bottom',
        once: true,
        onEnter: () => context.add(() => {
          const photoStarts = photos.map((_, index) => index === 0 ? 0 : 0.3 + (index - 1) * 1.25);
          const timeline = gsap.timeline({
            onUpdate() {
              const active = photoStarts.findLastIndex((start) => timeline.time() >= start);
              loadPhoto(active);
              loadPhoto(active + 1);
            },
            scrollTrigger: {
              id: 'candidate-photo-stack',
              trigger: section,
              start: 'top top',
              end: () => `+=${window.innerHeight * (photos.length * 0.6 + 0.5)}`,
              pin: stage,
              scrub: 1.1,
              invalidateOnRefresh: true,
            },
          });

          photos.slice(1).forEach((photo, index) => {
            const at = photoStarts[index + 1];
            timeline.to(photos.slice(0, index + 1), {
              y: (photoIndex) => -(index + 1 - photoIndex) * 8,
              scale: (photoIndex) => 1 - (index + 1 - photoIndex) * 0.012,
              duration: 1,
              ease: 'power2.inOut',
            }, at);
            timeline.to(photo, {
              opacity: 1,
              yPercent: 0,
              xPercent: 0,
              rotation: [4, -4, 3, -2, 1][index % 5],
              scale: 1,
              duration: 1,
              ease: 'power3.inOut',
            }, at);
          });

          timeline.to(closing, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '+=0.25');
          timeline.to({}, { duration: 0.5 });
          timeline.to(progress, { scaleX: 1, duration: timeline.duration(), ease: 'none' }, 0);
          ScrollTrigger.refresh();
        }),
      });

      return () => {
        section.classList.remove('is-stacked');
        imageObserver?.disconnect();
      };
    }, section);

    disposeGallery = () => {
      media.revert();
      imageObserver?.disconnect();
      controller.abort();
    };
  }

  initStoryboardGallery();
  document.addEventListener('astro:page-load', initStoryboardGallery);
  document.addEventListener('astro:before-swap', () => {
    disposeGallery?.();
    disposeGallery = undefined;
  });
</script>