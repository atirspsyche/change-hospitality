    #site-footer-title br {
      display: none;
    }
    .footer-art {
      display: none;
    }
    .footer-actions {
      grid-row: 2;
      margin-top: 0;
    }
    .footer-actions :global([data-button-variant]) {
      --button-min-height: 2rem;
      --button-padding: 0.35rem 0.8rem;
