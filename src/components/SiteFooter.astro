  @media (prefers-reduced-motion: reduce) {
    .site-footer :global(a),
    .site-footer :global(svg),
    .footer-policies a::before {
      transition: none;
    }
    .footer-policies a::before {
      transform: none;
    }
    .footer-policies a:is(:hover, :focus-visible) .footer-policy-arrow,
    .footer-socials a:is(:hover, :focus-visible) > svg {
      transform: none;
    }
  }

  @media print {
    .footer-backdrop {
      display: none;
    }
  }
</style>

<script>
  let disposeFooter: (() => void) | undefined;

  function initSiteFooter() {
    disposeFooter?.();
    const footer = document.querySelector<HTMLElement>("[data-site-footer]");
    if (!footer) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        footer.setAttribute("data-footer-in-view", "");
        observer.disconnect();
      },
      { threshold: 0 },
    );
    observer.observe(footer);
    disposeFooter = () => observer.disconnect();
  }

  initSiteFooter();
  document.addEventListener("astro:page-load", initSiteFooter);
  document.addEventListener("astro:before-swap", () => {
    disposeFooter?.();
    disposeFooter = undefined;
  });
</script>
