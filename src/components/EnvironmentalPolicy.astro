---
import "@fontsource/courier-prime/latin-400.css";
import "@fontsource/courier-prime/latin-700.css";

const paragraphs = [
  "At Change Hospitality, we are deeply committed to reducing our environmental impact and integrating sustainability into every aspect of our operations. As a certified B Corporation, we are proud to meet high standards of social and environmental performance, accountability, and transparency, demonstrating our belief that business should be a force for good.",
  "We are also working toward ISO 14001:2015 certification – the internationally recognised standard for Environmental Management Systems. This will provide us with a structured framework to manage our environmental responsibilities, ensure legal compliance, and drive continuous improvement in our sustainability efforts.",
  "As a people-first recruitment agency, we connect exceptional talent with the UK’s leading hospitality and catering brands. But our mission goes beyond recruitment – we are here to build lasting, meaningful relationships that support our clients, empower our candidates, and positively impact the wider community. Our environmental commitment is a vital part of this mission.",
];
---

<section class="policy" aria-labelledby="policy-title" data-policy>
  <div class="policy-frame">
    <div class="policy-topline" aria-hidden="true">
      <span>People first. Planet too.</span>
      <span>A note on what matters.</span>
    </div>

    <div class="policy-intro">
      <p class="policy-kicker" data-intro-reveal>
        Good people. Positive change.
      </p>
      <h1 id="policy-title">
        <span class="policy-title-line"
          ><span data-title-word>Environmental</span></span
        >
        <span class="policy-title-line"
          ><span data-title-word>Policy</span></span
        >
      </h1>
      <p class="policy-intro-note" data-intro-reveal>
        A better future is everybody’s business.<br />Here’s our commitment to
        it.
      </p>
      <a class="policy-flow-scroll" href="#policy-letter"
        >Scroll down <span aria-hidden="true">↓</span></a
      >
    </div>

    <aside
      class="policy-seal"
      aria-label="Proud to be a certified B Corporation"
    >
      <span class="policy-seal-label">Proud to be</span>
      <img
        src="/bcorp-logo.webp"
        width="771"
        height="905"
        alt="Certified B Corporation"
        fetchpriority="high"
      />
      <span class="policy-seal-caption">Business as a<br />force for good.</span
      >
    </aside>

    <div class="policy-sprout" aria-hidden="true">
      <svg viewBox="0 0 240 260" fill="none">
        <path
          class="sprout-ground"
          d="M25 218c35-19 153-23 193 1-26 29-164 31-193-1Z"></path>
        <path
          class="sprout-leaf"
          d="M122 150C62 162 22 120 28 69c57-9 104 19 94 81Z"></path>
        <path
          class="sprout-leaf"
          d="M124 118c-12-58 29-101 89-99 5 55-24 98-89 99Z"></path>
        <path
          class="sprout-stem"
          d="M122 217c3-51 6-91 49-150M123 167c-5-26-25-49-56-67"></path>
        <path class="sprout-face" d="M151 66v9m25-19v9m-25 27c9 5 19 0 23-8"
        ></path>
        <path
          class="sprout-rays"
          d="m17 36 12 12M65 12l5 18M225 131l-18 1M221 162l-15-9"></path>
      </svg>
      <span>A little change.<br />A lasting difference.</span>
    </div>

    <article
      class="policy-letter"
      aria-labelledby="policy-letter-title"
      id="policy-letter"
      tabindex="-1"
    >
      <header class="policy-letter-header">
        <div>
          <p>From the desk of</p>
          <h2 id="policy-letter-title">Jim O’Brien</h2>
        </div>
        <span class="policy-letter-subject"
          >Our environmental<br />commitment</span
        >
      </header>
      <div class="policy-letter-window">
        <div class="policy-letter-body" data-letter-source>
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p class="policy-signature">
            <strong>Jim O’Brien</strong><br />CEO and Founder
          </p>
        </div>
      </div>
      <footer class="policy-letter-footer">
        <span>Change Hospitality</span>
        <span>People. Planet. Possibility.</span>
      </footer>
    </article>

    <div class="policy-bottomline">
      <a class="policy-scroll" href="#policy-letter" data-scroll-letter>
        <span class="policy-scroll-icon" aria-hidden="true">↓</span>
        <span
          ><span data-scroll-label>Scroll down</span><small data-scroll-note
            >A letter from our CEO</small
          ></span
        >
      </a>
      <div class="policy-progress" aria-hidden="true">
        <span data-progress-label>Our commitment, in our words</span>
        <span class="policy-progress-track"
          ><span data-progress-bar></span></span
        >
      </div>
      <button class="policy-read" type="button" data-read-letter hidden
        >Read full letter <span aria-hidden="true">↗</span></button
      >
      <a class="policy-home" href="/"
        >Back to home <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</section>

<style>
  .policy {
    --policy-type: "Courier Prime", "Courier New", monospace;
    background: var(--color-cream);
    color: var(--color-bcorp-green);
  }

  .policy-frame {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding: 7.5rem clamp(1.25rem, 4vw, 4rem) 2rem;
  }

  .policy-topline,
  .policy-bottomline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .policy-topline {
    border-top: 1.5px solid var(--color-bcorp-green);
    padding-top: 1rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .policy-intro {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60svh;
    padding: 3rem 0;
    text-align: center;
  }

  .policy-kicker {
    margin-bottom: 1.6rem;
    border: 1.5px solid currentColor;
    border-radius: 100%;
    background: var(--color-mint);
    padding: 0.75rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.85rem;
    transform: rotate(-3deg);
  }

  .policy h1 {
    font-family: var(--font-hero);
    font-size: clamp(2.2rem, 7.8vw, 9.5rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }

  .policy-title-line {
    display: block;
    overflow: clip;
    padding: 0.04em 0.1em;
  }
  .policy-title-line > span {
    display: block;
  }
  .policy-title-dot {
    color: var(--color-flame);
  }

  .policy-intro-note {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    line-height: 1.6;
  }

  .policy-flow-scroll {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
  }
  .policy-flow-scroll span {
    font-size: 1.4rem;
    font-family: var(--font-display);
  }

  .policy-seal {
    position: relative;
    z-index: 3;
    display: flex;
    width: 10rem;
    margin: 0 auto 3rem;
    padding: 1rem 1.25rem;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    border: 2px solid var(--color-bcorp-green);
    border-radius: 5rem 5rem 0.4rem 0.4rem;
    background: var(--color-mint);
    text-align: center;
    transform: rotate(7deg);
  }

  .policy-seal img {
    width: 5.1rem;
    height: auto;
    mix-blend-mode: multiply;
  }
  .policy-seal-label {
    font-size: 0.65rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .policy-seal-caption {
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.15;
  }

  .policy-sprout {
    display: none;
    position: absolute;
    left: 5%;
    bottom: 17%;
    width: clamp(8rem, 14vw, 14rem);
    transform: rotate(-9deg);
    text-align: center;
  }

  .policy-sprout svg {
    width: 100%;
    overflow: visible;
    stroke: var(--color-bcorp-green);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sprout-ground {
    fill: var(--color-blush);
  }
  .sprout-leaf {
    fill: var(--color-citron);
  }
  .sprout-stem {
    stroke-width: 5;
  }
  .policy-sprout span {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--policy-type);
    font-size: 0.85rem;
  }

  .policy-letter {
    position: relative;
    z-index: 2;
    scroll-margin-top: 6rem;
    width: min(100%, 51rem);
    margin: 0 auto 3rem;
    border: 1.5px solid var(--color-bcorp-green);
    background: var(--color-paper);
    padding: clamp(1.25rem, 3vw, 2.75rem);
  }

  .policy-letter::before {
    position: absolute;
    top: -0.8rem;
    left: 42%;
    width: 16%;
    height: 1.6rem;
    background: var(--color-blush);
    border: 1px solid var(--color-cocoa);
    transform: rotate(-4deg);
    content: "";
  }

  .policy-letter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .policy-letter-header p,
  .policy-letter-subject {
    font-family: var(--policy-type);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .policy-letter-header h2 {
    margin-top: 0.15rem;
    font-family: var(--font-hero);
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }
  .policy-letter-subject {
    text-align: right;
  }
  .policy-letter-body {
    font-family: var(--policy-type);
    font-size: clamp(1rem, 1.23vw, 1.15rem);
    line-height: 1.55;
    color: var(--color-ink);
  }
  .policy-letter-body p {
    margin: 0 0 1.25em;
  }
  .policy-letter-body p:last-child {
    margin-bottom: 0;
  }
  .policy-signature {
    color: var(--color-bcorp-green);
  }
  .policy-signature strong {
    font-weight: 700;
  }
  .policy-letter-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid currentColor;
    padding-top: 0.85rem;
    margin-top: 1.25rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .policy-bottomline {
    flex-wrap: wrap;
    border-top: 1.5px solid currentColor;
    padding-top: 1.1rem;
  }
  .policy-scroll {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .policy-scroll-icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 1.4rem;
  }
  .policy-scroll small {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--policy-type);
    font-size: 0.7rem;
    font-weight: 400;
  }
  .policy-read,
  .policy-home {
    padding: 0.7rem 0;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .policy-read {
    border: 0;
    background: none;
    cursor: pointer;
  }
  .policy-read span,
  .policy-home span {
    margin-left: 0.75rem;
  }
  .policy-progress {
    display: none;
    width: 13rem;
    text-align: center;
    font-family: var(--policy-type);
    font-size: 0.65rem;
  }
  .policy-progress-track {
    display: block;
    height: 3px;
    margin-top: 0.65rem;
    background: var(--color-mint);
  }
  .policy-progress-track > span {
    display: block;
    height: 100%;
    background: var(--color-bcorp-green);
    transform: scaleX(0);
    transform-origin: left;
  }
  .policy :focus-visible {
    outline: 2px solid var(--color-bcorp-green);
    outline-offset: 5px;
  }
  .policy :global(.policy-word) {
    display: inline-block;
    white-space: nowrap;
  }
  .policy :global(.policy-char) {
    visibility: hidden;
  }
  .policy :global(.policy-char.is-typed) {
    visibility: visible;
  }
  .policy :global(.policy-char.is-caret) {
    position: relative;
  }
  .policy :global(.policy-char.is-caret)::after {
    position: absolute;
    left: 100%;
    top: 0.1em;
    width: 2px;
    height: 1em;
    background: var(--color-bcorp-green);
    content: "";
  }
  .policy :global(.policy-accessible) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 1024px) and (min-height: 600px) {
    .policy-intro {
      min-height: 70svh;
    }
    .policy-seal {
      position: absolute;
      right: 5%;
      top: 56svh;
      width: 9rem;
    }
    .policy-sprout {
      display: block;
      top: 57svh;
      bottom: auto;
      width: 11vw;
    }
    .policy.is-enhanced {
      height: 580svh;
    }
    .is-enhanced .policy-frame {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
      overflow: clip;
    }
    .is-enhanced .policy-intro {
      position: absolute;
      inset: 20% 3% 17%;
      min-height: 0;
      padding: 0;
    }
    .is-enhanced .policy-letter {
      position: absolute;
      top: max(23%, 11rem);
      bottom: 15%;
      left: 50%;
      width: min(64%, 51rem);
      margin: 0;
      display: flex;
      flex-direction: column;
      transform: translateX(-50%);
      opacity: 0;
    }
    .is-enhanced .policy-seal,
    .is-enhanced .policy-sprout {
      top: auto;
      bottom: 20%;
      margin-bottom: 0;
    }
    .is-enhanced .policy-letter-window {
      flex: 1;
      min-height: 0;
      overflow: clip;
    }
    .is-enhanced .policy-letter-header {
      flex: 0 0 auto;
    }
    .is-enhanced .policy-letter-footer {
      flex: 0 0 auto;
    }
    .is-enhanced .policy-bottomline {
      position: absolute;
      bottom: 2rem;
      left: clamp(1.25rem, 4vw, 4rem);
      right: clamp(1.25rem, 4vw, 4rem);
    }
    .is-enhanced .policy-progress {
      display: block;
    }
    .is-enhanced .policy-flow-scroll {
      display: none;
    }
    .is-enhanced .policy-home {
      display: none;
    }
    .is-enhanced.is-complete .policy-home {
      display: block;
    }
    .policy.is-reading .policy-intro {
      min-height: 32rem;
    }
  }

  @media (max-width: 1023px), (max-height: 599px) {
    .policy-frame {
      padding-top: 6.5rem;
    }
    .policy-topline {
      font-size: 0.55rem;
      letter-spacing: 0.07em;
    }
    .policy-intro {
      min-height: 58svh;
    }
    .policy-seal {
      width: 8rem;
      padding: 0.85rem 1rem;
      margin-bottom: 4rem;
    }
    .policy-seal img {
      width: 4rem;
    }
    .policy-letter-subject {
      font-size: 0.6rem;
    }
    .policy-letter-header h2 {
      font-size: 1.25rem;
    }
    .policy-letter-footer {
      font-size: 0.5rem;
    }
    .policy-bottomline {
      gap: 0.75rem;
    }
    .policy-scroll {
      display: none;
    }
    .policy.is-flowing .policy-read {
      position: absolute;
      top: 8.25rem;
      right: 1.25rem;
      z-index: 4;
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .policy-scroll {
      display: none;
    }
  }

  @media print {
    .policy-frame {
      padding: 0;
    }
    .policy-intro {
      min-height: 0;
      padding: 1rem 0;
    }
    .policy h1 {
      font-size: 2rem;
    }
    .policy-seal,
    .policy-sprout,
    .policy-bottomline,
    .policy-topline,
    .policy-kicker,
    .policy-intro-note {
      display: none;
    }
    .policy-letter {
      width: 100%;
      border: 0;
      padding: 1rem;
      margin: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  let disposePolicy: (() => void) | undefined;

  function initPolicy() {
    disposePolicy?.();
    const root = document.querySelector<HTMLElement>("[data-policy]");
    if (!root) return;

    const intro = root.querySelector<HTMLElement>(".policy-intro")!;
    const letter = root.querySelector<HTMLElement>(".policy-letter")!;
    const source = root.querySelector<HTMLElement>("[data-letter-source]")!;
    const viewport = root.querySelector<HTMLElement>(".policy-letter-window")!;
    const readButton =
      root.querySelector<HTMLButtonElement>("[data-read-letter]")!;
    const scrollLink = root.querySelector<HTMLAnchorElement>(
      "[data-scroll-letter]",
    )!;
    const scrollLabel = root.querySelector<HTMLElement>("[data-scroll-label]")!;
    const scrollNote = root.querySelector<HTMLElement>("[data-scroll-note]")!;
    const progressBar = root.querySelector<HTMLElement>("[data-progress-bar]")!;
    const progressLabel = root.querySelector<HTMLElement>(
      "[data-progress-label]",
    )!;
    const media = gsap.matchMedia();
    let reading = false;
    let scrollToLetter = () =>
      letter.scrollIntoView({ behavior: "smooth", block: "start" });

    media.add(
      {
        desktop: "(min-width: 1024px) and (min-height: 600px)",
        compact: "(max-width: 1023px), (max-height: 599px)",
        reduce: "(prefers-reduced-motion: reduce)",
        print: "print",
      },
      (context) => {
        if (reading || context.conditions?.reduce || context.conditions?.print)
          return;
        const desktop = context.conditions?.desktop;
        root.classList.add(desktop ? "is-enhanced" : "is-flowing");
        readButton.hidden = false;

        // The intact source is always available to assistive technology.
        // Only this presentational copy is split, so letters are never announced individually.
        const visual = source.cloneNode(true) as HTMLElement;
        visual.removeAttribute("data-letter-source");
        visual.setAttribute("aria-hidden", "true");
        source.classList.add("policy-accessible");
        viewport.append(visual);
        const walker = document.createTreeWalker(visual, NodeFilter.SHOW_TEXT);
        const textNodes: Text[] = [];
        while (walker.nextNode()) textNodes.push(walker.currentNode as Text);
        const chars: HTMLElement[] = [];
        for (const node of textNodes) {
          const fragment = document.createDocumentFragment();
          for (const word of (node.textContent ?? "").split(/(\s+)/)) {
            if (!word) continue;
            if (/^\s+$/.test(word)) {
              fragment.append(document.createTextNode(word));
              continue;
            }
            const wrapper = document.createElement("span");
            wrapper.className = "policy-word";
            for (const character of word) {
              const span = document.createElement("span");
              span.className = "policy-char";
              span.textContent = character;
              chars.push(span);
              wrapper.append(span);
            }
            fragment.append(wrapper);
          }
          node.replaceWith(fragment);
        }

        let previousCount = 0;
        const reveal = (count: number) => {
          chars[previousCount - 1]?.classList.remove("is-caret");
          if (count > previousCount) {
            for (let i = previousCount; i < count; i++)
              chars[i].classList.add("is-typed");
          } else {
            for (let i = count; i < previousCount; i++)
              chars[i].classList.remove("is-typed");
          }
          if (count > 0 && count < chars.length)
            chars[count - 1].classList.add("is-caret");
          previousCount = count;
        };

        gsap.from(root.querySelectorAll("[data-title-word]"), {
          yPercent: 115,
          rotation: 3,
          duration: 1.05,
          stagger: 0.13,
          ease: "power3.out",
        });
        gsap.from(root.querySelectorAll("[data-intro-reveal]"), {
          opacity: 0,
          y: 12,
          duration: 0.65,
          delay: 0.4,
          stagger: 0.15,
        });

        if (desktop) {
          // CSS sticky owns the frame; ScrollTrigger only drives its contents.
          const transition = gsap
            .timeline({ paused: true })
            .to(intro, { autoAlpha: 0, y: -50, duration: 1, ease: "none" }, 0)
            .fromTo(
              letter,
              { opacity: 0, y: 40, rotation: -2 },
              { opacity: 1, y: 0, rotation: 0, duration: 1, ease: "none" },
              0.65,
            )
            .to(
              root.querySelector(".policy-sprout"),
              { xPercent: -18, scale: 0.8, duration: 1, ease: "none" },
              0,
            )
            .to(
              root.querySelector(".policy-seal"),
              {
                rotation: 0,
                xPercent: 20,
                scale: 0.88,
                duration: 1,
                ease: "none",
              },
              0,
            );

          const setLetterY = gsap.quickSetter(visual, "y", "px");
          let lineBottoms: number[] = [];
          const measure = () => {
            const top = visual.getBoundingClientRect().top;
            lineBottoms = chars.map(
              (char) => char.getBoundingClientRect().bottom - top,
            );
          };
          measure();

          const update = (progress: number) => {
            transition.progress(Math.min(progress / 0.17, 1));
            const typingProgress = gsap.utils.clamp(
              0,
              1,
              (progress - 0.18) / 0.76,
            );
            const count = Math.floor(typingProgress * chars.length);
            reveal(count);
            // Follow the typed line only when the page exceeds the available paper window.
            const overflow = Math.max(
              0,
              visual.scrollHeight - viewport.clientHeight,
            );
            const lineOffset = Math.max(
              0,
              (lineBottoms[count - 1] ?? 0) - viewport.clientHeight + 30,
            );
            setLetterY(-Math.min(lineOffset, overflow));
            progressBar.style.transform = `scaleX(${typingProgress})`;
            const complete = typingProgress === 1;
            root.classList.toggle("is-complete", complete);
            progressLabel.textContent = complete
              ? "A commitment that keeps growing."
              : `${Math.round(typingProgress * 100)}% of our letter`;
            scrollLabel.textContent = complete
              ? "Thank you for reading"
              : progress > 0.17
                ? "Keep scrolling"
                : "Scroll down";
            scrollNote.textContent = complete
              ? "Small changes. Lasting impact."
              : progress > 0.17
                ? "One commitment. Every word."
                : "A letter from our CEO";
          };
          const trigger = ScrollTrigger.create({
            trigger: root,
            start: "top top",
            end: "bottom bottom",
            onUpdate: (self) => update(self.progress),
            onRefresh: (self) => {
              measure();
              update(self.progress);
            },
          });
          scrollToLetter = () =>
            window.scrollTo({
              top: trigger.start + (trigger.end - trigger.start) * 0.2,
              behavior: "smooth",
            });
        } else {
          // On touch/small screens there is no pinning or artificial scroll distance.
          // Each paragraph types as it naturally enters the viewport.
          visual.querySelectorAll<HTMLElement>("p").forEach((paragraph) => {
            const localChars = Array.from(
              paragraph.querySelectorAll<HTMLElement>(".policy-char"),
            );
            ScrollTrigger.create({
              trigger: paragraph,
              start: "top 95%",
              end: "bottom 80%",
              onUpdate: (self) => {
                const count = Math.ceil(self.progress * localChars.length);
                localChars.forEach((char, index) =>
                  char.classList.toggle("is-typed", index < count),
                );
              },
            });
          });
        }

        let active = true;
        document.fonts.ready.then(() => {
          if (active) ScrollTrigger.refresh();
        });
        return () => {
          active = false;
          visual.remove();
          source.classList.remove("policy-accessible");
          root.classList.remove("is-enhanced", "is-flowing", "is-complete");
          readButton.hidden = true;
          progressBar.style.transform = "";
          scrollToLetter = () =>
            letter.scrollIntoView({ behavior: "smooth", block: "start" });
        };
      },
    );

    const readFullLetter = () => {
      reading = true;
      media.revert();
      root.classList.add("is-reading");
      letter.scrollIntoView({ behavior: "instant", block: "start" });
      letter.focus({ preventScroll: true });
    };
    const advanceLetter = (event: MouseEvent) => {
      event.preventDefault();
      scrollToLetter();
    };
    readButton.addEventListener("click", readFullLetter);
    scrollLink.addEventListener("click", advanceLetter);

    disposePolicy = () => {
      media.revert();
      readButton.removeEventListener("click", readFullLetter);
      scrollLink.removeEventListener("click", advanceLetter);
    };
  }

  initPolicy();
  document.addEventListener("astro:page-load", initPolicy);
  document.addEventListener("astro:before-swap", () => disposePolicy?.());
</script>
