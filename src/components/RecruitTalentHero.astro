<script>
  function initRecruitHero() {
    const hero = document.querySelector<HTMLElement>('[data-recruit-hero]');
    if (!hero || hero.dataset.ready === 'true') return;
    hero.dataset.ready = 'true';
    window.requestAnimationFrame(() => hero.classList.add('is-ready'));

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1024px)');
    if (reduceMotion.matches || !desktop.matches) return;

    const layers = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-parallax]'));
    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;

    const render = () => {
      frame = 0;
      const heroRect = hero.getBoundingClientRect();
      const scrollProgress = Math.max(-1, Math.min(1, -heroRect.top / window.innerHeight));

      layers.forEach((layer) => {
        const depth = Number(layer.dataset.heroParallax || 0);
        layer.style.setProperty('--parallax-x', `${(pointerX * depth).toFixed(1)}px`);
        layer.style.setProperty('--parallax-y', `${(pointerY * depth + scrollProgress * depth * 1.8).toFixed(1)}px`);
      });
    };

    const requestRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    hero.addEventListener('pointermove', (event) => {
      pointerX = event.clientX / window.innerWidth - 0.5;
      pointerY = event.clientY / window.innerHeight - 0.5;
      requestRender();
    }, { passive: true });
    window.addEventListener('scroll', requestRender, { passive: true });
    requestRender();
  }

  initRecruitHero();
  document.addEventListener('astro:page-load', initRecruitHero);
</script>
