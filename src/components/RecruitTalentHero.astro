---
import { PrimaryButton, SecondaryButton } from './Button';
import HeroIllustration from './HeroIllustration.astro';
import { getPublicContacts } from '../sanity/queries';
import { telephoneHref } from '../data/editorial';
const contacts = await getPublicContacts();
---

<section class="recruit-hero" aria-labelledby="recruit-hero-title" data-recruit-hero>
  <div class="recruit-hero-oval recruit-hero-oval-one" data-hero-shape="1" aria-hidden="true"></div>

  <div class="recruit-hero-inner">
    <div class="recruit-hero-copy">
      <p class="recruit-hero-kicker">Temp, Perm and everything in between</p>
      <h1 id="recruit-hero-title">Let's find the right people for your team</h1>
      <p class="recruit-hero-intro">
        We meet all our candidates face-to-face, every time. That's how we know they can do the job, and how we know they'll fit in once they're through your door.
      </p>
      <div class="recruit-hero-actions">
        <PrimaryButton
          className="recruit-hero-button"
          href="#staffing-brief"
          shadow={false}
          backgroundColor="var(--color-cocoa)"
          textColor="var(--color-cream)"
        >
          Get in touch
        </PrimaryButton>
        <SecondaryButton
          className="recruit-hero-button recruit-hero-button-secondary"
          href={telephoneHref(contacts.phone)}
        >
          Call us - {contacts.phone}
        </SecondaryButton>
      </div>
      <dl class="recruit-hero-proof" aria-label="Change Hospitality recruitment approach">
        <div><dt>20+</dt><dd>years of hospitality networks</dd></div>
        <div><dt>1:1</dt><dd>consultant-led, face-to-face service</dd></div>
      </dl>
    </div>

    <div class="recruit-hero-art" aria-hidden="true">
      <HeroIllustration kind="bart" />
      <div class="recruit-hero-note">Brief taken<br />by a human</div>
      <p class="recruit-stage-caption">Every good hire starts with a clear order.</p>
    </div>
  </div>
</section>

<style>
  .recruit-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100svh;
    align-items: center;
    overflow: hidden;
    background: var(--color-mist);
    color: var(--color-ink);
    padding: 7rem 1.25rem 3rem;
  }

  .recruit-hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(100%, 80rem);
    margin: 0 auto;
    gap: 2.5rem;
    align-items: center;
  }

  .recruit-hero-copy { position: relative; z-index: 3; max-width: 48rem; }
  .recruit-hero-kicker {
    width: fit-content;
    margin-bottom: 1.25rem;
    border-radius: 1.2rem;
    background: var(--color-citron);
    padding: 0.7rem 1rem;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .recruit-hero h1 {
    max-width: 48rem;
    font-family: var(--font-hero);
    font-size: clamp(2.5rem, 5.3vw, 5rem);
    font-weight: 650;
    line-height: 0.94;
    text-wrap: balance;
  }
  .recruit-hero-intro {
    max-width: 39rem;
    margin-top: 1.75rem;
    color: var(--color-cocoa);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.6;
  }
  .recruit-hero-actions { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem; }
  .recruit-hero-proof { display: grid; max-width: 37rem; margin-top: 2rem; gap: 0.7rem; }
  .recruit-hero-proof div {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 34%, transparent);
    padding-top: 0.75rem;
  }
  .recruit-hero-proof dt { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; }
  .recruit-hero-proof dd { color: var(--color-cocoa); font-size: 0.75rem; font-weight: 900; text-transform: uppercase; }
  .recruit-hero-oval {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 18%, transparent);
    border-radius: 43% 57% 62% 38% / 52% 40% 60% 48%;
    background: var(--color-cream);
    pointer-events: none;
  }
  .recruit-hero-oval-one {
    top: 4rem;
    right: -13rem;
    width: 27rem;
    height: 17rem;
    background: radial-gradient(color-mix(in srgb, var(--color-cocoa) 18%, transparent) 1px, transparent 1px) 0 0 / 12px 12px,
      var(--color-cream);
    transform: rotate(-10deg);
  }
  .recruit-hero-art { position: relative; width: min(100%, 34rem); justify-self: center; margin-bottom: 1.5rem; }
  .recruit-hero-note {
    position: absolute;
    z-index: 3;
    bottom: 8%;
    left: -1%;
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 25%, transparent);
    border-radius: 0.4rem;
    background: var(--color-paper);
    color: var(--color-cocoa);
    padding: 0.85rem 1rem;
    font-size: 0.7rem;
    font-weight: 900;
    line-height: 1.35;
    text-transform: uppercase;
    transform: rotate(-7deg);
  }
  .recruit-hero-note::before { display: block; margin-bottom: 0.6rem; border-top: 1px dashed currentColor; content: ""; }
  .recruit-stage-caption {
    position: absolute;
    bottom: -1.5rem;
    left: 12%;
    width: 76%;
    color: var(--color-cocoa);
    font-size: 0.7rem;
    font-weight: 900;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .recruit-hero-copy > *,
    .recruit-hero-art { animation: recruit-hero-arrive 700ms var(--ease-luxury) both; }
    .recruit-hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .recruit-hero-copy > :nth-child(3) { animation-delay: 140ms; }
    .recruit-hero-copy > :nth-child(4) { animation-delay: 200ms; }
    .recruit-hero-copy > :nth-child(5) { animation-delay: 260ms; }
    .recruit-hero-art { animation-delay: 170ms; }
  }
  @keyframes recruit-hero-arrive {
    from { opacity: 0; transform: translateY(1.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 640px) {
    .recruit-hero { padding-inline: 2.5rem; }
    .recruit-hero-actions { flex-direction: row; flex-wrap: wrap; }
  }
  @media (min-width: 1024px) {
    .recruit-hero-inner { grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr); }
  }
  @media (max-width: 1023px) {
    .recruit-hero-copy { max-width: 42rem; }
    .recruit-hero-art { width: min(100%, 27rem); }
    .recruit-hero-proof { display: none; }
  }
  @media (max-width: 639px) {
    .recruit-hero { padding-top: 6rem; }
    .recruit-hero-intro { margin-top: 1rem; font-size: 1rem; line-height: 1.5; }
    .recruit-hero-actions { margin-top: 1.25rem; }
    .recruit-hero-button-secondary { display: none; }
    .recruit-hero-art { width: min(100%, 23rem); }
    .recruit-hero-note { left: 0; padding: 0.65rem 0.75rem; font-size: 0.6rem; }
    .recruit-stage-caption { font-size: 0.6rem; }
  }
  @media (max-height: 800px) and (min-width: 1024px) {
    .recruit-hero { padding-top: 6rem; padding-bottom: 2rem; }
    .recruit-hero h1 { font-size: clamp(3rem, 4.5vw, 4rem); }
    .recruit-hero-intro { margin-top: 1rem; font-size: 1rem; line-height: 1.45; }
    .recruit-hero-actions,
    .recruit-hero-proof { margin-top: 1.25rem; }
    .recruit-hero-proof { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .recruit-hero-proof div { grid-template-columns: auto 1fr; gap: 0.75rem; }
  }
</style>
