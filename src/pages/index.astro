---
import { PrimaryButton, SecondaryButton } from '../components/Button';
import FunMenu from '../components/FunMenu.astro';
import HomeStoryHero from '../components/HomeStoryHero';
import PageMotion from '../components/PageMotion.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
import ApplicationSection from '../components/ApplicationSection.astro';
import DivisionSplit from '../components/DivisionSplit.astro';
import HomeExperience from '../components/HomeExperience.astro';
import ImpactTracker from '../components/ImpactTracker.astro';
import OpportunitiesStream from '../components/OpportunitiesStream.astro';
import PhilosophyReveal from '../components/PhilosophyReveal.astro';
import TestimonialsStack from '../components/TestimonialsStack.astro';
*/

const homeSectionLinks = [
  { label: 'Our approach', href: '#approach', meta: 'People before databases' },
  { label: 'Divisions', href: '#divisions', meta: 'Where we specialise' },
  { label: 'Live jobs', href: '#opportunities', meta: 'Open opportunities' },
  { label: 'Apply', href: '#apply', meta: 'Join the pass' },
];
---

<BaseLayout loadStory>
  <FunMenu
    sectionLinks={homeSectionLinks}
    menuButtonBackground="var(--color-cream)"
    menuButtonBorderColor="var(--color-ink)"
    menuButtonTextColor="var(--color-ink)"
  />
  <main class="home-page bg-cream text-ink">
    <HomeStoryHero client:load />
    <!-- <div class="home-story-link">
      <p>A little idea. A lot of heart.</p>
      <PrimaryButton
        href="/our-story/"
        backgroundColor="var(--color-cocoa)"
        textColor="var(--color-cream)"
        hoverBackgroundColor="var(--color-cream)"
      >
        Our Story
      </PrimaryButton>
    </div>
    <div class="home-policy-link">
      <p>People first. Planet too.</p>
      <SecondaryButton
        href="/sustainability-impact/"
        shadow
        textColor="var(--color-bcorp-green)"
        borderColor="var(--color-bcorp-green)"
        hoverBackgroundColor="var(--color-bcorp-green)"
        hoverTextColor="var(--color-cream)"
      >
        Sustainability &amp; Impact
      </SecondaryButton>
    </div> -->
    <!--
      <PhilosophyReveal />
      <DivisionSplit />
      <ImpactTracker />
      <OpportunitiesStream />
      <TestimonialsStack />
      <ApplicationSection />
    -->
    <SiteFooter backdropColor="var(--color-flame)" />
  </main>
  <PageMotion page="home" />
</BaseLayout>

<style>
  .home-story-link,
  .home-policy-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 3rem;
    padding: 2rem 1.25rem;
    background: var(--color-mint);
    color: var(--color-bcorp-green);
  }

  .home-story-link { background: var(--color-blush); color: var(--color-cocoa); border-radius: 50% 50% 0 0 / 1.5rem 1.5rem 0 0; }
  .home-story-link p { font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.6rem); font-weight: 500; }

  .home-policy-link p { font-family: var(--font-hero); font-size: clamp(1.1rem, 2vw, 1.6rem); }
</style>
