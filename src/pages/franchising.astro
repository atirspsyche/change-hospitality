---
import { ArrowDown, ArrowUp, ArrowUpRight, Clapperboard, Mail, Phone } from '@lucide/astro';
import FunMenu from '../components/FunMenu.astro';
import StoryIllustration from '../components/StoryIllustration.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'info@changehospitality.co.uk';
const emailLink = `mailto:${email}?subject=Franchising%20with%20Change%20Hospitality`;
const franchiseFilm = {
  src: '',
  poster: '',
  captions: '',
  transcriptUrl: '',
};
---

<BaseLayout
  title="Franchising | Change Hospitality"
  description="Build your own hospitality recruitment agency with Change Hospitality: over 20 years of experience, proven systems, established processes and national client agreements."
>
  <FunMenu
    menuButtonBackground="var(--color-blush)"
    menuButtonBorderColor="var(--color-ink)"
    menuButtonTextColor="var(--color-ink)"
  />

  <main class="franchising-page">
    <section class="franchise-hero" aria-labelledby="franchise-title">
      <div class="franchise-hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Your ambition. Our next chapter.</p>
        <h1 id="franchise-title" tabindex="-1">Franchise with <span>Change.</span></h1>
        <p class="hero-intro">
          You bring the drive and the local knowledge.<br />
          We bring two decades of knowing what works.
        </p>
        <a class="conversation-link" href="#lets-talk">Let's talk franchising <ArrowDown size={18} aria-hidden="true" /></a>
      </div>

      <div class="hero-baseline">
        <div class="hero-character hero-character--chef" aria-hidden="true"><StoryIllustration kind="chef" /></div>
        <p><strong>3</strong><span>Franchise locations.<br /><b>One shared ambition.</b></span></p>
        <div class="hero-character hero-character--growth" aria-hidden="true"><StoryIllustration kind="sprout" /></div>
      </div>
      </div>
    </section>

    <section class="franchise-next" id="the-opportunity" aria-labelledby="opportunity-title">
      <div class="opportunity">
        <div class="opportunity-heading">
          <p class="eyebrow">Independent spirit. Shared DNA.</p>
          <h2 id="opportunity-title">A proven model.<br />Your own business.</h2>
        </div>
        <div class="opportunity-copy">
          <p>
            Hospitality is one of the UK's biggest employers with 3.5 million
            people and a sector worth £93 billion. It's also one of the most
            demanding to staff with the highest employee turnover of any industry
            in the country, at over 50%. That means constant, year-round demand
            for good recruitment, that doesn't disappear when the economy shifts.
          </p>
          <p>
            We've spent over 20 years turning that demand into a profitable,
            award-winning business - first in London, and now in Manchester and
            Hampshire. It works because the model works: proven systems,
            established processes, and a brand hospitality businesses already
            trust. We currently cover London, Greater Manchester and the Hampshire
            area, which leaves the rest of the UK wide open, and that's where you
            come in.
          </p>
          <p>
            What makes this different from starting out alone is that we already
            hold national agreements with most of the UK's biggest caterers but
            outside our current office areas, we can't service them. So the day
            you open, that work is yours. You'd be supplying demand we already
            have but can't yet reach.
          </p>
          <p>
            As a Change franchisee, you'd build your own hospitality recruitment
            agency in a location of your choice, under a name the industry already
            knows, using the exact systems and support that got us here. You bring
            the drive and the local knowledge; we bring two decades of knowing
            what works, and we'll be alongside you at every step.
          </p>
        </div>
      </div>

      <section class="office-gallery" aria-labelledby="office-title">
        <div class="office-gallery-heading">
          <p class="eyebrow">Growing, together</p>
          <h2 id="office-title">Three places.<br class="mobile-break" /> One Change.</h2>
        </div>
        <figure class="franchise-film" data-franchise-film>
          <div class="franchise-film-frame">
            <span class="film-tape" aria-hidden="true"></span>
            <div class="franchise-film-screen">
              {franchiseFilm.src ? (
                <video
                  src={franchiseFilm.src}
                  poster={franchiseFilm.poster || undefined}
                  controls
                  playsinline
                  preload="none"
                  crossorigin="anonymous"
                  aria-label="The Change Hospitality franchise film"
                  aria-describedby="franchise-film-caption"
                >
                  {franchiseFilm.captions && (
                    <track kind="captions" src={franchiseFilm.captions} srclang="en" label="English" default />
                  )}
                  <a href={franchiseFilm.src}>Watch the Change Hospitality franchise film</a>
                </video>
              ) : (
                <div class="film-placeholder">
                  <span class="film-wordmark">Change Hospitality</span>
                  <div class="film-art film-art--chef" aria-hidden="true"><StoryIllustration kind="chef" /></div>
                  <p class="film-placeholder-title">Good people.<br /><span>One Change.</span></p>
                  <div class="film-art film-art--growth" aria-hidden="true"><StoryIllustration kind="sprout" /></div>
                </div>
              )}
            </div>
            <figcaption id="franchise-film-caption">
              <span>Our people. Our places. One Change.</span>
              {!franchiseFilm.src && <span class="film-status"><Clapperboard size={18} aria-hidden="true" /> Film coming soon</span>}
              {franchiseFilm.src && franchiseFilm.transcriptUrl && <a href={franchiseFilm.transcriptUrl}>Read the transcript <ArrowUpRight size={16} aria-hidden="true" /></a>}
            </figcaption>
          </div>
        </figure>
      </section>

      <div class="franchise-contact" id="lets-talk" aria-labelledby="contact-title" tabindex="-1">
        <div class="contact-heading">
          <p class="eyebrow">The next location could be yours</p>
          <h2 id="contact-title">It starts with<br /><span>a hello.</span></h2>
          <p>If that sounds like something you'd like to build, tell us a little about yourself by email or phone and we'll be in touch.</p>
        </div>
        <div class="contact-links">
          <a class="contact-link contact-link--email" href={emailLink}>
            <span class="contact-label"><span><Mail size={16} aria-hidden="true" /> Drop us a line</span><ArrowUpRight size={24} aria-hidden="true" /></span>
            <span class="contact-value">info@<wbr />changehospitality.co.uk</span>
            <span class="contact-detail">Let's talk about your idea</span>
          </a>
          <a class="contact-link contact-link--phone" href="tel:+442080506312">
            <span class="contact-label"><span><Phone size={16} aria-hidden="true" /> Have a conversation</span><ArrowUpRight size={24} aria-hidden="true" /></span>
            <span class="contact-value">020 8050 6312</span>
            <span class="contact-detail">Ask the team about franchising</span>
          </a>
        </div>
      </div>

      <footer class="franchise-footer">
        <a href="/">Change Hospitality</a>
        <span>Good people. Great hospitality. Your next chapter.</span>
        <a href="#franchise-title">Back to top <ArrowUp size={16} aria-hidden="true" /></a>
      </footer>
    </section>
  </main>
</BaseLayout>

<style>
  :global(html:has(.franchising-page)),
  :global(body:has(.franchising-page)) {
    background: var(--color-citron);
    color: var(--color-ink);
  }

  .franchising-page {
    background: var(--color-citron);
    color: var(--color-ink);
    letter-spacing: 0;
    overflow: clip;
  }

  .franchising-page :focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 6px;
  }

  .franchising-page ::selection {
    background: var(--color-ink);
    color: var(--color-citron);
  }

  .franchise-hero {
    display: grid;
    min-height: max(42rem, calc(100svh - 2rem));
    align-items: center;
    padding: 6rem 2.5rem 3rem;
  }

  .franchise-hero-inner {
    display: grid;
    width: min(100%, 80rem);
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: 2rem;
    margin-inline: auto;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 1rem;
    text-align: left;
  }

  .eyebrow {
    width: fit-content;
    border-radius: 0.8rem;
    background: var(--color-mint);
    padding: 0.65rem 0.9rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .hero-eyebrow {
    margin-bottom: 1.5rem;
    background: var(--color-blush);
  }

  .hero-copy h1 {
    font-family: var(--font-hero);
    font-size: 3rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .hero-copy h1 > span {
    display: block;
    color: var(--color-cocoa);
    font-size: 6.5rem;
    font-weight: 400;
    line-height: 1.1;
    text-shadow: 3px 4px 0 var(--color-blush);
  }

  .hero-intro {
    max-width: 31rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .conversation-link {
    display: inline-flex;
    min-height: 3.4rem;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    border: 2px solid var(--color-ink);
    border-radius: 1.2rem;
    background: var(--color-mint);
    padding: 0.8rem 1.25rem;
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 4px 5px 0 var(--color-ink);
    transition: background 200ms ease, box-shadow 200ms ease, transform 300ms var(--ease-cartoon);
  }

  .conversation-link:hover,
  .conversation-link:focus-visible {
    transform: translateY(-3px) rotate(-2deg);
    background: var(--color-blush);
    box-shadow: 6px 8px 0 var(--color-ink);
  }

  .hero-baseline {
    position: relative;
    width: 100%;
    aspect-ratio: 1.05;
  }

  .hero-baseline > p {
    position: absolute;
    z-index: 2;
    bottom: 6%;
    left: 4%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 2px solid var(--color-ink);
    border-radius: 1.2rem;
    background: var(--color-mint);
    padding: 0.8rem 1.5rem;
    color: var(--color-ink);
    box-shadow: 5px 6px 0 var(--color-ink);
    line-height: 1.4;
    transform: rotate(-2deg);
  }

  .hero-baseline strong {
    color: var(--color-cocoa);
    font-family: var(--font-hero);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
  }

  .hero-baseline > p > span { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; }
  .hero-baseline b { font-family: var(--font-sans); font-size: 0.9rem; font-weight: 400; }

  .hero-character {
    position: absolute;
    pointer-events: none;
  }

  .hero-character--chef { top: 0; left: 4%; width: 78%; transform: rotate(-8deg); }
  .hero-character--growth { right: -2%; bottom: 13%; width: 40%; transform: rotate(8deg); }

  .franchise-next {
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    border-radius: 50% 50% 0 0 / 2rem 2rem 0 0;
    background: var(--color-blush);
    scroll-margin-top: 2rem;
  }

  .opportunity,
  .franchise-contact {
    display: grid;
    width: min(100%, 86rem);
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-inline: auto;
    padding: 3.5rem 3rem;
  }

  .opportunity-heading h2 {
    margin-top: 1.25rem;
    font-family: var(--font-hero);
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .opportunity-copy {
    align-self: center;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .opportunity-copy p + p {
    margin-top: 0.9rem;
  }

  .opportunity-signoff {
    color: var(--color-cocoa);
    font-weight: 700;
  }

  .office-gallery {
    width: min(100%, 86rem);
    margin-inline: auto;
    padding: 0.5rem 3rem 3rem;
  }

  .office-gallery-heading { text-align: center; }
  .office-gallery-heading .eyebrow { margin: 0 auto 1rem; background: var(--color-mist); transform: rotate(2deg); }
  .office-gallery h2 { font-family: var(--font-hero); font-size: 2.25rem; line-height: 1.2; }
  .mobile-break { display: none; }

  .franchise-film {
    width: min(100%, 68rem);
    margin: 2.75rem auto 0;
  }

  .franchise-film-frame {
    position: relative;
    border: 2px solid var(--color-ink);
    border-radius: 0.5rem;
    background: var(--color-paper);
    padding: 0.75rem 0.75rem 0;
    box-shadow: 6px 8px 0 var(--color-ink);
  }

  .film-tape {
    position: absolute;
    z-index: 1;
    top: -0.8rem;
    left: calc(50% - 2.5rem);
    width: 5rem;
    height: 1.65rem;
    background: var(--color-flame);
    clip-path: polygon(0 10%, 97% 0, 100% 90%, 3% 100%);
    transform: rotate(-5deg);
  }

  .franchise-film-screen {
    aspect-ratio: 16 / 9;
    background: var(--color-ink);
    overflow: hidden;
  }

  .franchise-film-screen video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .film-placeholder {
    position: relative;
    display: grid;
    height: 100%;
    grid-template-columns: 0.8fr 1.4fr 0.8fr;
    align-items: center;
    background: var(--color-mint);
    padding: 2.5rem 2rem;
  }

  .film-wordmark {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .film-placeholder-title {
    font-family: var(--font-hero);
    font-size: 3.5rem;
    line-height: 1.15;
    text-align: center;
  }

  .film-placeholder-title span { color: var(--color-cocoa); }
  .film-art--chef { transform: rotate(-8deg); }
  .film-art--growth { transform: rotate(8deg); }

  .franchise-film figcaption {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 1rem 0.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .film-status,
  .franchise-film figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .franchise-film figcaption a {
    min-height: 2.75rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .franchise-contact {
    flex: 1;
    align-items: center;
    scroll-margin-top: 2rem;
  }

  .contact-heading > .eyebrow { background: var(--color-citron); }

  .contact-heading h2 {
    margin: 1.2rem 0;
    font-family: var(--font-hero);
    font-size: 3.5rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .contact-heading h2 span {
    color: var(--color-cocoa);
  }

  .contact-heading > p:last-child {
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .contact-links {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    padding: 0.5rem;
  }

  .contact-link {
    display: block;
    border: 2px solid var(--color-ink);
    border-radius: 1.2rem;
    background: var(--color-mint);
    padding: 1.3rem 1.5rem;
    box-shadow: 5px 6px 0 var(--color-ink);
    transform: rotate(-2deg);
    transition: background 200ms ease, box-shadow 200ms ease, transform 300ms var(--ease-cartoon);
  }

  .contact-link--phone { background: var(--color-mist); transform: rotate(2deg); }

  .contact-link:hover,
  .contact-link:focus-visible {
    background: var(--color-citron);
    box-shadow: 7px 9px 0 var(--color-ink);
    transform: translateY(-3px) rotate(0);
  }

  .contact-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .contact-label > span {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .contact-value {
    display: block;
    margin-block: 0.9rem 0.5rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .contact-link--phone .contact-value {
    font-size: 2.5rem;
  }

  .contact-detail {
    font-size: 0.78rem;
  }

  .franchise-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-mint);
    padding: 0.75rem 3rem;
    font-size: 0.72rem;
  }

  .franchise-footer a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
  }

  .franchise-footer a:first-child {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }

  .franchise-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @keyframes arrive {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy h1 { animation: arrive 650ms ease both; }
    .hero-intro { animation: arrive 650ms 100ms ease both; }
    .conversation-link { animation: arrive 650ms 200ms ease backwards; }
  }

  @media (min-width: 1600px) {
    .hero-copy h1 { font-size: 3.75rem; }
    .hero-copy h1 > span { font-size: 8rem; }
  }

  @media (max-width: 1023px) {
    .franchise-hero { padding-inline: 1.5rem; }
    .franchise-hero-inner { grid-template-columns: 1fr; gap: 0.5rem; }
    .hero-copy { max-width: 40rem; }
    .hero-baseline { width: min(27rem, 65%); justify-self: end; margin-top: -3rem; }
    .opportunity, .franchise-contact { gap: 2rem; padding: 3rem 1.5rem; }
    .office-gallery { padding-inline: 1.5rem; }
    .film-placeholder-title { font-size: 2.75rem; }
    .opportunity-heading h2 { font-size: 2.25rem; }
    .contact-heading h2 { font-size: 3rem; }
    .contact-value { font-size: 1.4rem; }
    .contact-link--phone .contact-value { font-size: 2rem; }
    .franchise-footer { padding-inline: 1.5rem; }
  }

  @media (max-width: 639px) {
    .franchise-hero { min-height: calc(100svh - 1.25rem); padding: 5.5rem 1.25rem 2rem; }
    .hero-copy { padding: 0; }
    .hero-eyebrow { margin-bottom: 1.25rem; font-size: 0.6rem; }
    .hero-copy h1 { font-size: 2rem; }
    .hero-copy h1 > span { margin-top: 0.3rem; font-size: 4.75rem; }
    .hero-intro { margin: 1.1rem 0 1.5rem; font-size: 1rem; }
    .hero-intro br { display: none; }
    .hero-baseline { width: min(21rem, 100%); aspect-ratio: 1.3; margin-top: 0.5rem; }
    .hero-baseline > p { bottom: 0; left: 0; gap: 0.85rem; padding: 0.65rem 1rem; }
    .hero-baseline > p > span { font-size: 1.1rem; }
    .hero-baseline b { font-size: 0.8rem; }
    .hero-baseline strong { font-size: 3rem; }
    .hero-character--chef { left: 8%; width: 65%; }
    .hero-character--growth { right: 0; bottom: 24%; width: 32%; }
    .opportunity, .franchise-contact { grid-template-columns: 1fr; gap: 1.5rem; padding: 2.5rem 1.25rem; }
    .opportunity-heading h2 { font-size: 2rem; }
    .opportunity-copy { font-size: 0.9rem; }
    .office-gallery { padding: 0.5rem 1.5rem 2rem; }
    .office-gallery h2 { font-size: 1.8rem; }
    .mobile-break { display: block; }
    .franchise-film { margin-top: 2rem; }
    .franchise-film-frame { padding: 0.4rem 0.4rem 0; box-shadow: 4px 5px 0 var(--color-ink); }
    .film-placeholder { padding: 1.75rem 0.5rem 0.75rem; grid-template-columns: 0.7fr 1.6fr 0.7fr; }
    .film-wordmark { top: 0.6rem; left: 0.75rem; font-size: 0.6rem; }
    .film-placeholder-title { font-size: 1.5rem; }
    .franchise-film figcaption { min-height: 4rem; padding: 0.75rem 0.5rem; font-size: 0.85rem; }
    .film-status { font-size: 0.65rem; }
    .contact-heading h2 { font-size: 2.75rem; }
    .contact-link { padding: 1.1rem; }
    .contact-value { font-size: 1.4rem; }
    .contact-link--phone .contact-value { font-size: 2.15rem; }
    .franchise-footer { flex-wrap: wrap; gap: 0.25rem 1rem; padding: 0.75rem 1.25rem; }
    .franchise-footer > span { flex-basis: 100%; order: 3; padding-bottom: 0.5rem; }
    .franchise-footer a:last-child { margin-left: auto; }
    .desktop-break { display: none; }
  }

  @media (max-width: 359px) {
    .hero-copy h1 { font-size: 1.8rem; }
    .hero-copy h1 > span { font-size: 3.5rem; }
    .contact-value { font-size: 1.25rem; }
  }

  @media (max-height: 740px) and (min-width: 640px) {
    .franchise-hero { padding-top: 5rem; }
    .hero-eyebrow { margin-bottom: 0.65rem; }
    .hero-copy h1 { font-size: 2.5rem; }
    .hero-copy h1 > span { font-size: 5rem; }
    .hero-intro { margin-block: 0.75rem 1rem; }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let cleanupFranchising: (() => void) | undefined;

  function initFranchising() {
    cleanupFranchising?.();
    const root = document.querySelector<HTMLElement>('.franchising-page');
    if (!root) return;
    const video = root.querySelector<HTMLVideoElement>('.franchise-film-screen video');

    const media = gsap.matchMedia();
    media.add({
      motion: '(prefers-reduced-motion: no-preference)',
      desktop: '(min-width: 1024px)',
    }, (context) => {
      if (!context.conditions?.motion) return;

      const listeners = new AbortController();
      const lenis = new Lenis({
        duration: 1.2,
        smoothWheel: true,
        prevent: (node) => Boolean(node.closest('[data-funmenu-overlay]')),
      });
      const tick = (time: number) => lenis.raf(time * 1000);
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(tick);

      root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const target = root.querySelector<HTMLElement>(link.hash);
          if (!target) return;
          event.preventDefault();
          lenis.scrollTo(target, {
            offset: -32,
            duration: 2.6,
            easing: (time) => (1 - Math.cos(Math.PI * time)) / 2,
            onComplete: () => {
              history.pushState(history.state, '', link.hash);
              target.focus({ preventScroll: true });
            },
          });
        }, { signal: listeners.signal });
      });

      const revealTargets = root.querySelectorAll<HTMLElement>(
        '.opportunity-heading, .opportunity-copy, .office-gallery-heading, .contact-heading, .contact-links',
      );
      revealTargets.forEach((element) => {
        ScrollTrigger.create({
          trigger: element,
          start: 'top 94%',
          once: true,
          onEnter: () => context.add(() => {
            gsap.fromTo(element, { y: 24, opacity: 0.35 }, {
              y: 0,
              opacity: 1,
              duration: 0.8,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            });
          }),
        });
      });

      root.querySelectorAll<HTMLElement>('.franchise-film-frame').forEach((film) => {
        ScrollTrigger.create({
          trigger: film,
          start: 'top 96%',
          once: true,
          onEnter: () => context.add(() => {
            gsap.fromTo(film, { opacity: 0.3 }, {
              opacity: 1,
              duration: 0.8,
              clearProps: 'opacity',
            });
          }),
        });
      });

      if (context.conditions.desktop) {
        gsap.to(root.querySelector('.hero-character--chef'), {
          y: -70,
          rotation: -16,
          ease: 'none',
          scrollTrigger: { trigger: root.querySelector('.franchise-hero'), start: 'top top', end: 'bottom top', scrub: 0.8 },
        });
        gsap.to(root.querySelector('.hero-character--growth'), {
          y: -110,
          rotation: 16,
          ease: 'none',
          scrollTrigger: { trigger: root.querySelector('.franchise-hero'), start: 'top top', end: 'bottom top', scrub: 0.8 },
        });

        ScrollTrigger.create({
          trigger: root.querySelector('.office-gallery'),
          start: 'top bottom',
          once: true,
          onEnter: () => context.add(() => {
            root.querySelectorAll<HTMLElement>('[data-franchise-film]').forEach((film) => {
              gsap.fromTo(film, { y: 16 }, {
                y: -16,
                ease: 'none',
                scrollTrigger: { trigger: root.querySelector('.office-gallery'), start: 'top bottom', end: 'bottom top', scrub: 0.8 },
              });
            });
          }),
        });
      }

      return () => {
        listeners.abort();
        gsap.ticker.remove(tick);
        lenis.destroy();
      };
    }, root);

    cleanupFranchising = () => {
      video?.pause();
      media.revert();
    };
  }

  initFranchising();
  document.addEventListener('astro:page-load', initFranchising);
  document.addEventListener('astro:before-swap', () => {
    cleanupFranchising?.();
    cleanupFranchising = undefined;
  });
</script>