---
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import { ArrowDown, Mail, Phone } from 'lucide-react';
import { PrimaryButton, SecondaryButton } from '../components/Button';
import FranchiseFilm from '../components/FranchiseFilm.astro';
import FunMenu from '../components/FunMenu.astro';
import PageMotion from '../components/PageMotion.astro';
import StoryIllustration from '../components/StoryIllustration.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'info@changehospitality.co.uk';
const emailLink = `mailto:${email}?subject=Franchising%20with%20Change%20Hospitality`;
const franchiseFilm = {
  src: '',
  poster: '',
  captions: '',
  transcriptUrl: '',
};
const sectionLinks = [
  { label: 'The opportunity', href: '#the-opportunity', meta: 'Your next chapter' },
  { label: 'The Change way', href: '#the-change-way', meta: 'Get to know us' },
  { label: "Let's talk", href: '#lets-talk', meta: 'Start a conversation' },
];
const locations = ['London', 'Manchester', 'Hampshire'];
---

<BaseLayout
  title="Franchising | Change Hospitality"
  description="Build your own hospitality recruitment agency with Change Hospitality: over 20 years of experience, proven systems, established processes and national client agreements."
>
  <FunMenu
    sectionLinks={sectionLinks}
    menuButtonBackground="var(--color-blush)"
    menuButtonBorderColor="var(--color-cocoa)"
    menuButtonTextColor="var(--color-cocoa)"
  />
  <PageMotion page="franchising" />

  <main class="franchising-page brand-page">
    <section class="franchise-hero" aria-labelledby="franchise-title">
      <div class="franchise-hero-orbit" aria-hidden="true"></div>
      <div class="franchise-shell hero-layout">
        <div class="hero-copy">
          <p class="franchise-kicker">Independent spirit. Shared DNA.</p>
          <h1 id="franchise-title" tabindex="-1">Franchise<br />with <span>Change.</span></h1>
          <p class="hero-intro">
            You bring the drive and the local knowledge.<br class="desktop-break" />
            We bring two decades of knowing what works.
          </p>
          <div class="franchise-actions">
            <PrimaryButton
              href="#lets-talk"
              shadow={false}
              backgroundColor="var(--color-cocoa)"
              textColor="var(--color-cream)"
            >
              Let's talk franchising
            </PrimaryButton>
            <SecondaryButton href="#the-opportunity" icon={ArrowDown} borderColor="var(--color-cocoa)" textColor="var(--color-cocoa)">
              The opportunity
            </SecondaryButton>
          </div>
        </div>

        <div class="hero-composition">
          <div class="hero-composition-shape" aria-hidden="true"></div>
          <div class="franchise-hero-card">
            <p class="card-eyebrow">Your ambition. Our next chapter.</p>
            <p class="hero-card-title">Your business.<br /><span>Our know-how.</span></p>
            <div class="hero-card-bottom">
              <p><strong>20+</strong><span>years of<br />people-first recruitment</span></p>
              <div class="hero-chef" aria-hidden="true"><StoryIllustration kind="chef" /></div>
            </div>
          </div>
          <p class="franchise-hero-note"><ArrowUpRight size={28} aria-hidden="true" /><span>The next location?<br /><strong>That could be you.</strong></span></p>
        </div>

        <div class="hero-baseline">
          <p>Good people. Great hospitality. <strong>Your next chapter.</strong></p>
          <a href="#the-opportunity" aria-label="Explore the franchising opportunity"><ArrowDown size={20} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="franchise-opportunity" id="the-opportunity" aria-labelledby="opportunity-title" tabindex="-1">
      <div class="franchise-shell">
        <div class="chapter-heading" data-franchise-reveal>
          <span class="chapter-number" aria-hidden="true">01</span>
          <p>The opportunity</p>
        </div>
        <div class="opportunity-layout">
          <h2 id="opportunity-title" data-franchise-reveal>Good hospitality.<br /><span>Great opportunity.</span></h2>
          <div class="opportunity-copy" data-franchise-reveal>
            <p>
              Hospitality is one of the UK's biggest employers with 3.5 million
              people and a sector worth £93 billion. It's also one of the most
              demanding to staff with the highest employee turnover of any industry
              in the country, at over 50%. That means constant, year-round demand
              for good recruitment, that doesn't disappear when the economy shifts.
            </p>
          </div>
        </div>
        <dl class="opportunity-figures" aria-label="The UK hospitality sector" data-franchise-reveal>
          <div><dt>3.5 million</dt><dd>people working in hospitality</dd></div>
          <div><dt>£93 billion</dt><dd>a sector full of possibility</dd></div>
          <div><dt>Year-round</dt><dd>demand for good recruitment</dd></div>
        </dl>
      </div>
    </section>

    <section class="franchise-model" aria-labelledby="model-title">
      <div class="franchise-shell model-layout">
        <div class="model-copy">
          <div class="chapter-heading" data-franchise-reveal>
            <span class="chapter-number" aria-hidden="true">02</span>
            <p>A proven model</p>
          </div>
          <h2 id="model-title" data-franchise-reveal>Built on experience.<br /><span>Ready for you.</span></h2>
          <div class="opportunity-copy" data-franchise-reveal>
            <p>
              We've spent over 20 years turning that demand into a profitable,
              award-winning business - first in London, and now in Manchester and
              Hampshire. It works because the model works: proven systems,
              established processes, and a brand hospitality businesses already
              trust. We currently cover London, Greater Manchester and the Hampshire
              area, which leaves the rest of the UK wide open, and that's where you
              come in.
            </p>
          </div>
          <a class="franchise-text-link" href="/our-story/">A little more about our story <ArrowUpRight size={20} aria-hidden="true" /></a>
        </div>
        <div class="location-board" data-franchise-reveal>
          <p class="board-kicker">Three places. One Change.</p>
          <ol class="location-list" aria-label="Our current locations">
            {locations.map((location, index) => (
              <li><span aria-hidden="true">0{index + 1}</span><strong>{location}</strong><span class="location-dot" aria-hidden="true"></span></li>
            ))}
          </ol>
          <div class="location-next">
            <span class="location-next-icon" aria-hidden="true"><ArrowUpRight size={30} /></span>
            <p>And next?<br /><strong>Somewhere with you.</strong></p>
          </div>
          <p class="board-footnote">One shared ambition. Room to grow.</p>
        </div>
      </div>
    </section>

    <section class="franchise-film-section" id="the-change-way" aria-labelledby="film-title" tabindex="-1">
      <div class="franchise-shell">
        <div class="film-section-heading" data-franchise-reveal>
          <div>
            <p class="section-eyebrow">More than a name above the door</p>
            <h2 id="film-title">Get a feel<br />for <span>Change.</span></h2>
          </div>
          <p>A people-first business.<br />A shared way of doing things.</p>
        </div>
        <FranchiseFilm {...franchiseFilm} />
      </div>
    </section>

    <section class="franchise-network" aria-labelledby="network-title">
      <div class="franchise-shell">
        <div class="chapter-heading" data-franchise-reveal>
          <span class="chapter-number" aria-hidden="true">03</span>
          <p>A head start, not a cold start</p>
        </div>
        <div class="network-layout">
          <h2 id="network-title" data-franchise-reveal>A national network.<br /><span>Your local knowledge.</span></h2>
          <div class="opportunity-copy" data-franchise-reveal>
            <p>
              What makes this different from starting out alone is that we already
              hold national agreements with most of the UK's biggest caterers but
              outside our current office areas, we can't service them. So the day
              you open, that work is yours. You'd be supplying demand we already
              have but can't yet reach.
            </p>
          </div>
        </div>
        <div class="network-path" data-franchise-reveal>
          <div><span>We bring</span><strong>Established<br />relationships.</strong></div>
          <span class="network-connector" aria-hidden="true">+</span>
          <div><span>You bring</span><strong>Local insight.<br />Personal ambition.</strong></div>
          <span class="network-connector" aria-hidden="true">=</span>
          <div class="network-result"><span>Together</span><strong>Your own<br />Change business.</strong></div>
        </div>
      </div>
    </section>

    <section class="franchise-partnership" aria-labelledby="partnership-title">
      <div class="franchise-shell partnership-layout">
        <div class="partnership-art" aria-hidden="true" data-franchise-reveal>
          <div class="partnership-art-shape"></div>
          <div class="partnership-chef"><StoryIllustration kind="chef" /></div>
          <div class="partnership-pan"><StoryIllustration kind="pan" /></div>
          <p>Your business.<br />Our people in your corner.</p>
        </div>
        <div>
          <div class="chapter-heading" data-franchise-reveal>
            <span class="chapter-number" aria-hidden="true">04</span>
            <p>Growing, together</p>
          </div>
          <h2 id="partnership-title" data-franchise-reveal>Independent.<br /><span>Never on your own.</span></h2>
          <div class="opportunity-copy" data-franchise-reveal>
            <p>
              As a Change franchisee, you'd build your own hospitality recruitment
              agency in a location of your choice, under a name the industry already
              knows, using the exact systems and support that got us here. You bring
              the drive and the local knowledge; we bring two decades of knowing
              what works, and we'll be alongside you at every step.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="franchise-contact" id="lets-talk" aria-labelledby="contact-title" tabindex="-1">
      <div class="franchise-shell contact-layout">
        <div class="contact-heading" data-franchise-reveal>
          <p class="franchise-kicker">The next location could be yours</p>
          <h2 id="contact-title">Big plans?<br /><span>Start with a hello.</span></h2>
        </div>
        <div class="contact-copy" data-franchise-reveal>
          <p>If that sounds like something you'd like to build, tell us a little about yourself by email or phone and we'll be in touch.</p>
          <div class="contact-actions">
            <PrimaryButton href={emailLink} icon={Mail} shadow={false} backgroundColor="var(--color-cocoa)" textColor="var(--color-cream)">
              Let's talk franchising
            </PrimaryButton>
            <SecondaryButton href="tel:+442080506312" icon={Phone} borderColor="var(--color-cocoa)" textColor="var(--color-cocoa)">
              Call 020 8050 6312
            </SecondaryButton>
          </div>
          <a class="contact-email" href={emailLink}>info@<wbr />changehospitality.co.uk <ArrowUpRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="franchise-footer">
    <div class="franchise-shell">
      <a class="footer-brand" href="/">Change Hospitality</a>
      <nav aria-label="Footer navigation">
        <a href="/recruit-talent/">Recruit talent</a>
        <a href="/our-story/">Our story</a>
        <a href="/team/">Our people</a>
      </nav>
      <a href="#franchise-title">Back to top <ArrowUp size={16} aria-hidden="true" /></a>
    </div>
  </footer>
</BaseLayout>

<style>
  .franchising-page {
    overflow: clip;
    background: var(--color-cream);
    color: var(--color-cocoa);
  }

  .franchise-shell { width: min(100% - 6rem, 80rem); margin-inline: auto; }
  .franchising-page section[id] { scroll-margin-top: 2rem; }
  .franchising-page h2 {
    font-size: clamp(2.5rem, 4.3vw, 4.4rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .franchising-page h2 span { font-weight: 400; }

  .franchise-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(58rem, max(48rem, 100svh));
    overflow: hidden;
    background: var(--color-mint);
    padding-block: 9rem 2rem;
  }
  .hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 4rem 2rem;
  }
  .franchise-hero-orbit {
    position: absolute;
    z-index: -1;
    top: -12rem;
    right: -13rem;
    width: 42rem;
    height: 36rem;
    border-radius: 48% 52% 37% 63%;
    background: var(--color-cream);
    transform: rotate(-22deg);
    pointer-events: none;
  }
  .hero-copy { position: relative; z-index: 2; }
  .franchise-kicker {
    display: inline-block;
    width: fit-content;
    border-radius: 999px;
    background: var(--color-blush);
    padding: 0.7rem 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.4;
    transform: rotate(-3deg);
  }
  .hero-copy h1 {
    margin-top: 1.8rem;
    font-family: var(--font-hero);
    font-size: clamp(3.5rem, 6.6vw, 6.5rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.045em;
  }
  .hero-copy h1 span { white-space: nowrap; }
  .hero-intro { max-width: 35rem; margin-top: 1.75rem; font-size: 1.15rem; line-height: 1.65; }
  .franchise-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-composition { position: relative; width: 100%; max-width: 30rem; justify-self: end; padding-block: 2rem 4rem; }
  .hero-composition-shape {
    position: absolute;
    inset: 0 -2rem 0 -1.5rem;
    border-radius: 44% 56% 61% 39%;
    background: var(--color-blush);
    transform: rotate(12deg);
  }
  .franchise-hero-card {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 20%, transparent);
    border-radius: 1.8rem;
    background: var(--color-cream);
    padding: 2rem;
    transform: rotate(5deg);
  }
  .card-eyebrow, .board-kicker, .section-eyebrow { font-size: 0.7rem; font-weight: 700; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.08em; }
  .hero-card-title { margin-block: 2rem; font-family: var(--font-display); font-size: clamp(2rem, 3.3vw, 3.4rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.045em; }
  .hero-card-title span { font-weight: 400; }
  .hero-card-bottom { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid color-mix(in srgb, var(--color-cocoa) 25%, transparent); padding-top: 1rem; }
  .hero-card-bottom strong { display: block; font-family: var(--font-display); font-size: 3.6rem; font-weight: 600; line-height: 1; }
  .hero-card-bottom p > span { display: block; margin-top: 0.5rem; font-size: 0.8rem; line-height: 1.4; }
  .hero-chef { width: 8.5rem; transform: rotate(-8deg); }
  .franchise-hero-note { position: absolute; bottom: 0; left: -1rem; display: flex; align-items: center; gap: 1rem; border-radius: 1.3rem; background: var(--color-citron); padding: 1rem 1.4rem; font-family: var(--font-display); font-size: 1.1rem; line-height: 1.35; transform: rotate(-7deg); }
  .hero-baseline { display: flex; grid-column: 1 / -1; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-cocoa) 25%, transparent); padding-top: 1.2rem; font-size: 0.78rem; }
  .hero-baseline strong { font-weight: 700; }
  .hero-baseline a { display: grid; width: 2.75rem; height: 2.75rem; flex-shrink: 0; place-items: center; border: 1px solid var(--color-cocoa); border-radius: 50%; }

  .franchise-opportunity { position: relative; margin-top: -1px; border-radius: 3rem 3rem 0 0; background: var(--color-cream); padding-block: 6.5rem; }
  .chapter-heading { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 2rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .chapter-number { display: grid; width: 2.4rem; height: 2.4rem; flex-shrink: 0; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: 0.7rem; letter-spacing: 0; }
  .opportunity-layout, .network-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
  .opportunity-copy { max-width: 39rem; font-size: 1.05rem; line-height: 1.8; text-wrap: pretty; }
  .opportunity-figures { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 4rem; }
  .opportunity-figures > div { border-top: 1px solid color-mix(in srgb, var(--color-cocoa) 35%, transparent); padding-top: 1.3rem; }
  .opportunity-figures dt { font-family: var(--font-display); font-size: clamp(2rem, 3.4vw, 3.3rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.045em; }
  .opportunity-figures dd { margin-top: 0.5rem; font-size: 0.8rem; }

  .franchise-model { background: var(--color-mist); padding-block: 6.5rem; }
  .model-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: 6rem; }
  .model-copy .opportunity-copy, .partnership-layout .opportunity-copy { margin-top: 1.8rem; }
  .franchise-text-link { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 1.5rem; margin-top: 1.5rem; font-size: 0.85rem; font-weight: 700; text-decoration: underline; text-underline-offset: 0.3rem; }
  .location-board { border-radius: 2rem; background: var(--color-cream); padding: 2.25rem; transform: rotate(3deg); }
  .board-kicker { margin-bottom: 1.5rem; }
  .location-list li { display: flex; align-items: center; gap: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-cocoa) 20%, transparent); padding-block: 1.3rem; }
  .location-list li > span:first-child { font-size: 0.65rem; }
  .location-list strong { font-family: var(--font-display); font-size: clamp(1.65rem, 2.3vw, 2.4rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.035em; }
  .location-dot { width: 0.6rem; height: 0.6rem; flex-shrink: 0; margin-left: auto; border-radius: 50%; background: var(--color-cocoa); }
  .location-next { display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem; border-radius: 1rem; background: var(--color-citron); padding: 1.2rem; font-family: var(--font-display); font-size: 1.1rem; line-height: 1.4; }
  .location-next-icon { flex-shrink: 0; }
  .board-footnote { margin-top: 1.5rem; font-size: 0.7rem; }

  .franchise-film-section { background: var(--color-paper); padding-block: 6.5rem; }
  .film-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .film-section-heading h2 { margin-top: 1.2rem; }
  .film-section-heading > p { max-width: 21rem; padding-bottom: 0.4rem; font-size: 1rem; line-height: 1.6; }

  .franchise-network { background: var(--color-cocoa); color: var(--color-cream); padding-block: 6.5rem; }
  .network-path { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 1.5rem; margin-top: 3.5rem; border-top: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent); padding-top: 2.5rem; }
  .network-path > div > span { display: block; margin-bottom: 1rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .network-path strong { font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 2.2rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.025em; }
  .network-connector { font-family: var(--font-display); font-size: 2rem; }
  .network-result { border-radius: 1.4rem; background: var(--color-mint); padding: 1.5rem; color: var(--color-cocoa); }

  .franchise-partnership { background: var(--color-cream); padding-block: 6.5rem; }
  .partnership-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 5rem; align-items: center; }
  .partnership-art { position: relative; min-height: 26rem; }
  .partnership-art-shape { position: absolute; inset: 1rem 0 2rem; border-radius: 45% 55% 40% 60%; background: var(--color-blush); transform: rotate(-10deg); }
  .partnership-chef { position: absolute; top: 1rem; left: 0; width: 62%; transform: rotate(-12deg); }
  .partnership-pan { position: absolute; top: 5rem; right: -1rem; width: 52%; transform: rotate(12deg); }
  .partnership-art > p { position: absolute; bottom: 0; left: 15%; border-radius: 1rem; background: var(--color-mint); padding: 1rem 1.4rem; font-family: var(--font-display); font-size: 1.1rem; font-weight: 500; line-height: 1.4; transform: rotate(-4deg); }

  .franchise-contact { border-radius: 3rem 3rem 0 0; background: var(--color-blush); padding-block: 6.5rem; }
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 5rem; align-items: center; }
  .contact-heading .franchise-kicker { background: var(--color-cream); }
  .contact-heading h2 { margin-top: 1.8rem; font-size: clamp(3rem, 5vw, 5rem); }
  .contact-copy > p { max-width: 30rem; font-size: 1.05rem; line-height: 1.75; }
  .contact-actions { display: grid; justify-items: start; gap: 0.85rem; margin-top: 1.8rem; }
  .contact-email { display: flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: 0.6rem; margin-top: 1.25rem; font-size: 0.85rem; text-decoration: underline; text-underline-offset: 0.25rem; overflow-wrap: anywhere; }
  .contact-email svg { flex-shrink: 0; }
  .franchise-footer { background: var(--color-blush); color: var(--color-cocoa); }
  .franchise-footer > div { display: flex; min-height: 7rem; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem; border-top: 1px solid color-mix(in srgb, var(--color-cocoa) 30%, transparent); padding-block: 1.5rem; font-size: 0.78rem; }
  .footer-brand { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; }
  .franchise-footer nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .franchise-footer a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.7rem; }
  .franchise-footer a:hover, .contact-email:hover { text-decoration: underline; text-underline-offset: 0.3rem; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: franchise-arrive 800ms var(--ease-luxury) both; }
    .hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .hero-copy > :nth-child(3) { animation-delay: 160ms; }
    .hero-copy > :nth-child(4) { animation-delay: 240ms; }
  }
  @keyframes franchise-arrive {
    from { opacity: 0; translate: 0 1.5rem; }
    to { opacity: 1; translate: 0 0; }
  }

  @media (max-width: 1100px) {
    .franchise-shell { width: calc(100% - 4rem); }
    .hero-copy h1 { font-size: clamp(3.5rem, 6.5vw, 5rem); }
    .hero-composition { padding-inline: 0.5rem; }
    .franchise-hero-card { padding: 1.5rem; }
    .hero-card-title { font-size: 2.6rem; }
    .model-layout, .partnership-layout, .contact-layout { gap: 3rem; }
    .location-board { padding: 1.6rem; }
  }
  @media (max-width: 1023px) {
    .franchise-hero { min-height: auto; padding-top: 8rem; }
    .hero-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 3rem 1.5rem; }
