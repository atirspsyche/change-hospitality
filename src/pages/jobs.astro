---
import CandidateTestimonials from '../components/CandidateTestimonials.astro';
import FunMenu from '../components/FunMenu.astro';
import JobListings from '../components/JobListings.astro';
import JobsHero from '../components/JobsHero.astro';
import PageMotion from '../components/PageMotion.astro';
import SectionCurve from '../components/SectionCurve.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoryboardGallery from '../components/StoryboardGallery.astro';
import TemporaryJobsExperience from '../components/TemporaryJobsExperience.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getJobs } from '../sanity/queries';
import { getDisplayJobs } from '../data/jobs';

const jobs = getDisplayJobs(await getJobs());

---

<BaseLayout
  title="Hospitality Jobs in London | Manchester | Hampshire | Change Hospitality"
  description="Find permanent, temporary and contract hospitality jobs in London, Manchester and Hampshire. Explore opportunities with Change Hospitality."
>
  <FunMenu
    menuButtonBackground="var(--color-cocoa)"
    menuButtonBorderColor="var(--color-ink)"
    menuButtonTextColor="var(--color-cream)"
  />

  <PageMotion page="jobs" />
  <main class="jobs-page">
    <JobsHero />
    <div data-jobs-mode-panel="permanent">
      <SectionCurve backdropColor="var(--color-blush)">
        <JobListings {jobs} pageSize={6} />
      </SectionCurve>
    </div>
    <TemporaryJobsExperience />
    <SectionCurve backdropColor="var(--jobs-mode-surface)">
      <CandidateTestimonials />
    </SectionCurve>
    <SectionCurve backdropColor="var(--jobs-gallery-backdrop)">
      <StoryboardGallery />
    </SectionCurve>
    <SiteFooter backdropColor="var(--color-cocoa)" />
  </main>
</BaseLayout>

<style>
  .jobs-page {
    --jobs-mode-surface: var(--color-mint);
    --jobs-gallery-backdrop: var(--color-cream);
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-blush);
    color: var(--color-ink);
  }

  .jobs-page:has(:global([data-jobs-mode-panel="temporary"]:not([hidden]))) {
    --jobs-mode-surface: var(--color-blush);
  }

  .jobs-page:has(:global(.candidate-stories[hidden])) {
    --jobs-gallery-backdrop: var(--jobs-mode-surface);
  }
</style>

<script>
  function initJobsModeSwitch() {
    const switcher = document.querySelector<HTMLFieldSetElement>('[data-jobs-mode-switch]');
    if (!switcher || switcher.dataset.ready === 'true') return;
    switcher.dataset.ready = 'true';

    const inputs = Array.from(switcher.querySelectorAll<HTMLInputElement>('input[name="jobsMode"]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-jobs-mode-panel]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let currentMode = '';
    let scrollFrame = 0;
    let focusTimer = 0;

    const setMode = (mode: string, shouldScroll = false) => {
      currentMode = mode;
      cancelAnimationFrame(scrollFrame);
      window.clearTimeout(focusTimer);
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.jobsModePanel !== mode;
      });
      const target = panels.find((panel) => panel.dataset.jobsModePanel === mode);
      if (shouldScroll && target) {
        scrollFrame = requestAnimationFrame(() => {
          scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            if (target.hidden || !target.isConnected) return;
            const focusHeading = () => {
              if (!target.hidden) target.querySelector<HTMLElement>('h2[tabindex="-1"]')?.focus({ preventScroll: true });
            };
            const scrollEvent = new CustomEvent('page-motion-scroll-to', {
              cancelable: true,
              detail: { target, onComplete: focusHeading },
            });
            if (document.dispatchEvent(scrollEvent)) {
              window.scrollTo({
                top: window.scrollY + target.getBoundingClientRect().top,
                behavior: reducedMotion ? 'instant' : 'smooth',
              });
              focusTimer = window.setTimeout(focusHeading, reducedMotion ? 0 : 650);
            }
          });
        });
      }
    };

    inputs.forEach((input) => {
      input.addEventListener('click', () => {
        if (input.checked) setMode(input.value, true);
      });
      input.addEventListener('change', () => {
        if (input.checked && input.value !== currentMode) setMode(input.value, true);
      });
    });

    setMode(inputs.find((input) => input.checked)?.value || 'permanent');
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(scrollFrame);
      window.clearTimeout(focusTimer);
    }, { once: true });
  }

  initJobsModeSwitch();
  document.addEventListener('astro:page-load', initJobsModeSwitch);
</script>