---
import ClientTestimonials from '../components/ClientTestimonials.astro';
import FunMenu from '../components/FunMenu.astro';
import PageMotion from '../components/PageMotion.astro';
import RecruitTalentHero from '../components/RecruitTalentHero.astro';
import RecruitmentDivisions from '../components/RecruitmentDivisions.astro';
import RecruitmentFAQs from '../components/RecruitmentFAQs.astro';
import RecruitmentForm from '../components/RecruitmentForm.astro';
import SectionCurve from '../components/SectionCurve.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicContacts } from '../sanity/queries';
import { telephoneHref } from '../data/editorial';
const contacts = await getPublicContacts();

---

<BaseLayout
  title="Recruit Hospitality Talent | Change Hospitality"
  description="Hire front of house, back of house, events and commercial talent through face-to-face hospitality recruitment. Send your staffing brief."
>
  <FunMenu
    menuButtonBackground="var(--color-flame)"
    menuButtonBorderColor="var(--color-ink)"
    menuButtonTextColor="var(--color-cream)"
  />

  <PageMotion page="recruit" />
  <main class="recruit-page" data-recruit-page>
    <RecruitTalentHero />

    <SectionCurve backdropColor="var(--color-mist)">
      <RecruitmentDivisions />
    </SectionCurve>

    <SectionCurve backdropColor="var(--color-citron)">
    <section id="staffing-requirement" class="recruit-form-section" aria-label="Submit a staffing requirement">
      <div class="recruit-form-layout">
        <aside class="recruit-form-intro" data-section-reveal>
          <p class="recruit-form-eyebrow">Recruit talent</p>
          <h2>Tell us what your team needs.</h2>
          <p>
            Permanent hire, casual cover or a whole opening team: give us the starting point and the right consultant takes it from there.
          </p>
          <div class="recruit-form-note">
            <span>Prefer to talk?</span>
            <a href={telephoneHref(contacts.phone)}>{contacts.phone}</a>
            <a href={`mailto:${contacts.recruitmentEmail}`}>{contacts.recruitmentEmail}</a>
          </div>
        </aside>

        <div class="recruit-form-wrap" data-section-reveal>
          <RecruitmentForm id="staffing-brief" contactEmail={contacts.recruitmentEmail} />
        </div>
      </div>
    </section>
    </SectionCurve>

    <SectionCurve backdropColor="var(--color-flame)">
      <RecruitmentFAQs />
    </SectionCurve>

    <SectionCurve backdropColor="var(--color-cream)">
      <ClientTestimonials />
    </SectionCurve>

    <SiteFooter backdropColor="var(--color-paper)" />
  </main>
  <noscript>
    <style is:inline>[data-recruit-page] [data-section-reveal] { opacity: 1; translate: none; }</style>
  </noscript>
</BaseLayout>

<style>
  .recruit-page {
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .recruit-form-eyebrow {
    margin-bottom: 1rem;
    color: var(--color-flame);
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .recruit-form-intro h2 {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 0.92;
    text-wrap: balance;
  }

  .recruit-form-section {
    position: relative;
    overflow: hidden;
    background: var(--color-flame);
    padding: 5rem 1.25rem;
  }

  .recruit-form-layout {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 80rem);
    margin: 0 auto;
    gap: 2.5rem;
    align-items: start;
  }

  .recruit-form-intro {
    color: var(--color-ink);
  }

  .recruit-form-intro > p:not(.recruit-form-eyebrow) {
    max-width: 31rem;
    margin-top: 1.5rem;
    color: var(--color-blush);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.6;
  }

  .recruit-form-eyebrow {
    width: fit-content;
    border-radius: 999px;
    background: var(--color-citron);
    color: var(--color-ink);
    padding: 0.65rem 0.9rem;
    transform: rotate(-2deg);
  }

  .recruit-form-note {
    display: grid;
    width: min(100%, 28rem);
    margin-top: 2rem;
    gap: 0.35rem;
    border-radius: 1.2rem;
    background: var(--color-blush);
    padding: 1rem;
    transform: rotate(1deg);
  }

  .recruit-form-note span {
    margin-bottom: 0.25rem;
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .recruit-form-note a {
    width: fit-content;
    font-weight: 900;
    overflow-wrap: anywhere;
  }

  .recruit-form-wrap {
    min-width: 0;
  }

  [data-section-reveal] {
    opacity: 0;
    translate: 0 2rem;
    transition: opacity 600ms ease, translate 750ms var(--ease-cartoon);
  }

  [data-section-reveal].is-visible {
    opacity: 1;
    translate: 0 0;
  }

  @media (min-width: 640px) {
    .recruit-form-section {
      padding-inline: 2.5rem;
    }

    .recruit-form-intro h2 {
      font-size: 4.6rem;
      color: var(--color-cream);
    }

  }

  @media (min-width: 1024px) {
    .recruit-form-section {
      padding-block: 7rem;
    }

    .recruit-form-layout {
      grid-template-columns: minmax(19rem, 0.72fr) minmax(0, 1.28fr);
      gap: 4rem;
    }

    .recruit-form-intro {
      position: sticky;
      top: 7rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    [data-section-reveal] {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>

<script>
  function initRecruitmentPage() {
    const page = document.querySelector<HTMLElement>('[data-recruit-page]');
    if (!page || page.dataset.ready === 'true') return;
    page.dataset.ready = 'true';

    const reveals = Array.from(page.querySelectorAll<HTMLElement>('[data-section-reveal]'));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      reveals.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });

    reveals.forEach((item) => observer.observe(item));
  }

  initRecruitmentPage();
  document.addEventListener('astro:page-load', initRecruitmentPage);
</script>
