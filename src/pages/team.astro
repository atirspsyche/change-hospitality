---
import CircularGallery from "../components/team/CircularGallery";
import ProfileCard from "../components/team/ProfileCard";
import EggIllustration from "../components/EggIllustration.astro";
import FunMenu from "../components/FunMenu.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { teamGalleryItems, teamMembers, teamPassSteps } from "../data/team";
import BaseLayout from "../layouts/BaseLayout.astro";

const showTeamPass = false;

const teamSectionLinks = [
  { label: "Profiles", href: "#profiles", meta: "Meet the consultants" },
  { label: "Gallery", href: "#gallery", meta: "Frames of the work" },
];
---

<BaseLayout
  title="Team Profiles | Change Hospitality"
  description="Meet the Change Hospitality team: people-first consultants for front of house, back of house, events and commercial hospitality recruitment."
  image="https://images.unsplash.com/photo-1559329007-40df8a9345d8?auto=format&fit=crop&w=1600&q=85"
>
  <FunMenu
    sectionLinks={teamSectionLinks}
    menuButtonBackground="var(--color-cocoa)"
    menuButtonBorderColor="var(--color-ink)"
    menuButtonTextColor="var(--color-cream)"
  />

  <main
    class="team-page min-h-screen overflow-hidden bg-paper text-ink"
    data-team-page
  >
    <section
      class="team-hero relative isolate h-svh overflow-hidden bg-cream px-5 pb-8 pt-20 md:px-10 md:pt-24"
      aria-labelledby="team-title"
    >
      <div
        class="team-cloud team-cloud-1"
        data-parallax="18"
        aria-hidden="true"
      >
      </div>
      <div
        class="team-cloud team-cloud-2"
        data-parallax="-26"
        aria-hidden="true"
      >
      </div>
      <div
        class="team-hero-oval team-hero-oval-1"
        data-parallax="56"
        aria-hidden="true"
      >
      </div>
      <div
        class="team-hero-oval team-hero-oval-2"
        data-parallax="-42"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 mx-auto grid h-full max-w-7xl gap-6 lg:-translate-y-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center"
      >
        <div class="relative z-20 max-w-4xl">
          <p
            class="mb-6 w-fit -rotate-2 rounded-[1.35rem] bg-citron px-6 py-3 text-sm font-black uppercase tracking-wide text-ink"
          >
            Team profiles
          </p>
          <h1
            id="team-title"
            class="font-serif text-6xl font-semibold leading-[0.92] text-ink md:text-8xl"
          >
            Meet the team.
          </h1>
          <p
            class="mt-7 max-w-xl text-xl font-black leading-8 text-cocoa md:text-2xl md:leading-9"
          >
            A placement is not a click. It is cracked, checked, cooked, flipped
            and served by people who know hospitality from the inside.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a class="team-hero-button bg-flame text-cream" href="#profiles"
              >Meet the consultants</a
            >
            <a class="team-hero-button bg-mint text-ink" href="#gallery"
              >See the storyboard</a
            >
          </div>
        </div>

        <div
          class="team-pass-stage relative min-h-144 lg:h-full lg:min-h-0"
          role="img"
          aria-label="A fried egg representing people-first recruitment"
        >
          <div class="team-hero-composition" data-parallax="10">
            <EggIllustration class="team-hero-egg" />
            <p class="team-hero-tag" aria-hidden="true">
              People make the placement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="profiles"
      class="team-profiles-section relative overflow-hidden bg-paper px-5 py-18 md:px-10 md:py-24"
      aria-labelledby="profiles-title"
    >
      <div
        class="team-section-oval team-section-oval-one"
        data-parallax="-32"
        aria-hidden="true"
      >
      </div>
      <div
        class="team-section-oval team-section-oval-two"
        data-parallax="24"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div
          class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end"
        >
          <div>
            <p
              class="mb-4 text-sm font-black uppercase tracking-wide text-flame"
            >
              Consultants
            </p>
            <h2
              id="profiles-title"
              class="font-serif text-5xl font-semibold leading-none text-ink md:text-7xl"
            >
              Cards with a pulse.
            </h2>
            <p class="max-w-xl mt-5 text-lg font-bold leading-8 text-cocoa">
              Four consultants, one close-knit team. Hover a card and each flat
              storyboard panel comes to life.
            </p>
          </div>
        </div>

        <div class="team-card-grid grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            teamMembers.map((member) => (
              <ProfileCard
                client:visible
                name={member.name}
                title={member.title}
                handle={member.handle}
                status={member.status}
                contactText={member.contactText}
                avatarUrl={member.avatarUrl}
                miniAvatarUrl={member.miniAvatarUrl}
                note={member.note}
                signal={member.signal}
                division={member.division}
                enableTilt={true}
              />
            ))
          }
        </div>
      </div>
    </section>

    {
      /* Temporarily disabled; set showTeamPass to true to restore this section. */
    }
    {
      showTeamPass && (
        <section
          id="pass"
          class="team-pass-section relative overflow-hidden bg-flame px-5 py-18 md:px-10 md:py-24"
          aria-labelledby="pass-title"
        >
          <div
            class="team-section-oval team-section-oval-three"
            data-parallax="38"
            aria-hidden="true"
          />
          <div class="relative z-10 mx-auto grid max-w-7xl gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-stretch">
            <div
              class="team-process-poster rounded-[30px] bg-blush p-6 text-ink md:p-8"
              data-parallax="26"
            >
              <p class="mb-5 text-sm font-black uppercase tracking-wide">
                How the handoff works
              </p>
              <h2
                id="pass-title"
                class="font-serif text-5xl font-semibold leading-none md:text-6xl"
              >
                Not a database. A pass.
              </h2>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
              {teamPassSteps.map((step) => (
                <article class="team-step-card rounded-[30px] bg-cream p-5 text-ink">
                  <p class="text-sm font-black uppercase text-flame">
                    {step.label}
                  </p>
                  <p class="mt-6 text-xl font-semibold leading-7">
                    {step.copy}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section
      id="gallery"
      class="relative overflow-hidden bg-cocoa py-18 md:py-24"
      aria-labelledby="gallery-title"
    >
      <div class="team-gallery-oval" data-parallax="34" aria-hidden="true">
      </div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 md:px-10">
        <div class="mb-8 grid gap-6 lg:grid-cols-[0.85fr_1fr] lg:items-end">
          <div>
            <p
              class="mb-4 text-sm font-black uppercase tracking-wide text-citron"
            >
              Image gallery
            </p>
            <h2
              id="gallery-title"
              class="font-serif text-5xl font-semibold leading-none text-cream md:text-7xl"
            >
              A few frames of the work.
            </h2>
          </div>
          <p class="max-w-2xl text-lg font-bold leading-8 text-cream">
            Real photo frames for the people side of the work: briefing tables,
            service floors, kitchens and the human moments around every careful
            handoff.
          </p>
        </div>
      </div>

      <div class="relative z-10 h-136 md:h-168" aria-label="Storyboard gallery">
        <CircularGallery
          client:visible
          items={teamGalleryItems}
          bend={2.2}
          scrollEase={0.04}
          scrollSpeed={1.8}
          textColor="var(--color-cream)"
        />
      </div>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>

<style>
  /* ---------- Decorative flat shapes (parallax) ---------- */
  .team-cloud,
  .team-hero-oval,
  .team-section-oval,
  .team-gallery-oval {
    position: absolute;
    pointer-events: none;
    will-change: transform;
    transition: transform 220ms ease-out;
  }

  .team-cloud {
    border-radius: 999px;
    background: var(--color-cream);
  }

  .team-cloud-1 {
    top: 12%;
    left: 4%;
    height: 5rem;
    width: 12rem;
  }

  .team-cloud-2 {
    top: 26%;
    right: 6%;
    height: 4rem;
    width: 9rem;
  }

  .team-hero-oval,
  .team-section-oval,
  .team-gallery-oval {
    border-radius: 999px;
  }

  .team-hero-oval-1 {
    top: 9%;
    right: -15rem;
    height: 24rem;
    width: 38rem;
    background: var(--color-mint);
    transform: rotate(-10deg);
  }

  .team-hero-oval-2 {
    bottom: -9rem;
    left: -16rem;
    height: 26rem;
    width: 42rem;
    background: var(--color-blush);
    transform: rotate(12deg);
  }

  .team-profiles-section {
    background: var(--color-paper);
  }

  .team-pass-section {
    background: var(--color-flame);
  }

  .team-section-oval-one {
    top: -7rem;
    right: -16rem;
    height: 22rem;
    width: 38rem;
    background: var(--color-flame);
    transform: rotate(9deg);
  }

  .team-section-oval-two {
    left: -12rem;
    bottom: 10%;
    height: 18rem;
    width: 30rem;
    background: var(--color-cream);
    transform: rotate(-12deg);
  }

  .team-section-oval-three {
    right: -15rem;
    top: 12%;
    height: 20rem;
    width: 36rem;
    background: var(--color-citron);
    transform: rotate(-8deg);
  }

  .team-gallery-oval {
    top: 12%;
    right: -16rem;
    height: 23rem;
    width: 39rem;
    background: var(--color-flame);
    transform: rotate(-10deg);
  }

  /* ---------- Hero buttons ---------- */
  .team-hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 1.25rem 2.25rem;
    text-align: center;
    font-size: 1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-cream);
    transition:
      transform 350ms var(--ease-cartoon),
      background-color 300ms ease;
  }

  .team-hero-button:hover,
  .team-hero-button:focus-visible {
    transform: translateY(-3px) rotate(-1deg);
  }

  /* ---------- Pass stage illustration ---------- */
  .team-pass-stage {
    display: grid;
    place-items: center;
  }

  .team-hero-composition {
    position: relative;
    display: grid;
    width: min(38rem, 100%);
    aspect-ratio: 1.28;
    place-items: center;
    transition: transform 220ms ease-out;
    will-change: transform;
  }

  :global(.team-hero-egg) {
    --egg-width: min(30rem, 74vw);
    z-index: 2;
  }

  .team-hero-tag {
    position: absolute;
    z-index: 3;
    right: 10%;
    bottom: 10%;
    width: 10.5rem;
    border-radius: 0.45rem;
    background: var(--color-blush);
    color: var(--color-ink);
    padding: 0.75rem 0.85rem;
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1.35;
    text-transform: uppercase;
    transform: rotate(5deg);
  }

  .team-pass-ticket,
  .team-orbit-card {
    position: absolute;
    z-index: 4;
    color: var(--color-ink);
    transform: translate3d(0, 0, 0) rotate(var(--float-rotate, 0deg));
    will-change: transform;
  }

  .team-pass-ticket {
    width: 12rem;
    border-radius: 1.25rem;
    background: var(--color-cream);
    padding: 1rem 1.1rem;
    animation: team-float 6.5s cubic-bezier(0.42, 0, 0.18, 1) infinite;
  }

  .team-pass-ticket span,
  .team-orbit-card span {
    display: block;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .team-pass-ticket strong {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 0.9;
  }

  .team-pass-ticket-one {
    --float-rotate: -8deg;
    left: 0;
    top: 8%;
    background: var(--color-citron);
  }

  .team-pass-ticket-two {
    --float-rotate: 7deg;
    right: -2%;
    top: 3%;
    background: var(--color-mint);
    animation-delay: 700ms;
  }

  .team-pass-ticket-three {
    --float-rotate: -3deg;
    bottom: 6%;
    right: 8%;
    background: var(--color-blush);
    animation-delay: 1200ms;
  }

  .team-orbit-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 11rem;
    border-radius: 999px;
    background: var(--color-cream);
    padding: 0.5rem 0.75rem;
    animation: team-float 7s cubic-bezier(0.42, 0, 0.18, 1) infinite;
  }

  .team-orbit-card img {
    height: 2.8rem;
    width: 2.8rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .team-orbit-1 {
    --float-rotate: 4deg;
    left: 6%;
    bottom: 20%;
    background: var(--color-mist);
  }

  .team-orbit-2 {
    --float-rotate: -5deg;
    right: 2%;
    top: 32%;
    background: var(--color-citron);
    animation-delay: 500ms;
  }

  .team-orbit-3 {
    --float-rotate: -2deg;
    left: 0;
    top: 44%;
    background: var(--color-blush);
    animation-delay: 900ms;
  }

  .team-orbit-4 {
    --float-rotate: 5deg;
    right: 16%;
    bottom: 2%;
    background: var(--color-mint);
    animation-delay: 1400ms;
  }

  /* ---------- Equal-height profile card grid ---------- */
  .team-card-grid {
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .team-card-grid {
      grid-auto-rows: 1fr;
    }
  }

  :global(.team-card-wrap) {
    perspective: none;
    animation: team-card-arrive 700ms var(--ease-cartoon) both;
  }

  :global(.team-card-wrap:nth-child(2)) {
    animation-delay: 80ms;
  }

  :global(.team-card-wrap:nth-child(3)) {
    animation-delay: 160ms;
  }

  :global(.team-card-wrap:nth-child(4)) {
    animation-delay: 240ms;
  }

  :global(.team-profile-card) {
    transform: translate3d(
        calc((var(--pointer-from-left, 0.5) - 0.5) * 14px),
        calc((var(--pointer-from-top, 0.5) - 0.5) * 10px),
        0
      )
      rotate(var(--card-tilt, 0deg));
    transition:
      transform 320ms var(--ease-cartoon),
      border-radius 320ms var(--ease-cartoon);
  }

  :global(.team-card-wrap:hover .team-profile-card),
  :global(.team-card-wrap:focus-within .team-profile-card) {
    border-radius: 1.8rem 1.2rem 1.8rem 1.35rem;
    transform: translate3d(
        calc((var(--pointer-from-left, 0.5) - 0.5) * 14px),
        calc((var(--pointer-from-top, 0.5) - 0.5) * 10px - 0.45rem),
        0
      )
      rotate(var(--card-tilt, 0deg)) scale(1.015);
  }

  :global(.team-card-name) {
    font-size: clamp(1.8rem, 2.5vw, 2.5rem);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  :global(.team-card-mark),
  :global(.team-card-photo-frame),
  :global(.team-card-info) {
    transform: translate3d(0, 0, 0);
    transition: transform 320ms var(--ease-cartoon);
  }

  :global(.team-card-wrap:hover .team-card-mark),
  :global(.team-card-wrap:focus-within .team-card-mark) {
    transform: translate3d(-0.35rem, 0.2rem, 0) rotate(-8deg);
  }

  :global(.team-card-wrap:hover .team-card-photo-frame),
  :global(.team-card-wrap:focus-within .team-card-photo-frame) {
    transform: rotate(1.5deg) scale(0.985);
  }

  :global(.team-card-wrap:hover .team-card-info),
  :global(.team-card-wrap:focus-within .team-card-info) {
    transform: translateY(-0.3rem) rotate(-0.7deg);
  }

  :global(.team-card-wrap:hover .team-card-blob),
  :global(.team-card-wrap:focus-within .team-card-blob) {
    opacity: 1;
  }

  :global(.team-card-avatar) {
    transform: scale(1.04)
      translate(
        calc((var(--pointer-from-left, 0.5) - 0.5) * 14px),
        calc((var(--pointer-from-top, 0.5) - 0.5) * 10px)
      );
    transition: transform 300ms ease;
  }

  :global(.team-card-wrap:hover .team-card-avatar),
  :global(.team-card-wrap:focus-within .team-card-avatar) {
    transform: scale(1.12)
      translate(
        calc((var(--pointer-from-left, 0.5) - 0.5) * 14px),
        calc((var(--pointer-from-top, 0.5) - 0.5) * 10px)
      );
  }

  /* ---------- Process step cards ---------- */
  .team-step-card {
    transition:
      transform 260ms var(--ease-cartoon),
      background-color 260ms ease;
  }

  .team-step-card:hover {
    transform: translateY(-4px) rotate(-1deg);
    background: var(--color-citron);
  }

  .team-process-poster {
    clip-path: polygon(0 6%, 96% 0, 100% 88%, 8% 100%);
  }

  .team-step-card:nth-child(2) {
    background: var(--color-mint);
    transform: rotate(1deg);
    transition:
      transform 260ms var(--ease-cartoon),
      background-color 260ms ease;
  }

  .team-step-card:nth-child(3) {
    background: var(--color-citron);
    transform: rotate(-1deg);
    transition:
      transform 260ms var(--ease-cartoon),
      background-color 260ms ease;
  }

  @keyframes team-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(var(--float-rotate, 0deg));
    }

    50% {
      transform: translate3d(0, -0.65rem, 0)
        rotate(calc(var(--float-rotate, 0deg) + 1deg));
    }
  }

  @keyframes team-card-arrive {
    from {
      opacity: 0;
      transform: translateY(2rem) rotate(2deg);
    }

    to {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }

  @media (max-width: 1023px) {
    .team-pass-stage {
      position: absolute;
      right: -7rem;
      bottom: -9rem;
      height: 32rem;
      width: 32rem;
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .team-pass-stage {
      right: -4rem;
      bottom: -1rem;
      height: 18rem;
      width: 18rem;
    }

    .team-hero-composition {
      width: 18rem;
    }

    :global(.team-hero-egg) {
      --egg-width: 16rem;
    }

    .team-hero-tag {
      right: 0;
      bottom: 1%;
      width: 8rem;
      padding: 0.55rem 0.7rem;
      font-size: 0.55rem;
    }

    :global(.team-profile-card) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-pass-ticket,
    .team-orbit-card,
    .team-hero-composition,
    .team-cloud,
    .team-hero-oval,
    .team-section-oval,
    .team-gallery-oval,
    :global(.team-card-wrap) {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  function initTeamParallax() {
    const page = document.querySelector<HTMLElement>("[data-team-page]");
    if (!page || page.dataset.parallaxReady === "true") return;
    page.dataset.parallaxReady = "true";

    const items = Array.from(
      page.querySelectorAll<HTMLElement>("[data-parallax]"),
    );
    if (!items.length) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const state = { pointerX: 0, pointerY: 0, scrollY: window.scrollY };
    items.forEach((el) => {
      if (!el.dataset.baseTransform) {
        el.dataset.baseTransform =
          window.getComputedStyle(el).transform === "none"
            ? ""
            : window.getComputedStyle(el).transform;
      }
    });

    const render = () => {
      items.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const depth = Number(el.getAttribute("data-parallax") || 0);
        const sectionOffset =
          ((rect.top + rect.height / 2 - window.innerHeight / 2) /
            window.innerHeight) *
          depth *
          -0.42;
        const pointerX = state.pointerX * depth;
        const pointerY = state.pointerY * depth;
        const base = el.dataset.baseTransform || "";
        el.style.transform = `${base} translate3d(${pointerX.toFixed(1)}px, ${(pointerY + sectionOffset).toFixed(1)}px, 0)`;
      });
    };

    const requestRender = () => {
      render();
    };

    const onMove = (event: PointerEvent) => {
      state.pointerX = (event.clientX / window.innerWidth - 0.5) * 2;
      state.pointerY = (event.clientY / window.innerHeight - 0.5) * 2;
      requestRender();
    };

    const onScroll = () => {
      state.scrollY = window.scrollY;
      requestRender();
    };

    window.addEventListener("pointermove", onMove, { passive: true });
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", requestRender, { passive: true });
    requestRender();
  }

  initTeamParallax();
  document.addEventListener("astro:page-load", initTeamParallax);
</script>
