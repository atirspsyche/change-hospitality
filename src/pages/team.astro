---
import { PrimaryButton } from "../components/Button";
import ProfileCard from "../components/team/ProfileCard";
import HeroIllustration from "../components/HeroIllustration.astro";
import FunMenu from "../components/FunMenu.astro";
import PageMotion from "../components/PageMotion.astro";
import SectionCurve from "../components/SectionCurve.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getTeamGroups, teamPassSteps } from "../data/team";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getActiveLocations, getTeamMembers } from "../sanity/queries";

const showTeamPass = false;
const [teamMembers, locations] = await Promise.all([getTeamMembers(), getActiveLocations()]);
const teamGroups = getTeamGroups(locations, teamMembers);
const officeNames = new Intl.ListFormat("en-GB", { style: "long", type: "conjunction" }).format(
  teamGroups.map((group) => `${group.label}${group.isHeadOffice ? " (head office)" : ""}`),
);

const teamSectionLinks = [
  { label: "Profiles", href: "#profiles", meta: "Meet the team" },
];
---

<BaseLayout
  title="Team Profiles | Change Hospitality"
  description={`Meet the Change Hospitality team across ${officeNames || "our offices"}: people-first hospitality recruitment specialists.`}
  image="https://images.unsplash.com/photo-1559329007-40df8a9345d8?auto=format&fit=crop&w=1600&q=85"
>
  <FunMenu
    sectionLinks={teamSectionLinks}
    menuButtonBackground="var(--color-cocoa)"
    menuButtonBorderColor="var(--color-ink)"
    menuButtonTextColor="var(--color-cream)"
  />

  <PageMotion page="team" />
  <main
    class="team-page min-h-screen overflow-hidden bg-paper text-ink"
    data-team-page
  >
    <section
      class="team-hero relative isolate overflow-hidden bg-blush px-5 pb-8 pt-20 md:px-10 md:pt-24"
      aria-labelledby="team-title"
    >
      <!-- <div
        class="team-cloud team-cloud-1"
        data-parallax="18"
        aria-hidden="true"
      >
      </div> -->
      <!-- <div
        class="team-cloud team-cloud-2"
        data-parallax="-26"
        aria-hidden="true"
      >
      </div> -->
      <div
        class="team-hero-oval team-hero-oval-1"
        data-hero-shape="1"
        aria-hidden="true"
      >
      </div>
      <!-- <div class="team-hero-confetti" aria-hidden="true">
        <span data-parallax="12"></span>
        <span data-parallax="-18"></span>
        <span data-parallax="24"></span>
        <span data-parallax="-14"></span>
      </div> -->

      <div
        class="relative z-10 mx-auto grid w-full max-w-7xl gap-6 lg:grid-cols-[1.02fr_0.98fr] lg:items-center"
      >
        <div class="team-hero-copy relative z-20 max-w-4xl">
          <p class="team-hero-kicker mb-6">
            <span>Team profiles</span>
          </p>
          <h1
            id="team-title"
            class="team-hero-title font-hero text-6xl font-semibold leading-[0.88] text-ink md:text-8xl"
          >
            Meet our<br />
            <span>good eggs.</span>
          </h1>
          <p
            class="team-hero-intro mt-7 max-w-xl text-xl font-black leading-8 text-cocoa md:text-2xl md:leading-9"
          >
            Hospitality people, through and through. We've worked the floors,
            the kitchens and the front desks ourselves, which is why we know
            exactly what you're looking for.
          </p>
          <ul
            class="team-hero-specialisms mt-7"
            aria-label="Our specialist teams"
          >
            <li>FOH</li>
            <li>BOH</li>
            <li>Events &amp; Commercial</li>
          </ul>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <PrimaryButton
              href="#profiles"
              shadow={false}
              backgroundColor="var(--color-cocoa)"
              textColor="var(--color-cream)"
            >
              Meet the team
            </PrimaryButton>
          </div>
        </div>

        <div
          class="team-pass-stage relative"
        >
          <div class="team-hero-composition">
            <HeroIllustration kind="salt" />
            <p class="team-hero-stamp">
              <strong>20+</strong>
              <span>years of people first</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <SectionCurve backdropColor="var(--color-blush)">
    <section
      id="profiles"
      class="team-profiles-section relative overflow-hidden bg-paper px-5 py-18 md:px-10 md:py-24"
      aria-labelledby="profiles-title"
    >
      <div
        class="team-section-oval team-section-oval-one"
        data-parallax="-32"
        aria-hidden="true"
      >
      </div>
      <div
        class="team-section-oval team-section-oval-two"
        data-parallax="24"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div
          class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end"
        >
          <div>
            <p
              class="mb-4 text-sm font-black uppercase tracking-wide text-flame"
            >
              Our people
            </p>
            <h2
              id="profiles-title"
              class="font-serif text-5xl font-semibold leading-none text-ink md:text-7xl"
            >
              Meet our team.
            </h2>
            <p class="max-w-xl mt-5 text-lg font-bold leading-8 text-cocoa">
              A close-knit team of hospitality specialists across {officeNames || "our offices"}.
            </p>
          </div>
        </div>

        <div class="team-accordion" data-team-accordion>
          {
            teamGroups.map((category, categoryIndex) => {
              const isOpen = categoryIndex === 0;
              const buttonId = `team-category-${category.id}`;
              const panelId = `team-panel-${category.id}`;

              return (
                <article
                  class:list={[
                    "team-accordion-item",
                    `team-accordion-${category.accent}`,
                  ]}
                  data-accordion-item
                  data-open={isOpen ? "true" : "false"}
                >
                  <div
                    class="team-accordion-shape"
                    data-parallax={categoryIndex % 2 === 0 ? "16" : "-16"}
                    aria-hidden="true"
                  />
                  <h3>
                    <button
                      id={buttonId}
                      class="team-accordion-trigger"
                      type="button"
                      aria-expanded={isOpen ? "true" : "false"}
                      aria-controls={panelId}
                      data-accordion-trigger
                    >
                      <span class="team-accordion-heading">
                        <span class="team-accordion-index">
                          {String(categoryIndex + 1).padStart(2, "0")}
                        </span>
                        <span>
                          <span class="team-accordion-title">
                            {category.label}
                          </span>
                          <span class="team-accordion-description">
                            {category.description}
                          </span>
                        </span>
                      </span>
                      <span class="team-accordion-meta" aria-hidden="true">
                        <span class="team-accordion-count">
                          {String(category.members.length).padStart(2, "0")}
                        </span>
                        <span class="team-accordion-toggle">
                          <span />
                          <span />
                        </span>
                      </span>
                    </button>
                  </h3>
                  <div
                    id={panelId}
                    class="team-accordion-panel"
                    role="region"
                    aria-labelledby={buttonId}
                    aria-hidden={isOpen ? "false" : "true"}
                    data-accordion-panel
                  >
                    <div class="team-accordion-panel-inner">
                      {category.members.length > 0 ? (
                        <div class="team-card-grid grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 px-3">
                          {category.members.map((member) => (
                            <ProfileCard
                              client:visible
                              name={member.name}
                              title={member.title}
                              avatarUrl={member.avatarUrl}
                              avatarSrcSet={member.avatarSrcSet}
                              avatarAlt={member.avatarAlt}
                              accent={member.accent}
                              note={member.note}
                              signal={member.signal}
                              email={member.email}
                              phone={member.phone}
                              enableTilt={true}
                            />
                          ))}
                        </div>
                      ) : (
                        <p class="team-accordion-empty">
                          New profiles are joining this office soon.
                        </p>
                      )}
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
    </SectionCurve>

    {
      /* Temporarily disabled; set showTeamPass to true to restore this section. */
    }
    {
      showTeamPass && (
        <SectionCurve backdropColor="var(--color-cream)">
        <section
          id="pass"
          class="team-pass-section relative overflow-hidden bg-flame px-5 py-18 md:px-10 md:py-24"
          aria-labelledby="pass-title"
        >
          <div
            class="team-section-oval team-section-oval-three"
            data-parallax="38"
            aria-hidden="true"
          />
          <div class="relative z-10 mx-auto grid max-w-7xl gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-stretch">
            <div
              class="team-process-poster rounded-[30px] bg-blush p-6 text-ink md:p-8"
              data-parallax="26"
            >
              <p class="mb-5 text-sm font-black uppercase tracking-wide">
                How the handoff works
              </p>
              <h2
                id="pass-title"
                class="font-serif text-5xl font-semibold leading-none md:text-6xl"
              >
                Not a database. A pass.
              </h2>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
              {teamPassSteps.map((step) => (
                <article class="team-step-card rounded-[30px] bg-cream p-5 text-ink">
                  <p class="text-sm font-black uppercase text-flame">
                    {step.label}
                  </p>
                  <p class="mt-6 text-xl font-semibold leading-7">
                    {step.copy}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </section>
        </SectionCurve>
      )
    }

    <SiteFooter backdropColor={showTeamPass ? "var(--color-flame)" : "var(--color-cream)"} />
  </main>
</BaseLayout>

<style>
  .team-page {
    --team-flame-surface: color-mix(in srgb, var(--color-flame) 88%, var(--color-ink));
  }

  /* ---------- Decorative flat shapes (parallax) ---------- */
  .team-cloud,
  .team-hero-oval,
  .team-hero-confetti span,
  .team-section-oval {
    position: absolute;
    pointer-events: none;
    will-change: transform;
    transition: transform 220ms ease-out;
  }

  .team-cloud {
    border-radius: 999px;
    background: var(--color-cream);
  }

  .team-cloud-1 {
    top: 8%;
    left: -5rem;
    height: 7rem;
    width: 19rem;
    transform: rotate(-8deg);
  }

  .team-cloud-2 {
    top: 12%;
    right: 30%;
    height: 3.5rem;
    width: 8rem;
    background: var(--color-citron);
    transform: rotate(18deg);
  }

  .team-hero-oval,
  .team-section-oval {
    border-radius: 999px;
  }

  .team-hero-oval-1 {
    top: 3%;
    right: -13rem;
    height: 24rem;
    width: 35rem;
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 18%, transparent);
    border-radius: 43% 57% 62% 38% / 52% 40% 60% 48%;
    background: radial-gradient(color-mix(in srgb, var(--color-cocoa) 16%, transparent) 1px, transparent 1px) 0 0 / 12px 12px,
      var(--color-mist);
    transform: rotate(-10deg);
  }

  .team-hero {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-bottom: 3rem;
    background: var(--color-blush);
  }

  /* .team-hero::after {
    position: absolute;
    right: 3%;
    bottom: 5%;
    z-index: 0;
    height: 8rem;
    width: 8rem;
    /* border-radius: 50% 50% 46% 54% / 58% 42% 58% 42%; */
  /* background: var(--color-citron); 
    content: "";
    transform: rotate(18deg);
  } */

  .team-hero-confetti span {
    z-index: 1;
    height: 1.1rem;
    width: 4.8rem;
    border-radius: 999px;
    background: var(--color-cocoa);
  }

  .team-hero-confetti span:nth-child(1) {
    top: 19%;
    left: 39%;
    transform: rotate(55deg);
  }

  .team-hero-confetti span:nth-child(2) {
    top: 45%;
    left: 3%;
    width: 3.6rem;
    background: var(--color-mint);
    transform: rotate(-38deg);
  }

  .team-hero-confetti span:nth-child(3) {
    right: 4%;
    bottom: 36%;
    width: 3.2rem;
    background: var(--color-cream);
    transform: rotate(68deg);
  }

  .team-hero-confetti span:nth-child(4) {
    left: 43%;
    bottom: 12%;
    background: var(--color-citron);
    transform: rotate(-18deg);
  }

  .team-hero-copy {
    animation: team-hero-copy-in 800ms var(--ease-luxury) both;
  }

  .team-hero-kicker {
    display: grid;
    height: 5.6rem;
    width: 7.2rem;
    place-items: center;
    border: 2px solid var(--color-ink);
    border-radius: 55% 45% 49% 51% / 62% 44% 56% 38%;
    background: var(--color-citron);
    transform: rotate(-7deg);
  }

  .team-hero-kicker span {
    max-width: 5rem;
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  .team-hero-title span {
    position: relative;
    display: inline-block;
    z-index: 1;
  }

  .team-hero-title span::before {
    position: absolute;
    inset: 12% -3% -2%;
    z-index: -1;
    /* border-radius: 48% 52% 45% 55% / 57% 42% 58% 43%; */
    background: var(--color-cream);
    content: "";
    transform: rotate(-2deg);
  }

  .team-hero-specialisms {
    display: flex;
    max-width: 38rem;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .team-hero-specialisms li {
    border: 2px solid var(--color-ink);
    /* border-radius: 52% 48% 44% 56% / 55% 42% 58% 45%; */
    background: var(--color-cream);
    padding: 0.65rem 1rem;
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-1deg);
  }

  .team-hero-specialisms li:nth-child(even) {
    background: var(--color-mint);
    transform: rotate(1.5deg);
  }

  .team-profiles-section {
    background: var(--color-cream);
  }

  .team-pass-section {
    background: var(--color-flame);
  }

  .team-section-oval-one {
    top: -7rem;
    right: -16rem;
    height: 22rem;
    width: 38rem;
    background: var(--color-flame);
    transform: rotate(9deg);
  }

  .team-section-oval-two {
    left: -12rem;
    bottom: 10%;
    height: 18rem;
    width: 30rem;
    background: var(--color-cream);
    transform: rotate(-12deg);
  }

  .team-section-oval-three {
    right: -15rem;
    top: 12%;
    height: 20rem;
    width: 36rem;
    background: var(--color-citron);
    transform: rotate(-8deg);
  }

  /* ---------- Pass stage illustration ---------- */
  .team-pass-stage {
    display: grid;
    place-items: center;
  }

  .team-hero-composition {
    position: relative;
    display: grid;
    width: min(36rem, 100%);
    aspect-ratio: 1;
    place-items: center;
    animation: team-hero-art-in 900ms 120ms var(--ease-cartoon) both;
  }

  .team-hero-tag {
    position: absolute;
    z-index: 3;
    right: 3%;
    bottom: 4%;
    display: grid;
    height: 8.4rem;
    width: 10.6rem;
    place-items: center;
    border: 2px solid var(--color-ink);
    border-radius: 54% 46% 48% 52% / 61% 42% 58% 39%;
    background: var(--color-cream);
    color: var(--color-ink);
    padding: 1rem;
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(7deg);
  }

  .team-hero-tag::after {
    position: absolute;
    inset: 35% auto auto 42%;
    z-index: -1;
    height: 2.9rem;
    width: 2.9rem;
    border-radius: 999px;
    background: var(--color-citron);
    content: "";
  }

  .team-hero-stamp {
    position: absolute;
    z-index: 4;
    top: 1%;
    left: 2%;
    display: grid;
    height: 8rem;
    width: 8rem;
    align-content: center;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-cocoa);
    color: var(--color-cream);
    padding: 0.8rem;
    text-align: center;
    transform: rotate(-9deg);
  }

  .team-hero-stamp strong,
  .team-hero-stamp span {
    display: block;
  }

  .team-hero-stamp strong {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    line-height: 0.9;
  }

  .team-hero-stamp span {
    margin-top: 0.35rem;
    font-size: 0.58rem;
    font-weight: 900;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .team-pass-ticket,
  .team-orbit-card {
    position: absolute;
    z-index: 4;
    color: var(--color-ink);
    transform: translate3d(0, 0, 0) rotate(var(--float-rotate, 0deg));
    will-change: transform;
  }

  .team-pass-ticket {
    width: 12rem;
    border-radius: 1.25rem;
    background: var(--color-cream);
    padding: 1rem 1.1rem;
    animation: team-float 6.5s cubic-bezier(0.42, 0, 0.18, 1) infinite;
  }

  .team-pass-ticket span,
  .team-orbit-card span {
    display: block;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .team-pass-ticket strong {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 0.9;
  }

  .team-pass-ticket-one {
    --float-rotate: -8deg;
    left: 0;
    top: 8%;
    background: var(--color-citron);
  }

  .team-pass-ticket-two {
    --float-rotate: 7deg;
    right: -2%;
    top: 3%;
    background: var(--color-mint);
    animation-delay: 700ms;
  }

  .team-pass-ticket-three {
    --float-rotate: -3deg;
    bottom: 6%;
    right: 8%;
    background: var(--color-blush);
    animation-delay: 1200ms;
  }

  .team-orbit-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 11rem;
    border-radius: 999px;
    background: var(--color-cream);
    padding: 0.5rem 0.75rem;
    animation: team-float 7s cubic-bezier(0.42, 0, 0.18, 1) infinite;
  }

  .team-orbit-card img {
    height: 2.8rem;
    width: 2.8rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .team-orbit-1 {
    --float-rotate: 4deg;
    left: 6%;
    bottom: 20%;
    background: var(--color-mist);
  }

  .team-orbit-2 {
    --float-rotate: -5deg;
    right: 2%;
    top: 32%;
    background: var(--color-citron);
    animation-delay: 500ms;
  }

  .team-orbit-3 {
    --float-rotate: -2deg;
    left: 0;
    top: 44%;
    background: var(--color-blush);
    animation-delay: 900ms;
  }

  .team-orbit-4 {
    --float-rotate: 5deg;
    right: 16%;
    bottom: 2%;
    background: var(--color-mint);
    animation-delay: 1400ms;
  }

  /* ---------- Team category accordion ---------- */
  .team-accordion {
    border-top: 3px solid var(--color-ink);
  }

  .team-accordion-item {
    --accordion-accent: var(--color-cream);
    --accordion-foreground: var(--color-ink);
    --accordion-muted: var(--color-cocoa);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 3px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--accordion-foreground);
    transition: background-color 500ms var(--ease-luxury);
  }

  .team-accordion-citron {
    --accordion-accent: var(--color-citron);
  }

  .team-accordion-mint {
    --accordion-accent: var(--color-mint);
  }

  .team-accordion-flame {
    --accordion-accent: var(--team-flame-surface);
  }

  .team-accordion-flame[data-open="true"] {
    --accordion-foreground: var(--color-off-white);
    --accordion-muted: var(--color-off-white);
  }

  .team-accordion-blush {
    --accordion-accent: var(--color-blush);
  }

  .team-accordion-item[data-open="true"] {
    background: var(--accordion-accent);
  }

  .team-accordion-shape {
    position: absolute;
    z-index: -1;
    top: -6.5rem;
    right: 8%;
    height: 10rem;
    width: 22rem;
    border-radius: 999px;
    background: var(--accordion-accent);
    pointer-events: none;
    transform: rotate(-7deg);
    transition:
      transform 220ms ease-out,
      top 500ms var(--ease-cartoon);
    will-change: transform;
  }

  .team-accordion-item[data-open="true"] .team-accordion-shape {
    top: -3rem;
    background: var(--color-cream);
  }

  .team-accordion-flame[data-open="true"] .team-accordion-shape {
    background: var(--color-cocoa);
  }

  .team-accordion-trigger {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 0;
    background: transparent;
    padding: 1.5rem 0.25rem;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .team-accordion-trigger:focus-visible {
    outline-color: var(--accordion-foreground);
    outline-offset: -0.4rem;
  }

  .team-accordion-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 1rem;
  }

  .team-accordion-heading > span:last-child {
    min-width: 0;
  }

  .team-accordion-index {
    display: grid;
    height: 2.7rem;
    width: 2.7rem;
    flex: none;
    place-items: center;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-ink);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .team-accordion-title,
  .team-accordion-description {
    display: block;
  }

  .team-accordion-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    /* font-weight: 600; */
    line-height: 0.95;
  }

  .team-accordion-description {
    margin-top: 0.55rem;
    max-width: 42rem;
    color: var(--accordion-muted);
    font-size: 0.85rem;
    font-weight: 500;
